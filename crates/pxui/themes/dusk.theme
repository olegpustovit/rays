# Dusk: a second pxui theme made from data alone, over Theme::default().
# Token keys re-derive every look from the tokens; the part keys below then restyle single looks.

tokens.panel = #1d2230
tokens.foreground = #e6e9f2
tokens.control = #2c3346
tokens.input = #262c3c
tokens.track = #151a24
tokens.accent = #3b82f6
tokens.radius.small = 5
tokens.radius.medium = 8
tokens.radius.large = 10
tokens.motion.fast = 0.08
tokens.motion.normal = 0.16

# a lifted panel
panel.shadow.color = #00000099
panel.shadow.y = 4
panel.shadow.blur = 16

# buttons: a gradient pill with a soft shadow; brighter on hover, flat and darker when pressed
button.fill = #3b82f6
button.gradient = #1d4ed8
button.text = #ffffff
button.shadow.color = #00000066
button.shadow.y = 2
button.shadow.blur = 6
button.hover.fill = #60a5fa
button.hover.gradient = #2563eb
button.pressed.fill = #1d4ed8
button.pressed.gradient = #1e40af
button.pressed.shadow.color = #00000000
button.ring.sides = all
button.ring.color = #93c5fd

# switches: a round track and knob
switch.radius = 7
switch.border_w = 0
switch.checked.fill = #3b82f6
knob.radius = 4
knob.checked.fill = #ffffff

# fields: a rounded well with an inner shadow and an accent line while edited
field.fill = #151a24
field.radius = 4
field.sides = bottom
field.shadow.color = #00000080
field.shadow.y = 1
field.shadow.blur = 3
field.shadow.inner = true

# rows: a rounded hover
toggle.hover.radius = 4
row.hover.radius = 4

# the desktop widgets: round boxes and dots, pill tabs and segments, rounded wells and sheets
checkbox.radius = 3
checkbox.fill = #151a24
checkbox.checked.fill = #1e3a8a
radio.fill = #151a24
radio.checked.fill = #1e3a8a
slider.radius = 4
slider.fill = #e6e9f2
slider.border_w = 0
slider.hover.fill = #ffffff
slider.pressed.fill = #93c5fd
progress.radius = 2
tab.checked.border_w = 3
segment.radius = 5
segment.checked.fill = #3b82f6
segment.checked.text = #ffffff
dropdown.fill = #151a24
dropdown.radius = 4
dropdown.hover.fill = #1d2433
menubar.fill = #151a24
scroll_view.radius = 6
scroll_view.fill = #191e2a
listbox.hover.radius = 4
listbox.checked.radius = 4
listbox.checked.fill = #1e3a8a
tree.hover.radius = 4
tree.checked.radius = 4
tree.checked.fill = #1e3a8a
column.hover.radius = 4
dialog.text = #ffffff
toast.radius = 8
toast.fill = #2c3346
toast.shadow.color = #00000099
toast.shadow.y = 4
toast.shadow.blur = 12
icon_button.radius = 10
search.fill = #151a24
search.radius = 10
search.sides = all
search.border = #2c3346
image.radius = 6
