; Coordinate planes become a packed float3 stream without crossing the host.
(defn pack-planes :context value
  [(id : int) (x : (array float)) (y : (array float)) (z : (array float))
   (out : (array float)) (bound : (array int)) (size : int)]
  (if (int/lt id (array/nth bound 0))
    (let* [at (int/mul id 3)]
      (int/add (gpu/store out at (array/nth x id))
        (int/add (gpu/store out (int/add at 1) (array/nth y id))
                 (gpu/store out (int/add at 2) (array/nth z id))))) 0))
