(workspace rename_attributes_node
(defn rename_attributes_owner :context value [(raw : text)]
  (let* [token (text/lower (text/trim raw))]
    (case token
      "point" "point" "points" "point"
      "vertex" "vertex" "vertices" "vertex"
      "primitive" "primitive" "primitives" "primitive" "detail" "detail"
      "any" "any" "*" "any"
      :else (error "E_PARAM" (str "unknown attribute owner " (text/repr token))))))

(defn rename_attributes_conflict :context value [(raw : text)]
  (let* [token (text/lower (text/trim raw))]
    (case token "skip" "skip" "error" "error" "overwrite" "overwrite"
      :else (error "E_PARAM" (str "unknown attribute rename conflict " (text/repr token))))))

(defn rename_attributes_normalize :context value [(raw : text)]
  (text/table_encode (map (fn [(row : (list text))]
    (if (= (count row) 4)
      (list (rename_attributes_owner (nth row 0)) (nth row 1) (nth row 2)
        (rename_attributes_conflict (nth row 3)))
      (error "E_PARAM" (str "Attribute Rename rule needs owner, pattern, replacement, and conflict; got " (count row) " columns"))))
    (text/table_decode raw))))

(defn rename_attributes_rewrite_validate :context value [(pattern : text) (replacement : text)]
  (let* [message (text/glob_rewrite_error pattern replacement)]
    (if (equal? message "") true (error "E_PARAM" (str "sop/rename_attributes: " message)))))

(defnode sop/rename_attributes :label "Rename Attributes"
  :category ["Attribute" "Manage"]
  :validate (reduce (fn [valid row]
    (rename_attributes_rewrite_validate (nth row 1) (nth row 2))) true (text/table_decode rules))
  [(in0 : geometry)
   (rules : text "" :label "Rules (owner, pattern, replacement, conflict)" :kind encoded
     :normalize rename_attributes_normalize)]
  (reduce (fn [geometry row]
    (sop/rename_attr geometry (nth row 1) (nth row 2) :owner (nth row 0) :conflict (nth row 3))) in0 (text/table_decode rules)))
)
