; Whole Subdivide draft. A pass (sd_pass, a macro so its group and attribute folds expand in the node
; body) builds, from the mesh topology, the stencil of every output point (CSR: offsets, sources, weights, in
; native's term order and summed with one fused multiply-add per term), the crease plan (edge sharpness,
; child sharpness, vertex classification and transition factors), the output topology and element maps, then
; carries attributes (point stencil, vertex face-varying modes, discrete copies through sop/remap) and
; groups. The iteration is a geometry fold; the first pass reads the crease override, the final pass drops
; holes and writes the resulting crease edge group. Detail overrides (osd_*) are read once.
; Routed through the native sop/subdivide_cracks kind (sd_delegate): a primitive group that selects part of
; the mesh (the crack-closing path), and meshes holding curves (the polygon-curve refinement and part
; combining stay native). Everything else is this file.
(defn sd_flag :context value [(b : bool)] (if b 1 0))
(defn sd_safe :context value [(index : int)] (if (int/ge index 0) index 0))
; Owner segment of every slot given segment start offsets (length segments + 1).
(defn sd_owners :context value [(offsets : (array int)) (total : int)]
  (let* [segments (int/sub (array/count offsets) 1)
         starts (exact (map (fn [(p : int)] (array/nth offsets p)) (array/range segments :type int)))
         prefix (array/scan_sum (array/scatter_add starts (array/int segments 1) (int/add total 1)))]
    (exact (map (fn [(s : int)] (int/sub (array/nth prefix (int/add s 1)) 1)) (array/range total :type int)))))
; Native sums a stencil sequentially with a fused multiply-add per term: pass k adds term k of every
; row that has one.
(defn sd_sum :context value
  [(offsets : (array int)) (sources : (array int)) (weights : (array float)) (plane : (array float))]
  (let* [n (int/sub (array/count offsets) 1)
         lens (exact (map (fn [(o : int)] (int/sub (array/nth offsets (int/add o 1)) (array/nth offsets o)))
                (array/range n :type int)))
         maxlen (array/max (array/concat lens (array/int 1 0)))
         state (iterate maxlen (exact (map (fn [(o : int)] [0.0 0.0]) (array/range n :type int)))
           (fn [(s : (array vec2))]
             (exact (map (fn [(o : int) (q : vec2)]
               (if (int/lt (int q.y) (array/nth lens o))
                 (let* [at (int/add (array/nth offsets o) (int q.y))]
                   [(fma (array/nth plane (array/nth sources at)) (array/nth weights at) q.x) (+ q.y 1.0)])
                 [q.x (+ q.y 1.0)]))
               (array/range n :type int) s))))]
    (exact (map (fn [(q : vec2)] q.x) state))))
(defn sd_xs :context value [(p : (array vec3))] (exact (map (fn [(q : vec3)] q.x) p)))
(defn sd_ys :context value [(p : (array vec3))] (exact (map (fn [(q : vec3)] q.y) p)))
(defn sd_zs :context value [(p : (array vec3))] (exact (map (fn [(q : vec3)] q.z) p)))
(defn sd_join3 :context value [(x : (array float)) (y : (array float)) (z : (array float))]
  (exact (map (fn [(a : float) (b : float) (c : float)] [a b c]) x y z)))

; Edge incidences in native order (ascending corner id): the first and second corner of every edge (-1: none).
(defn sd_ev :context value
  [(adj : {:edge_of_vertex (array int) :opposite_vertex (array int)}) (edges : int) (vertices : int)]
  (let* [vr (array/range vertices :type int)
         first_key (exact (map (fn [(v : int)]
           (let* [e (array/nth adj.edge_of_vertex v) o (array/nth adj.opposite_vertex v)]
             (if (and (int/ge e 0) (or (int/lt o 0) (int/lt v o))) e edges))) vr))
         second_key (exact (map (fn [(v : int)]
           (let* [e (array/nth adj.edge_of_vertex v) o (array/nth adj.opposite_vertex v)]
             (if (and (int/ge e 0) (and (int/ge o 0) (int/gt v o))) e edges))) vr))
         plus (exact (map (fn [(v : int)] (int/add v 1)) vr))
         first_sum (array/scatter_add first_key plus (int/add edges 1))
         second_sum (array/scatter_add second_key plus (int/add edges 1))
         er (array/range edges :type int)]
    {:first (exact (map (fn [(e : int)] (let* [x (int/sub (array/nth first_sum e) 1)] (if (int/ge x vertices) (int/sub vertices 1) x))) er))
     :second (exact (map (fn [(e : int)] (let* [x (int/sub (array/nth second_sum e) 1)] (if (int/ge x vertices) (int/sub vertices 1) x))) er))}))

; Boundary edges at every point (edges with one corner), and the first and second boundary neighbour.
(defn sd_boundary :context value
  [(peo : (array int)) (pe : (array int)) (ea : (array int)) (eb : (array int)) (ev1 : (array int)) (points : int)]
  (let* [slots (array/nth peo points)
         owner (sd_owners peo slots)
         flag (exact (map (fn [(s : int)] (if (int/lt (array/nth ev1 (array/nth pe s)) 0) 1 0)) (array/range slots :type int)))
         prefix (array/scan_sum flag)
         rank (exact (map (fn [(s : int) (o : int)] (int/sub (array/nth prefix s) (array/nth prefix (array/nth peo o))))
                (array/range slots :type int) owner))
         neighbor (exact (map (fn [(s : int) (o : int)]
           (let* [e (array/nth pe s)]
             (if (int/eq (array/nth ea e) o) (array/nth eb e) (array/nth ea e))))
           (array/range slots :type int) owner))
         key0 (exact (map (fn [(f : int) (r : int) (o : int)] (if (and (int/eq f 1) (int/eq r 0)) o points)) flag rank owner))
         key1 (exact (map (fn [(f : int) (r : int) (o : int)] (if (and (int/eq f 1) (int/eq r 1)) o points)) flag rank owner))
         plus (exact (map (fn [(n : int)] (int/add n 1)) neighbor))
         left (array/scatter_add key0 plus (int/add points 1))
         right (array/scatter_add key1 plus (int/add points 1))
         count (array/scatter_add (exact (map (fn [(f : int) (o : int)] (if (int/eq f 1) o points)) flag owner))
                 (array/int slots 1) (int/add points 1))
         pr (array/range points :type int)]
    {:count (exact (map (fn [(p : int)] (array/nth count p)) pr))
     :left (exact (map (fn [(p : int)] (int/sub (array/nth left p) 1)) pr))
     :right (exact (map (fn [(p : int)] (int/sub (array/nth right p) 1)) pr))}))

(defn sd_vsize :context value [(po : (array int)) (pov : (array int)) (v : int)]
  (let* [f (array/nth pov v)] (int/sub (array/nth po (int/add f 1)) (array/nth po f))))
(defn sd_fsize :context value [(po : (array int)) (f : int)]
  (int/sub (array/nth po (int/add f 1)) (array/nth po f)))
(defn sd_faces :context value [(pvo : (array int)) (p : int)]
  (int/sub (array/nth pvo (int/add p 1)) (array/nth pvo p)))
(defn sd_corner :context value [(pvo : (array int)) (bmode : int) (p : int)]
  (and (int/eq bmode 2) (int/eq (sd_faces pvo p) 1)))
(defn sd_valence :context value [(peo : (array int)) (p : int)]
  (int/sub (array/nth peo (int/add p 1)) (array/nth peo p)))
(defn sd_at0 :context value [(a : (array int)) (i : int)] (if (int/ge i 0) (array/nth a i) 0))

; The topology tables a pass reads: native Topology_index plus edge incidences, boundary neighbours and
; flattened lookup arrays that keep every stencil kernel small.
(defn sd_tables :context sop [(g : geometry)]
  (let* [adj (sop/adjacency g)
         topology (sop/topology g)
         points (sop/count g :points)
         edges (sop/count g :edges)
         vertices (sop/count g :vertices)
         prims (sop/count g :primitives)
         ev (sd_ev adj edges vertices)
         ev0 ev.first
         ev1 ev.second
         bd (sd_boundary adj.point_edge_offsets adj.point_edges adj.edge_a adj.edge_b ev1 points)
         po topology.primitive_offsets
         vp topology.vertex_points
         pov adj.primitive_of_vertex
         pvx adj.point_vertices
         pe adj.point_edges
         ea adj.edge_a
         eb adj.edge_b
         slots (array/count pvx)
         vsize (exact (map (fn [(s : int)] (sd_vsize po pov (array/nth pvx s))) (array/range slots :type int)))
         cum (array/scan_sum vsize)
         corners (array/nth cum slots)
         cslot (sd_owners cum corners)
         cornerpt (exact (map (fn [(gi : int) (s : int)]
           (let* [v (array/nth pvx s) f (array/nth pov v)]
             (array/nth vp (int/add (array/nth po f) (int/sub gi (array/nth cum s))))))
           (array/range corners :type int) cslot))
         cornersz (exact (map (fn [(s : int)] (array/nth vsize s)) cslot))
         eslots (array/count pe)
         ends (exact (map (fn [(j : int)]
           (let* [e (array/nth pe (int/div j 2))]
             (if (int/eq (int/mod j 2) 0) (array/nth ea e) (array/nth eb e))))
           (array/range (int/mul 2 eslots) :type int)))
         er (array/range edges :type int)
         e0f (exact (map (fn [(e : int)] (array/nth po (array/nth pov (array/nth ev0 e)))) er))
         e0s (exact (map (fn [(e : int)] (sd_vsize po pov (array/nth ev0 e))) er))
         e1f (exact (map (fn [(e : int)] (let* [v (array/nth ev1 e)] (if (int/ge v 0) (array/nth po (array/nth pov v)) 0))) er))
         e1s (exact (map (fn [(e : int)] (let* [v (array/nth ev1 e)] (if (int/ge v 0) (sd_vsize po pov v) 0))) er))
         ap0 (exact (map (fn [(e : int)] (array/nth vp (array/nth adj.next_vertex (array/nth adj.next_vertex (array/nth ev0 e))))) er))
         ap1 (exact (map (fn [(e : int)] (let* [v (array/nth ev1 e)]
           (if (int/ge v 0) (array/nth vp (array/nth adj.next_vertex (array/nth adj.next_vertex v))) 0))) er))]
    {:vp vp :po po :pov pov :nv adj.next_vertex :pv adj.previous_vertex :eov adj.edge_of_vertex :opp adj.opposite_vertex :ea ea :eb eb
     :peo adj.point_edge_offsets :pe pe :pvo adj.point_vertex_offsets :pvx pvx :ev0 ev0 :ev1 ev1
     :bc bd.count :bl bd.left :br bd.right :cum cum :ends ends :cornerpt cornerpt :cornersz cornersz
     :e0f e0f :e0s e0s :e1f e1f :e1s e1s :ap0 ap0 :ap1 ap1
     :points points :edges edges :vertices vertices :prims prims}))

; Loop point weight beta for valence n.
(defn sd_beta :context value [(n : int)]
  (let* [nf (float n)
         angle (/ (* 2.0 pi) nf)
         c (fma 0.25 (cos angle) 0.375)]
    (/ (- 0.625 (pow c 2.0)) nf)))
; ---- stencil kernels (each stays under the 64-register packed limit) ----
; Point class: type 0 regular, 1 boundary corner, 2 boundary edge, 3 isolated.
(defn sd_ptype :context value
  [(bc : (array int)) (pn : (array int)) (pf : (array int)) (bmode : int) (o : int)]
  (cond (int/eq (array/nth bc o) 2) (if (and (int/eq bmode 2) (int/eq (array/nth pf o) 1)) 1 2)
        (or (int/eq (array/nth pn o) 0) (int/eq (array/nth pf o) 0)) 3
        :else 0))
(defn sd_pcount :context value
  [(ptype : (array int)) (pn : (array int)) (pfan : (array int)) (scheme : int) (o : int)]
  (let* [ty (array/nth ptype o)]
    (cond (int/eq scheme 2) 1
          (int/eq ty 2) 3
          (int/gt ty 0) 1
          (int/eq scheme 1) (int/add 1 (array/nth pn o))
          :else (int/add 1 (int/add (int/mul 2 (array/nth pn o)) (array/nth pfan o))))))
(defn sd_ps :context value
  [(ptype : (array int)) (pn : (array int)) (pe : (array int)) (pc : (array int))
   (ends : (array int)) (cornerpt : (array int)) (bl : (array int)) (br : (array int))
   (scheme : int) (o : int) (k : int)]
  (let* [n (array/nth pn o)]
    (cond
      (int/eq k 0) o
      (int/eq (array/nth ptype o) 2) (if (int/eq k 1) (array/nth bl o) (array/nth br o))
      (int/eq scheme 1)
        (let* [at (int/add (array/nth pe o) (int/mul 2 (int/sub k 1))) a (array/nth ends at)]
          (if (int/eq a o) (array/nth ends (int/add at 1)) a))
      (int/le k (int/mul 2 n)) (array/nth ends (int/add (array/nth pe o) (int/sub k 1)))
      :else (array/nth cornerpt (int/add (array/nth pc o) (int/sub k (int/add 1 (int/mul 2 n))))))))
(defn sd_pw_cc :context value
  [(ptype : (array int)) (pn : (array int)) (pprod : (array float)) (pc : (array int))
   (cornersz : (array int)) (o : int) (k : int)]
  (let* [ty (array/nth ptype o) n (array/nth pn o) nf (float n)]
    (cond
      (int/eq ty 2) (if (int/eq k 0) 0.75 0.125)
      (int/gt ty 0) 1.0
      (int/eq k 0) (/ (- nf 3.0) nf)
      (int/le k (int/mul 2 n)) (/ 1.0 (* nf nf))
      :else (/ 1.0 (* (array/nth pprod o)
                      (float (array/nth cornersz (int/add (array/nth pc o) (int/sub k (int/add 1 (int/mul 2 n)))))))))))
(defn sd_pw_loop :context value [(ptype : (array int)) (pn : (array int)) (pbeta : (array float)) (o : int) (k : int)]
  (let* [ty (array/nth ptype o) nf (float (array/nth pn o))]
    (cond
      (int/eq ty 2) (if (int/eq k 0) 0.75 0.125)
      (int/gt ty 0) 1.0
      (int/eq k 0) (fma (- 0.0 nf) (array/nth pbeta o) 1.0)
      :else (array/nth pbeta o))))
; Edge class.
(defn sd_ecount :context value [(eint : (array int)) (e0s : (array int)) (e1s : (array int)) (scheme : int) (e : int)]
  (cond (int/eq scheme 2) 2
        (int/eq (array/nth eint e) 0) 2
        (int/eq scheme 1) 4
        :else (int/add 2 (int/add (array/nth e0s e) (array/nth e1s e)))))
; Face weight of an interior edge point (native face_weight).
(defn sd_efw :context value [(tri : int) (s0 : int) (s1 : int)]
  (if (int/eq tri 0) 0.25
    (* 0.5 (+ (if (int/eq s0 3) 0.470 0.25) (if (int/eq s1 3) 0.470 0.25)))))
(defn sd_es :context value
  [(ea : (array int)) (eb : (array int)) (vp : (array int)) (e0f : (array int)) (e1f : (array int))
   (e0s : (array int)) (ap0 : (array int)) (ap1 : (array int)) (scheme : int) (e : int) (k : int)]
  (let* [j (int/sub k 2) s0 (array/nth e0s e)]
    (cond (int/eq k 0) (array/nth ea e)
          (int/eq k 1) (array/nth eb e)
          (int/eq scheme 1) (if (int/eq k 2) (array/nth ap0 e) (array/nth ap1 e))
          (int/lt j s0) (array/nth vp (int/add (array/nth e0f e) j))
          :else (array/nth vp (int/add (array/nth e1f e) (int/sub j s0))))))
(defn sd_ew :context value
  [(eint : (array int)) (efw : (array float)) (e0s : (array int)) (e1s : (array int)) (scheme : int) (e : int) (k : int)]
  (let* [fw (array/nth efw e) j (int/sub k 2)]
    (cond (int/eq scheme 2) 0.5
          (int/eq (array/nth eint e) 0) 0.5
          (int/eq scheme 1) (if (int/lt k 2) 0.375 0.125)
          (int/lt k 2) (* 0.5 (- 1.0 (* 2.0 fw)))
          (int/lt j (array/nth e0s e)) (/ fw (float (array/nth e0s e)))
          :else (/ fw (float (array/nth e1s e))))))
; Face class.
(defn sd_fs :context value [(vp : (array int)) (po : (array int)) (f : int) (k : int)]
  (array/nth vp (int/add (array/nth po f) k)))
(defn sd_fw :context value [(po : (array int)) (f : int)] (/ 1.0 (float (sd_fsize po f))))

; Local term index of every slot of a class given its counts.
(defn sd_slots :context value [(counts : (array int))]
  (let* [offsets (array/scan_sum counts)
         total (array/nth offsets (array/count counts))
         owner (sd_owners offsets total)
         local (exact (map (fn [(s : int) (o : int)] (int/sub s (array/nth offsets o))) (array/range total :type int) owner))]
    {:owner owner :local local}))

; The stencil CSR of all output points: points, then edges, then (Catmull-Clark/Bilinear) faces.
(defn sd_stencil :context value
  [(tp : {:vp (array int) :po (array int) :ea (array int) :eb (array int) :peo (array int) :pvo (array int)
          :ev1 (array int) :bc (array int) :bl (array int) :br (array int) :cum (array int) :ends (array int)
          :cornerpt (array int) :cornersz (array int) :e0f (array int) :e0s (array int) :e1f (array int)
          :e1s (array int) :ap0 (array int) :ap1 (array int) :points int :edges int :prims int})
   (scheme : int) (bmode : int) (tri : int)]
  (let* [points tp.points edges tp.edges prims tp.prims
         pr (array/range points :type int)
         pn (exact (map (fn [(o : int)] (int/sub (array/nth tp.peo (int/add o 1)) (array/nth tp.peo o))) pr))
         pf (exact (map (fn [(o : int)] (int/sub (array/nth tp.pvo (int/add o 1)) (array/nth tp.pvo o))) pr))
         ptype (exact (map (fn [(o : int)] (sd_ptype tp.bc pn pf bmode o)) pr))
         pfan (exact (map (fn [(o : int)] (int/sub (array/nth tp.cum (array/nth tp.pvo (int/add o 1)))
                                                   (array/nth tp.cum (array/nth tp.pvo o)))) pr))
         pe (exact (map (fn [(o : int)] (int/mul 2 (array/nth tp.peo o))) pr))
         pc (exact (map (fn [(o : int)] (array/nth tp.cum (array/nth tp.pvo o))) pr))
         pprod (exact (map (fn [(n : int) (f : int)] (* (float n) (float f))) pn pf))
         er (array/range edges :type int)
         eint (exact (map (fn [(e : int)] (if (int/ge (array/nth tp.ev1 e) 0) 1 0)) er))
         efw (exact (map (fn [(s0 : int) (s1 : int)] (sd_efw tri s0 s1)) tp.e0s tp.e1s))
         pcount (exact (map (fn [(o : int)] (sd_pcount ptype pn pfan scheme o)) pr))
         ecount (exact (map (fn [(e : int)] (sd_ecount eint tp.e0s tp.e1s scheme e)) er))
         fcount (if (int/eq scheme 1) (array/int 0 0)
                  (exact (map (fn [(f : int)] (sd_fsize tp.po f)) (array/range prims :type int))))
         ps (sd_slots pcount) es (sd_slots ecount) fs (sd_slots fcount)
         psrc (exact (map (fn [(o : int) (k : int)]
                (sd_ps ptype pn pe pc tp.ends tp.cornerpt tp.bl tp.br scheme o k)) ps.owner ps.local))
         pbeta (if (int/eq scheme 1) (exact (map (fn [(n : int)] (sd_beta n)) pn)) (array/float points))
         pwgt (cond
           (int/eq scheme 2) (exact (map (fn [(o : int)] 1.0) ps.owner))
           (int/eq scheme 1) (exact (map (fn [(o : int) (k : int)] (sd_pw_loop ptype pn pbeta o k)) ps.owner ps.local))
           :else (exact (map (fn [(o : int) (k : int)] (sd_pw_cc ptype pn pprod pc tp.cornersz o k)) ps.owner ps.local)))
         esrc (exact (map (fn [(e : int) (k : int)]
                (sd_es tp.ea tp.eb tp.vp tp.e0f tp.e1f tp.e0s tp.ap0 tp.ap1 scheme e k)) es.owner es.local))
         ewgt (exact (map (fn [(e : int) (k : int)] (sd_ew eint efw tp.e0s tp.e1s scheme e k)) es.owner es.local))
         fsrc (exact (map (fn [(f : int) (k : int)] (sd_fs tp.vp tp.po f k)) fs.owner fs.local))
         fwgt (exact (map (fn [(f : int)] (sd_fw tp.po f)) fs.owner))
         counts (array/concat (array/concat pcount ecount) fcount)]
    {:offsets (array/scan_sum counts)
     :sources (array/concat (array/concat psrc esrc) fsrc)
     :weights (array/concat (array/concat pwgt ewgt) fwgt)
     :rep (array/concat (array/concat pr tp.ea)
            (exact (map (fn [(f : int)] (array/nth tp.vp (array/nth tp.po f))) (array/range (array/count fcount) :type int))))}))

; Output corners (point ids): Catmull-Clark/Bilinear make four quads per kept corner, Loop four triangles per kept
; triangle; unit lists the kept source corners (or triangles).
(defn sd_out_cc :context value
  [(vp : (array int)) (pov : (array int)) (eov : (array int)) (pv : (array int)) (unit : (array int))
   (points : int) (edges : int) (i : int)]
  (let* [v (array/nth unit (int/div i 4)) s (int/mod i 4)]
    (cond (int/eq s 0) (array/nth vp v)
          (int/eq s 1) (int/add points (array/nth eov v))
          (int/eq s 2) (int/add (int/add points edges) (array/nth pov v))
          :else (int/add points (array/nth eov (array/nth pv v))))))
(defn sd_out_loop :context value
  [(vp : (array int)) (po : (array int)) (eov : (array int)) (unit : (array int)) (points : int) (i : int)]
  (let* [f (array/nth unit (int/div i 12)) s (int/mod i 12) first (array/nth po f)
         code (int/and (int/shr 47725527896 (int/mul 3 s)) 7)]
    (cond (int/lt code 3) (array/nth vp (int/add first code))
          (int/eq code 3) (int/add points (array/nth eov first))
          (int/eq code 4) (int/add points (array/nth eov (int/add first 1)))
          :else (int/add points (array/nth eov (int/add first 2))))))
; Kept units: every corner (Catmull-Clark, Bilinear) or triangle (Loop) of a visible primitive.
(defn sd_units :context value
  [(pov : (array int)) (visible : (array int)) (scheme : int) (vertices : int) (prims : int)]
  (if (int/eq scheme 1)
    (array/compact visible)
    (array/compact (exact (map (fn [(c : int)] (array/nth visible (array/nth pov c))) (array/range vertices :type int))))))

; ---- creases ----
; Flagged edge slots at every point: count, first and last neighbour (the point itself when none).
(defn sd_pick :context value
  [(peo : (array int)) (pe : (array int)) (ea : (array int)) (eb : (array int)) (flag : (array int)) (points : int)]
  (let* [slots (array/nth peo points)
         owner (sd_owners peo slots)
         sr (array/range slots :type int)
         prefix (array/scan_sum flag)
         rank (exact (map (fn [(s : int) (o : int)] (int/sub (array/nth prefix s) (array/nth prefix (array/nth peo o)))) sr owner))
         cnt (array/scatter_add owner flag (int/add points 1))
         neighbor (exact (map (fn [(s : int) (o : int)]
           (let* [e (array/nth pe s)] (if (int/eq (array/nth ea e) o) (array/nth eb e) (array/nth ea e)))) sr owner))
         plus (exact (map (fn [(n : int)] (int/add n 1)) neighbor))
         key0 (exact (map (fn [(f : int) (r : int) (o : int)] (if (and (int/eq f 1) (int/eq r 0)) o points)) flag rank owner))
         keyl (exact (map (fn [(f : int) (r : int) (o : int)]
           (if (and (int/eq f 1) (int/eq r (int/sub (array/nth cnt o) 1))) o points)) flag rank owner))
         first (array/scatter_add key0 plus (int/add points 1))
         last (array/scatter_add keyl plus (int/add points 1))
         pr (array/range points :type int)]
    {:count (exact (map (fn [(p : int)] (array/nth cnt p)) pr))
     :first (exact (map (fn [(p : int)] (if (int/eq (array/nth cnt p) 0) p (int/sub (array/nth first p) 1))) pr))
     :last (exact (map (fn [(p : int)] (if (int/eq (array/nth cnt p) 0) p (int/sub (array/nth last p) 1))) pr))}))
(defn sd_clamp01 :context value [(x : float)] (if (<= x 0.0) 0.0 (if (>= x 1.0) 1.0 x)))
(defn sd_kind :context value [(corner : float) (count : int)]
  (if (or (> corner 0.0) (int/gt count 2)) 2 (if (int/eq count 2) 1 0)))
; Chaikin child sharpness of a (point, edge) slot.
(defn sd_chaikin :context value [(parent : float) (count : int) (total : float)]
  (cond (<= parent 0.0) 0.0
        (int/le count 1) (max 0.0 (- parent 1.0))
        :else (let* [others (/ (- total parent) (float (int/sub count 1)))]
                (max 0.0 (- (fma 0.25 others (* 0.75 parent)) 1.0)))))
; Crease plan: edge sharpness, child sharpness (two per edge, by endpoint), vertex classification before and
; after the pass, transition factors and edge factors.
(defn sd_cplan :context value
  [(tp : {:ea (array int) :eb (array int) :peo (array int) :pe (array int) :ev0 (array int) :ev1 (array int)
          :pov (array int) :points int :edges int})
   (vw : (array float)) (pw : (array float)) (cw : (array float)) (override : float) (method : int)]
  (let* [points tp.points edges tp.edges
         er (array/range edges :type int)
         sharp (exact (map (fn [(e : int)]
           (if (>= override 0.0) override
             (let* [v0 (array/nth tp.ev0 e) v1 (array/nth tp.ev1 e)]
               (max (max (array/nth vw v0) (if (int/ge v1 0) (array/nth vw v1) 0.0))
                    (max (array/nth pw (array/nth tp.pov v0)) (if (int/ge v1 0) (array/nth pw (array/nth tp.pov v1)) 0.0))))))
           er))
         slots (array/nth tp.peo points)
         sr (array/range slots :type int)
         owner (sd_owners tp.peo slots)
         se (exact (map (fn [(s : int)] (array/nth tp.pe s)) sr))
         side (exact (map (fn [(e : int) (o : int)] (if (int/eq (array/nth tp.ea e) o) 0 1)) se owner))
         psl (exact (map (fn [(e : int)] (array/nth sharp e)) se))
         pflag (exact (map (fn [(w : float)] (if (> w 0.0) 1 0)) psl))
         tsum (array/segment_sum (exact (map (fn [(w : float)] (if (> w 0.0) w 0.0)) psl)) tp.peo)
         tcount (array/segment_sum pflag tp.peo)
         csl (if (int/eq method 1)
               (exact (map (fn [(w : float) (o : int)] (sd_chaikin w (array/nth tcount o) (array/nth tsum o))) psl owner))
               (exact (map (fn [(w : float)] (max 0.0 (- w 1.0))) psl)))
         cflag (exact (map (fn [(w : float)] (if (> w 0.0) 1 0)) csl))
         child (array/scatter_add (exact (map (fn [(e : int) (sd : int)] (int/add (int/mul 2 e) sd)) se side)) csl (int/mul 2 edges))
         pp (sd_pick tp.peo tp.pe tp.ea tp.eb pflag points)
         cp (sd_pick tp.peo tp.pe tp.ea tp.eb cflag points)
         pr (array/range points :type int)
         pk (exact (map (fn [(p : int)] (sd_kind (array/nth cw p) (array/nth pp.count p))) pr))
         ck (exact (map (fn [(p : int)] (sd_kind (max 0.0 (- (array/nth cw p) 1.0)) (array/nth cp.count p))) pr))
         tval (if (int/eq method 1)
                (exact (map (fn [(w : float) (c : float)] (if (and (> w 0.0) (<= c 0.0)) w 0.0)) psl csl))
                (exact (map (fn [(w : float)] (if (and (> w 0.0) (<= w 1.0)) w 0.0)) psl)))
         tflag (if (int/eq method 1)
                 (exact (map (fn [(w : float) (c : float)] (if (and (> w 0.0) (<= c 0.0)) 1 0)) psl csl))
                 (exact (map (fn [(w : float)] (if (and (> w 0.0) (<= w 1.0)) 1 0)) psl)))
         ttotal (array/segment_sum tval tp.peo)
         tnum (array/segment_sum tflag tp.peo)
         factor (exact (map (fn [(p : int)]
           (let* [pc (array/nth cw p) cc (max 0.0 (- (array/nth cw p) 1.0))
                  lead (and (> pc 0.0) (<= cc 0.0))
                  num (int/add (array/nth tnum p) (if lead 1 0))]
             (if (int/eq num 0) 0.0
               (sd_clamp01 (/ (+ (array/nth ttotal p) (if lead pc 0.0)) (float num))))))
           pr))
         ef (exact (map (fn [(e : int)]
           (let* [parent (array/nth sharp e)]
             (if (and (int/eq method 1) (and (and (> parent 0.0) (< parent 1.0))
                       (and (> (array/nth child (int/mul 2 e)) 0.0) (> (array/nth child (int/add (int/mul 2 e) 1)) 0.0))))
               1.0 (sd_clamp01 parent))))
           er))]
    {:sharp sharp :child child :pk pk :ck ck :pa pp.first :pb pp.last :ca cp.first :cb cp.last :factor factor :ef ef}))
(defn sd_av :context value [(smooth : float) (src : (array float)) (kind : int) (p : int) (a : int) (b : int)]
  (cond (int/eq kind 2) (array/nth src p)
        (int/eq kind 1) (fma (array/nth src p) 0.75 (* (+ (array/nth src a) (array/nth src b)) 0.125))
        :else smooth))
(defn sd_adjust_points :context value
  [(smooth : (array float)) (src : (array float)) (pk : (array int)) (ck : (array int))
   (pa : (array int)) (pb : (array int)) (ca : (array int)) (cb : (array int)) (factor : (array float))]
  (exact (map (fn [(p : int) (s : float)]
    (let* [parent (sd_av s src (array/nth pk p) p (array/nth pa p) (array/nth pb p))]
      (if (int/eq (array/nth pk p) (array/nth ck p)) parent
        (let* [child (sd_av s src (array/nth ck p) p (array/nth ca p) (array/nth cb p))]
          (fma (- parent child) (array/nth factor p) child)))))
    (array/range (array/count smooth) :type int) smooth)))
(defn sd_adjust_edges :context value
  [(smooth : (array float)) (src : (array float)) (ea : (array int)) (eb : (array int)) (ef : (array float))]
  (exact (map (fn [(e : int) (s : float)]
    (let* [f (array/nth ef e)]
      (if (= f 0.0) s
        (fma (- (* (+ (array/nth src (array/nth ea e)) (array/nth src (array/nth eb e))) 0.5) s) f s))))
    (array/range (array/count smooth) :type int) smooth)))
; Creased point values for one plane: vertex points, edge points, then the face points untouched.
(defn sd_apply :context value
  [(smooth : (array float)) (src : (array float))
   (cp : {:pk (array int) :ck (array int) :pa (array int) :pb (array int) :ca (array int) :cb (array int)
          :factor (array float) :ef (array float)})
   (ea : (array int)) (eb : (array int)) (points : int) (edges : int)]
  (let* [outs (array/count smooth)
         used (int/add points edges)
         head (array/slice smooth 0 points)
         mids (array/slice smooth points edges)
         tail (array/slice smooth used (int/sub outs used))
         pk cp.pk ck cp.ck pa cp.pa pb cp.pb ca cp.ca cb cp.cb factor cp.factor ef cp.ef]
    (array/concat
      (array/concat
        (sd_adjust_points head src pk ck pa pb ca cb factor)
        (sd_adjust_edges mids src ea eb ef))
      tail)))

; ---- output element maps (vertex kind 0 corner copy, 1 edge point, 2 face point) ----
(defn sd_vk :context value [(scheme : int) (i : int)]
  (if (int/eq scheme 1)
    (int/sub 1 (int/and (int/shr 73 (int/mod i 12)) 1))
    (let* [s (int/mod i 4)] (cond (int/eq s 0) 0 (int/eq s 2) 2 :else 1))))
; Digit tables packed two bits per Loop slot (b and e are stored plus one).
(defn sd_loop_a :context value [(s : int)] (int/and (int/shr 9544032 (int/mul 2 s)) 3))
(defn sd_loop_b :context value [(s : int)] (int/sub (int/and (int/shr 8080152 (int/mul 2 s)) 3) 1))
(defn sd_loop_e :context value [(s : int)] (int/sub (int/and (int/shr 144561 (int/mul 2 s)) 3) 1))
(defn sd_va :context value [(pv : (array int)) (po : (array int)) (unit : (array int)) (scheme : int) (i : int)]
  (if (int/eq scheme 1)
    (int/add (array/nth po (array/nth unit (int/div i 12))) (sd_loop_a (int/mod i 12)))
    (let* [v (array/nth unit (int/div i 4)) s (int/mod i 4)]
      (cond (int/lt s 2) v (int/eq s 3) (array/nth pv v) :else -1))))
(defn sd_vb :context value [(nv : (array int)) (po : (array int)) (unit : (array int)) (scheme : int) (i : int)]
  (if (int/eq scheme 1)
    (let* [o (sd_loop_b (int/mod i 12))] (if (int/lt o 0) -1 (int/add (array/nth po (array/nth unit (int/div i 12))) o)))
    (let* [v (array/nth unit (int/div i 4)) s (int/mod i 4)]
      (cond (int/eq s 1) (array/nth nv v) (int/eq s 3) v :else -1))))
(defn sd_ve :context value
  [(eov : (array int)) (pv : (array int)) (po : (array int)) (unit : (array int)) (scheme : int) (i : int)]
  (if (int/eq scheme 1)
    (let* [o (sd_loop_e (int/mod i 12))] (if (int/lt o 0) -1 (array/nth eov (int/add (array/nth po (array/nth unit (int/div i 12))) o))))
    (let* [v (array/nth unit (int/div i 4)) s (int/mod i 4)]
      (cond (int/eq s 0) (array/nth eov v) (int/eq s 3) (array/nth eov (array/nth pv v)) :else -1))))
(defn sd_omap :context value
  [(tp : {:nv (array int) :pv (array int) :po (array int) :pov (array int) :eov (array int)})
   (unit : (array int)) (scheme : int)]
  (let* [corners (int/mul (if (int/eq scheme 1) 12 4) (array/count unit))
         cr (array/range corners :type int)
         vk (exact (map (fn [(i : int)] (sd_vk scheme i)) cr))
         va (exact (map (fn [(i : int)] (sd_va tp.pv tp.po unit scheme i)) cr))
         vb (exact (map (fn [(i : int)] (sd_vb tp.nv tp.po unit scheme i)) cr))
         ve (exact (map (fn [(i : int)] (sd_ve tp.eov tp.pv tp.po unit scheme i)) cr))
         vprim (exact (map (fn [(i : int)] (if (int/eq scheme 1) -1 (array/nth tp.pov (array/nth unit (int/div i 4))))) cr))
         outprims (if (int/eq scheme 1) (int/mul 4 (array/count unit)) (array/count unit))
         psrc (exact (map (fn [(i : int)] (if (int/eq scheme 1) (array/nth unit (int/div i 4)) (array/nth tp.pov (array/nth unit i))))
                (array/range outprims :type int)))
         repa (exact (map (fn [(k : int) (a : int) (b : int)]
           (cond (int/eq k 0) a (int/eq k 1) (if (int/lt a b) a b) :else -1)) vk va vb))
         repv (exact (map (fn [(r : int) (f : int)] (if (int/ge r 0) r (array/nth tp.po (if (int/lt f 0) 0 f)))) repa vprim))]
    {:vk vk :va va :vb vb :ve ve :vprim vprim :psrc psrc :repv repv}))

; ---- group masks over the output elements ----
(defn sd_mask_point :context value
  [(gm : (array int)) (ea : (array int)) (eb : (array int)) (po : (array int)) (vp : (array int)) (scheme : int)]
  (let* [edges (array/count ea)
         faces (if (int/eq scheme 1) (array/int 0 0)
                 (array/segment_min (exact (map (fn [(c : int)] (array/nth gm (array/nth vp c))) (array/range (array/count vp) :type int))) po))]
    (array/concat (array/concat gm
      (exact (map (fn [(e : int)] (if (and (int/eq (array/nth gm (array/nth ea e)) 1) (int/eq (array/nth gm (array/nth eb e)) 1)) 1 0))
        (array/range edges :type int)))) faces)))
(defn sd_mask_vertex :context value
  [(gm : (array int)) (po : (array int)) (vk : (array int)) (va : (array int)) (vb : (array int)) (vprim : (array int))]
  (let* [fm (array/segment_min gm po)
         partial (exact (map (fn [(k : int) (a : int) (b : int)]
           (cond (int/eq k 0) (array/nth gm a)
                 (int/eq k 1) (if (and (int/eq (array/nth gm a) 1) (int/eq (array/nth gm b) 1)) 1 0)
                 :else -1)) vk va vb))]
    (exact (map (fn [(x : int) (f : int)] (if (int/ge x 0) x (array/nth fm f))) partial vprim))))
(defn sd_ranks :context value [(order : {:ordered bool :indices (array int)}) (total : int)]
  (array/scatter_add order.indices
    (exact (map (fn [(j : int)] (int/add j 1)) (array/range (array/count order.indices) :type int))) total))
; One group of the source carried to the output: mask over the output elements, sot = source element each output
; element copies (-1: none), which decides the order of an ordered group.
(defn sd_gset :context sop
  [(acc : geometry) (source : geometry) (owner : text) (name : text) (mask : (array int)) (sot : (array int))]
  (let* [gm (sop/group source :name name :owner owner)
         order (sop/group_order source :name name :owner owner)
         total (array/count gm)
         ranks (sd_ranks order total)
         members (array/compact mask)
         keys (exact (map (fn [(tt : int)]
           (let* [s (array/nth sot tt)]
             (if (and (int/ge s 0) (int/gt (array/nth ranks (if (int/ge s 0) s 0)) 0))
               (int/sub (array/nth ranks s) 1) (int/add total tt)))) members))
         sorted (exact (map (fn [(j : int)] (array/nth members j)) (array/grade keys)))]
    (sop/with_group acc (exact mask) :name name :owner owner :order {:ordered order.ordered :indices sorted})))
(defn sd_group_p :context sop
  [(acc : geometry) (source : geometry) (name : text)
   (tp : {:ea (array int) :eb (array int) :po (array int) :vp (array int) :points int}) (scheme : int)]
  (let* [gm (sop/group source :name name :owner "point")
         mask (sd_mask_point gm tp.ea tp.eb tp.po tp.vp scheme)]
    (sd_gset acc source "point" name mask
      (exact (map (fn [(o : int)] (if (int/lt o tp.points) o -1)) (array/range (array/count mask) :type int))))))
(defn sd_group_v :context sop
  [(acc : geometry) (source : geometry) (name : text) (tp : {:po (array int)})
   (om : {:vk (array int) :va (array int) :vb (array int) :vprim (array int)})]
  (let* [gm (sop/group source :name name :owner "vertex")]
    (sd_gset acc source "vertex" name (sd_mask_vertex gm tp.po om.vk om.va om.vb om.vprim)
      (exact (map (fn [(k : int) (a : int)] (if (int/eq k 0) a -1)) om.vk om.va)))))
(defn sd_group_f :context sop
  [(acc : geometry) (source : geometry) (name : text) (om : {:psrc (array int)})]
  (let* [gm (sop/group source :name name :owner "primitive")]
    (sd_gset acc source "primitive" name (exact (map (fn [(s : int)] (array/nth gm s)) om.psrc)) om.psrc)))

; ---- resulting creases ----
; Child sharpness of the source edge a vertex starts (0 for vertices without one).
(defn sd_resval :context value
  [(ve : (array int)) (vpo : (array int)) (ea : (array int)) (child : (array float)) (points : int) (sides : int) (i : int)]
  (let* [se (array/nth ve i)
         own (array/nth vpo i)
         nxt (if (int/eq (int/mod i sides) (int/sub sides 1)) (int/sub i (int/sub sides 1)) (int/add i 1))
         point (if (int/lt own points) own (array/nth vpo nxt))
         side (if (int/eq point (array/nth ea (if (int/lt se 0) 0 se))) 0 1)]
    (if (int/lt se 0) 0.0 (array/nth child (int/add (int/mul 2 se) side)))))

; ---- attribute carry ----
(defn sd_join2 :context value [(x : (array float)) (y : (array float))]
  (exact (map (fn [(k : int)] [(array/nth x k) (array/nth y k)]) (array/range (array/count x) :type int))))
(defn sd_join4 :context value [(x : (array float)) (y : (array float)) (z : (array float)) (w : (array float))]
  (exact (map (fn [(k : int)] [(array/nth x k) (array/nth y k) (array/nth z k) (array/nth w k)])
    (array/range (array/count x) :type int))))
(defn sd_xs2 :context value [(p : (array vec2))] (exact (map (fn [(q : vec2)] q.x) p)))
(defn sd_ys2 :context value [(p : (array vec2))] (exact (map (fn [(q : vec2)] q.y) p)))
(defn sd_xs4 :context value [(p : (array vec4))] (exact (map (fn [(q : vec4)] q.x) p)))
(defn sd_ys4 :context value [(p : (array vec4))] (exact (map (fn [(q : vec4)] q.y) p)))
(defn sd_zs4 :context value [(p : (array vec4))] (exact (map (fn [(q : vec4)] q.z) p)))
(defn sd_ws4 :context value [(p : (array vec4))] (exact (map (fn [(q : vec4)] q.w) p)))
; A point attribute interpolated through the stencil (numeric kinds); other kinds keep the representative copy.
(defn sd_attr_p :context sop
  [(acc : geometry) (source : geometry) (name : text) (kind : text)
   (tp : {:ea (array int) :eb (array int) :points int :edges int})
   (plan : {:st {:offsets (array int) :sources (array int) :weights (array float)}
            :cp {:pk (array int) :ck (array int) :pa (array int) :pb (array int) :ca (array int) :cb (array int)
                 :factor (array float) :ef (array float)}})
   (scheme : int)]
  (cond
    (equal? name "cornerweight") acc
    (equal? kind "float")
      (sop/with_attr acc name
        (sd_plane (sop/attr source name :owner "point" :type float) plan.st plan.cp tp.ea tp.eb tp.points tp.edges scheme)
        :owner "point" :type float)
    (equal? kind "vec2")
      (let* [v (sop/attr source name :owner "point" :type vec2)]
        (sop/with_attr acc name
          (sd_join2 (sd_plane (sd_xs2 v) plan.st plan.cp tp.ea tp.eb tp.points tp.edges scheme)
                    (sd_plane (sd_ys2 v) plan.st plan.cp tp.ea tp.eb tp.points tp.edges scheme))
          :owner "point" :type vec2))
    (equal? kind "vec3")
      (let* [v (sop/attr source name :owner "point" :type vec3)]
        (sop/with_attr acc name
          (sd_join3 (sd_plane (sd_xs v) plan.st plan.cp tp.ea tp.eb tp.points tp.edges scheme)
                    (sd_plane (sd_ys v) plan.st plan.cp tp.ea tp.eb tp.points tp.edges scheme)
                    (sd_plane (sd_zs v) plan.st plan.cp tp.ea tp.eb tp.points tp.edges scheme))
          :owner "point" :type vec3))
    (equal? kind "vec4")
      (let* [v (sop/attr source name :owner "point" :type vec4)]
        (sop/with_attr acc name
          (sd_join4 (sd_plane (sd_xs4 v) plan.st plan.cp tp.ea tp.eb tp.points tp.edges scheme)
                    (sd_plane (sd_ys4 v) plan.st plan.cp tp.ea tp.eb tp.points tp.edges scheme)
                    (sd_plane (sd_zs4 v) plan.st plan.cp tp.ea tp.eb tp.points tp.edges scheme)
                    (sd_plane (sd_ws4 v) plan.st plan.cp tp.ea tp.eb tp.points tp.edges scheme))
          :owner "point" :type vec4))
    :else acc))
; Vertex floats with face-varying interpolation "All": corners copy, edge corners average, face corners are the mean.
(defn sd_linear :context value
  [(src : (array float)) (po : (array int)) (om : {:vk (array int) :va (array int) :vb (array int) :vprim (array int)})]
  (let* [fsum (array/segment_sum src po)
         partial (exact (map (fn [(k : int) (a : int) (b : int)]
           (cond (int/eq k 0) (array/nth src a)
                 (int/eq k 1) (* (+ (array/nth src a) (array/nth src b)) 0.5)
                 :else 0.0)) om.vk om.va om.vb))]
    (exact (map (fn [(x : float) (k : int) (f : int)]
      (if (int/eq k 2)
        (/ (array/nth fsum f) (float (int/sub (array/nth po (int/add f 1)) (array/nth po f))))
        x)) partial om.vk om.vprim))))

; ---- preparation ----
(defn sd_has_hole :context sop [(g : geometry)]
  (int/gt (array/count (sop/group_names g "subdivision_hole" :owner "primitive")) 0))
; Primitives that stay in the output of the final pass (1), or all of them.
(defn sd_visible :context sop [(g : geometry) (rm : bool) (prims : int)]
  (if rm
    (exact (map (fn [(h : int)] (int/sub 1 h))
      (if (sd_has_hole g) (sop/group g :name "subdivision_hole" :owner "primitive") (array/int prims 0))))
    (array/int prims 1)))
; The named hole group copied under the name the passes read.
(defn sd_copy_hole :context sop [(g : geometry) (name : text)]
  (let* [order (sop/group_order g :name name :owner "primitive")]
    (sop/with_group g (sop/group g :name name :owner "primitive") :name "subdivision_hole" :owner "primitive"
      :order {:ordered order.ordered :indices order.indices})))
; Boundary primitives (a corner on a boundary point) join the hole group when boundary interpolation is None.
(defn sd_bholes :context sop [(g : geometry)]
  (let* [adj (sop/adjacency g)
         topo (sop/topology g)
         edges (sop/count g :edges) points (sop/count g :points) prims (sop/count g :primitives)
         vertices (sop/count g :vertices)
         use (array/scatter_add (exact (map (fn [(e : int)] (if (int/ge e 0) e edges)) adj.edge_of_vertex))
               (array/int vertices 1) (int/add edges 1))
         bedge (exact (map (fn [(e : int)] (if (int/eq (array/nth use e) 1) 1 0)) (array/range edges :type int)))
         pa (array/scatter_add (exact (map (fn [(e : int) (b : int)] (if (int/eq b 1) (array/nth adj.edge_a e) points))
                (array/range edges :type int) bedge)) bedge (int/add points 1))
         pb (array/scatter_add (exact (map (fn [(e : int) (b : int)] (if (int/eq b 1) (array/nth adj.edge_b e) points))
                (array/range edges :type int) bedge)) bedge (int/add points 1))
         vflag (exact (map (fn [(p : int)] (if (int/gt (int/add (array/nth pa p) (array/nth pb p)) 0) 1 0)) topo.vertex_points))
         fb (array/segment_max vflag topo.primitive_offsets)
         has (sd_has_hole g)
         existing (if has (sop/group g :name "subdivision_hole" :owner "primitive") (array/int prims 0))
         union (exact (map (fn [(a : int) (b : int)] (if (or (int/eq a 1) (int/eq b 1)) 1 0)) existing fb))
         made (sop/with_group g union :name "subdivision_hole" :owner "primitive")]
    (sop/delete_group made (if (and (not has) (int/eq (array/sum fb) 0)) "subdivision_hole" "") :owner "primitive")))

; ---- crease input (native apply_crease_input) ----
(defn sd_cfail :context value [(reason : text)]
  (error "invalid_topology" "subdivide could not produce valid geometry"
    :cause (str "subdivide [invalid_topology]: Rdk_mesh.Subdivide.subdivide: " reason)))
(defn sd_finite_ge0 :context value [(x : float)] (if (and (= (- x x) 0.0) (>= x 0.0)) 0 1))
; Sharpness a crease corner contributes: the override, else the larger of its vertex and primitive weights.
(defn sd_contrib :context value
  [(cvw : (array float)) (cpw : (array float)) (pov : (array int)) (ov : float) (c : int)]
  (if (>= ov 0.0) ov (max (array/nth cvw c) (array/nth cpw (array/nth pov c)))))
(defn sd_cinput :context sop
  [(src : geometry) (cr : geometry) (selname : text) (has_sel : bool) (ov : float)]
  (let* [sadj (sop/adjacency src) stop (sop/topology src)
         cadj (sop/adjacency cr) ctop (sop/topology cr)
         edges (sop/count src :edges) cedges (sop/count cr :edges)
         verts (sop/count src :vertices) cverts (sop/count cr :vertices)
         sp (sop/count src :points) cp (sop/count cr :points)
         prims (sop/count src :primitives) cprims (sop/count cr :primitives)
         ident (if (and (int/eq sp cp) (and (int/eq verts cverts) (int/eq prims cprims)))
                 (if (and (int/eq (array/sum (exact (map (fn [(a : int) (b : int)] (if (int/eq a b) 0 1)) stop.vertex_points ctop.vertex_points))) 0)
                          (and (int/eq (array/sum (exact (map (fn [(a : int) (b : int)] (if (int/eq a b) 0 1)) stop.primitive_offsets ctop.primitive_offsets))) 0)
                               (int/eq (array/sum (exact (map (fn [(a : int) (b : int)] (if (int/eq a b) 0 1)) stop.kinds ctop.kinds))) 0)))
                   1 0)
                 0)
         has_cvw (sop/has_attr cr "creaseweight" :owner "vertex" :type float)
         has_cpw (sop/has_attr cr "creaseweight" :owner "primitive" :type float)
         any_cvw (sop/has_attr cr "creaseweight" :owner "vertex")
         any_cpw (sop/has_attr cr "creaseweight" :owner "primitive")
         cvw (if has_cvw (sop/attr cr "creaseweight" :owner "vertex" :type float) (array/float cverts))
         cpw (if has_cpw (sop/attr cr "creaseweight" :owner "primitive" :type float) (array/float cprims))
         bad_weights (int/add (array/sum (exact (map (fn [(x : float)] (sd_finite_ge0 x)) cvw)))
                              (array/sum (exact (map (fn [(x : float)] (sd_finite_ge0 x)) cpw))))
         contributes (or (>= ov 0.0) (or has_cvw has_cpw))
         csel (if has_sel (sop/group cr :name selname :owner "primitive") (array/int cprims 1))
         cv (array/range cverts :type int)
         cweights (exact (map (fn [(c : int)] (sd_contrib cvw cpw cadj.primitive_of_vertex ov c)) cv))
         csel_v (exact (map (fn [(c : int)] (array/nth csel (array/nth cadj.primitive_of_vertex c))) cv))
         cev (sd_ev cadj cedges cverts)
         ce (array/range cedges :type int)
         eflag (exact (map (fn [(e : int)]
           (let* [c0 (array/nth cev.first e) c1 (array/nth cev.second e)]
             (if (or (int/eq (array/nth csel_v c0) 1) (and (int/ge c1 0) (int/eq (array/nth csel_v (if (int/ge c1 0) c1 0)) 1))) 1 0))) ce))
         ew (exact (map (fn [(e : int)]
           (let* [c0 (array/nth cev.first e) c1 (array/nth cev.second e)
                  s0 (int/eq (array/nth csel_v c0) 1)
                  s1 (and (int/ge c1 0) (int/eq (array/nth csel_v (if (int/ge c1 0) c1 0)) 1))
                  w0 (array/nth cweights c0)
                  w1 (array/nth cweights (if (int/ge c1 0) c1 0))]
             (cond (and s0 s1) (max w0 w1) s0 w0 s1 w1 :else 0.0))) ce))
         k (int/add (if (int/gt sp cp) sp cp) 1)
         skeys (exact (map (fn [(e : int)] (int/add (int/mul (array/nth sadj.edge_a e) k) (array/nth sadj.edge_b e))) (array/range edges :type int)))
         qkeys (exact (map (fn [(e : int)] (int/add (int/mul (array/nth cadj.edge_a e) k) (array/nth cadj.edge_b e))) ce))
         found (if (int/eq ident 1) (array/range cedges :type int) (array/index_of skeys qkeys))
         target (exact (map (fn [(f : int) (s : int)] (if (and (int/eq f 1) (int/ge s 0)) s edges)) eflag found))
         aflag (array/scatter_add target (array/int cedges 1) (int/add edges 1))
         aw (array/scatter_add target ew (int/add edges 1))
         has_svw (sop/has_attr src "creaseweight" :owner "vertex" :type float)
         has_spw (sop/has_attr src "creaseweight" :owner "primitive" :type float)
         svw (if has_svw (sop/attr src "creaseweight" :owner "vertex" :type float) (array/float verts))
         spw (if has_spw (sop/attr src "creaseweight" :owner "primitive" :type float) (array/float prims))
         sev (sd_ev sadj edges verts)
         er (array/range edges :type int)
         base (exact (map (fn [(e : int)]
           (let* [v0 (array/nth sev.first e) v1 (array/nth sev.second e)]
             (max (max (array/nth svw v0) (if (int/ge v1 0) (array/nth svw v1) 0.0))
                  (max (array/nth spw (array/nth sadj.primitive_of_vertex v0))
                       (if (int/ge v1 0) (array/nth spw (array/nth sadj.primitive_of_vertex v1)) 0.0))))) er))
         sharp (exact (map (fn [(e : int)] (if (int/gt (array/nth aflag e) 0) (array/nth aw e) (array/nth base e))) er))
         changed (int/gt (array/sum (exact (map (fn [(e : int)]
           (if (and (int/gt (array/nth aflag e) 0) (not (= (array/nth base e) (array/nth aw e)))) 1 0)) er))) 0)
         cvals (exact (map (fn [(e : int)] (if (int/ge e 0) (array/nth sharp e) 0.0)) sadj.edge_of_vertex))
         stage (sop/delete_attrs src :primitive "creaseweight")
         written (sop/with_attr stage "creaseweight" cvals :owner "vertex" :type float)]
    (cond
      (or (and any_cvw (not has_cvw)) (and any_cpw (not has_cpw)))
        (sd_cfail "second-input creaseweight must use float storage")
      (int/gt bad_weights 0) (sd_cfail "second-input creaseweight values must be finite and non-negative")
      (and (< ov 0.0) (and (or has_cvw has_cpw) (int/eq ident 0)))
        (sd_cfail "creaseweight attributes require the source and crease inputs to have identical topology")
      (not contributes) src
      (and (not changed) (and has_svw (not has_spw))) src
      :else written)))

; ---- detail attribute overrides (osd_*) ----
; The value of an integer detail attribute within 0..hi, else the default; -1 outside, -2 not one value, -3 wrong storage.
(defn sd_osd :context sop [(g : geometry) (name : text) (default : int) (hi : int)]
  (let* [has (sop/has_attr g name :owner "detail")
         is_int (sop/has_attr g name :owner "detail" :type int)
         vals (if is_int (sop/attr g name :owner "detail" :type int) (array/int 1 0))]
    (cond (not has) default
          (not is_int) -3
          (not (int/eq (array/count vals) 1)) -2
          (or (int/lt (array/nth vals 0) 0) (int/gt (array/nth vals 0) hi)) -1
          :else (array/nth vals 0))))
; The scheme may also be a text: catmull-clark, loop or bilinear.
(defn sd_osd_scheme :context sop [(g : geometry) (default : int)]
  (let* [has (sop/has_attr g "osd_scheme" :owner "detail")
         is_int (sop/has_attr g "osd_scheme" :owner "detail" :type int)
         is_text (sop/has_attr g "osd_scheme" :owner "detail" :type text)
         ints (if is_int (sop/attr g "osd_scheme" :owner "detail" :type int) (array/int 1 0))
         texts (if is_text (sop/attr g "osd_scheme" :owner "detail" :type text) (array/text 1 ""))]
    (cond (not has) default
          is_int (cond (not (int/eq (array/count ints) 1)) -2
                       (or (int/lt (array/nth ints 0) 0) (int/gt (array/nth ints 0) 2)) -1
                       :else (array/nth ints 0))
          is_text (cond (not (int/eq (array/count texts) 1)) -2
                        (equal? (array/nth texts 0) "catmull-clark") 0
                        (equal? (array/nth texts 0) "loop") 1
                        (equal? (array/nth texts 0) "bilinear") 2
                        :else -1)
          :else -3)))
; Creaseweight and cornerweight attributes must be float and finite non-negative (native crease_data).
(defn sd_attr_bad :context sop [(g : geometry)]
  (let* [vany (sop/has_attr g "creaseweight" :owner "vertex")
         vflt (sop/has_attr g "creaseweight" :owner "vertex" :type float)
         pany (sop/has_attr g "creaseweight" :owner "primitive")
         pflt (sop/has_attr g "creaseweight" :owner "primitive" :type float)
         cany (sop/has_attr g "cornerweight" :owner "point")
         cflt (sop/has_attr g "cornerweight" :owner "point" :type float)
         vv (if vflt (sop/attr g "creaseweight" :owner "vertex" :type float) (array/float 0))
         pv (if pflt (sop/attr g "creaseweight" :owner "primitive" :type float) (array/float 0))
         cv (if cflt (sop/attr g "cornerweight" :owner "point" :type float) (array/float 0))]
    (int/add (int/add (if (or (and vany (not vflt)) (or (and pany (not pflt)) (and cany (not cflt)))) 1 0)
                      (array/sum (exact (map (fn [(x : float)] (sd_finite_ge0 x)) vv))))
             (int/add (array/sum (exact (map (fn [(x : float)] (sd_finite_ge0 x)) pv)))
                      (array/sum (exact (map (fn [(x : float)] (sd_finite_ge0 x)) cv)))))))

; ---- one pass ----
; The arrays a pass needs: stencil, output maps and crease plan.
(defn sd_plan :context sop
  [(g : geometry)
   (tp : {:vp (array int) :po (array int) :pov (array int) :nv (array int) :pv (array int) :eov (array int)
          :ea (array int) :eb (array int) :peo (array int) :pe (array int) :pvo (array int) :pvx (array int)
          :ev0 (array int) :ev1 (array int) :bc (array int) :bl (array int) :br (array int) :cum (array int)
          :ends (array int) :cornerpt (array int) :cornersz (array int) :e0f (array int) :e0s (array int)
          :e1f (array int) :e1s (array int) :ap0 (array int) :ap1 (array int)
          :points int :edges int :vertices int :prims int})
   (unit : (array int)) (scheme : int) (bmode : int) (tri : int) (method : int) (ov : float)]
  (let* [has_vw (sop/has_attr g "creaseweight" :owner "vertex")
         has_pw (sop/has_attr g "creaseweight" :owner "primitive")
         has_cw (sop/has_attr g "cornerweight" :owner "point")
         vw (if has_vw (sop/attr g "creaseweight" :owner "vertex" :type float) (array/float tp.vertices))
         pw (if has_pw (sop/attr g "creaseweight" :owner "primitive" :type float) (array/float tp.prims))
         cw (if has_cw (sop/attr g "cornerweight" :owner "point" :type float) (array/float tp.points))]
    {:st (sd_stencil tp scheme bmode tri) :om (sd_omap tp unit scheme) :cp (sd_cplan tp vw pw cw ov method) :cw cw :unit unit
     :vpo (let* [points tp.points edges tp.edges corners (int/mul (if (int/eq scheme 1) 12 4) (array/count unit))]
            (if (int/eq scheme 1)
              (exact (map (fn [(i : int)] (sd_out_loop tp.vp tp.po tp.eov unit points i)) (array/range corners :type int)))
              (exact (map (fn [(i : int)] (sd_out_cc tp.vp tp.pov tp.eov tp.pv unit points edges i)) (array/range corners :type int)))))}))

; One plane of a point attribute through the stencil, then the crease adjustments (not for Bilinear).
(defn sd_plane :context value
  [(src : (array float))
   (st : {:offsets (array int) :sources (array int) :weights (array float)})
   (cp : {:pk (array int) :ck (array int) :pa (array int) :pb (array int) :ca (array int) :cb (array int)
          :factor (array float) :ef (array float)})
   (ea : (array int)) (eb : (array int)) (points : int) (edges : int) (scheme : int)]
  (let* [smooth (sd_sum st.offsets st.sources st.weights src)]
    (if (int/eq scheme 2) smooth (sd_apply smooth src cp ea eb points edges))))

(defn sd_stage :context sop
  [(g : geometry)
   (tp : {:vp (array int) :po (array int) :pov (array int) :nv (array int) :pv (array int) :eov (array int)
          :ea (array int) :eb (array int) :points int :edges int :vertices int :prims int})
   (plan : {:st {:offsets (array int) :sources (array int) :weights (array float) :rep (array int)}
            :om {:ve (array int) :psrc (array int) :repv (array int)}
            :cp {:pk (array int) :ck (array int) :pa (array int) :pb (array int) :ca (array int) :cb (array int)
                 :factor (array float) :ef (array float) :child (array float)}
            :cw (array float) :unit (array int) :vpo (array int)})
   (scheme : int) (ov : float) (genres : bool) (final : bool) (rname : text)]
  (let* [points tp.points edges tp.edges
         outputs (if (int/eq scheme 1) (int/add points edges) (int/add (int/add points edges) tp.prims))
         has_vw (sop/has_attr g "creaseweight" :owner "vertex")
         has_pw (sop/has_attr g "creaseweight" :owner "primitive")
         has_cw (sop/has_attr g "cornerweight" :owner "point")
         pos (sop/attr g "P")
         x (sd_plane (sd_xs pos) plan.st plan.cp tp.ea tp.eb points edges scheme)
         y (sd_plane (sd_ys pos) plan.st plan.cp tp.ea tp.eb points edges scheme)
         z (sd_plane (sd_zs pos) plan.st plan.cp tp.ea tp.eb points edges scheme)
         corners (int/mul (if (int/eq scheme 1) 12 4) (array/count plan.unit))
         sides (if (int/eq scheme 1) 3 4)
         faces (int/div corners sides)
         vpo plan.vpo
         poo (exact (map (fn [(f : int)] (int/mul f sides)) (array/range (int/add faces 1) :type int)))
         mesh (sop/mesh :points (array/vec3 outputs) :vertex_points vpo :primitive_offsets poo
                :kinds (array/int faces 0))
         tadj (sop/adjacency mesh)
         tedges (sop/count mesh :edges)
         leaving (exact (map (fn [(te : int)] (if (int/lt te 0) tedges te)) tadj.edge_of_vertex))
         ancestor (exact (map (fn [(e : int)] (int/add e 1)) plan.om.ve))
         ecount (array/scatter_add leaving (array/int corners 1) (int/add tedges 1))
         esum (array/scatter_add leaving ancestor (int/add tedges 1))
         evalues (exact (map (fn [(e : int)]
             (int/sub (int/div (array/nth esum e) (if (int/gt (array/nth ecount e) 0) (array/nth ecount e) 1)) 1))
           (array/range tedges :type int)))
         ehas (exact (map (fn [(a : int)] (if (int/ge a 0) 1 0)) evalues))
         eidx (array/compact ehas)
         eanc (exact (map (fn [(k : int)] (array/nth evalues (array/nth eidx k))) (array/range (array/count eidx) :type int)))
         remapped (sop/remap g mesh :points plan.st.rep :vertices plan.om.repv :primitives plan.om.psrc
                    :edges {:offsets (array/scan_sum ehas) :values eanc})
         with_p (sop/with_attr remapped "P" (sd_join3 x y z))
         no_pw (sop/delete_attrs with_p :vertex "creaseweight" :primitive "creaseweight")
         ; cornerweight: kept (minus one) only when resulting creases are generated and one exceeds 1
         cw_need (if (and genres (int/gt (array/sum (exact (map (fn [(w : float)] (if (> w 1.0) 1 0)) plan.cw))) 0)) "" "cornerweight")
         cw_values (exact (map (fn [(o : int)] (if (int/lt o points) (max 0.0 (- (array/nth plan.cw o) 1.0)) 0.0))
                     (array/range outputs :type int)))
         cw_set (sop/with_attr no_pw "cornerweight" cw_values :owner "point" :type float)
         no_cw (sop/delete_attrs cw_set :point cw_need)
         edge_crease (if (or (>= ov 0.0) (or has_vw has_pw)) 1 0)
         child_any (if (int/gt (array/sum (exact (map (fn [(w : float)] (if (> w 0.0) 1 0)) plan.cp.child))) 0) 1 0)
         needi (if (and genres (int/eq (int/mul edge_crease child_any) 1)) 1 0)
         need_res (if (int/eq needi 1) "" "creaseweight")
         resvals (exact (map (fn [(i : int)] (sd_resval plan.om.ve vpo tp.ea plan.cp.child points sides i)) (array/range corners :type int)))
         with_res (sop/with_attr no_cw "creaseweight" resvals :owner "vertex" :type float)
         kept (sop/delete_attrs with_res :vertex need_res)
         eflag (exact (map (fn [(r : float)] (if (and (int/eq needi 1) (> r 0.0)) 1 0)) resvals))
         ecnt (array/scatter_add leaving eflag (int/add tedges 1))
         emask (exact (map (fn [(e : int)] (if (int/gt (array/nth ecnt e) 0) 1 0)) (array/range tedges :type int)))]
    (if (and final (not (text/blank? rname)))
      (sop/with_group kept emask :name rname :owner "edge")
      kept)))
; ---- face-varying vertex attributes (native fvar_refinement) ----
; All components of two corners equal (float equality; a missing component is a zero plane).
(defn sd_eq4 :context value
  [(p0 : (array float)) (p1 : (array float)) (p2 : (array float)) (p3 : (array float)) (a : int) (b : int)]
  (if (and (and (= (array/nth p0 a) (array/nth p0 b)) (= (array/nth p1 a) (array/nth p1 b)))
           (and (= (array/nth p2 a) (array/nth p2 b)) (= (array/nth p3 a) (array/nth p3 b)))) 1 0))
; Corners joined across their two edges at the point when their values are equal (self when not).
; The corner at the same point in the polygon across the outgoing / incoming edge of corner c (c itself when none).
(defn sd_nb1 :context value [(vp : (array int)) (nv : (array int)) (opp : (array int)) (c : int)]
  (let* [o (array/nth opp c)]
    (if (int/ge o 0) (if (int/eq (array/nth vp o) (array/nth vp c)) o (array/nth nv o)) c)))
(defn sd_nb2 :context value [(vp : (array int)) (nv : (array int)) (pv : (array int)) (opp : (array int)) (c : int)]
  (let* [o (array/nth opp (array/nth pv c))]
    (if (int/ge o 0) (if (int/eq (array/nth vp o) (array/nth vp c)) o (array/nth nv o)) c)))
(defn sd_join_eq :context value
  [(p0 : (array float)) (p1 : (array float)) (p2 : (array float)) (p3 : (array float)) (nb : (array int)) (c : int)]
  (if (int/eq (sd_eq4 p0 p1 p2 p3 c (array/nth nb c)) 1) (array/nth nb c) c))
; Smallest corner of every connected component of equal corners.
(defn sd_labels :context value [(e1 : (array int)) (e2 : (array int)) (vertices : int)]
  (iterate vertices (array/range vertices :type int)
    (fn [lab]
      (exact (map (fn [(c : int)]
        (let* [a (array/nth lab c) b (array/nth lab (array/nth e1 c)) d (array/nth lab (array/nth e2 c))]
          (if (int/lt a b) (if (int/lt a d) a d) (if (int/lt b d) b d))))
        (array/range vertices :type int))))
    :until (fn [(prev : (array int)) (next : (array int))]
      (int/eq (array/sum (exact (map (fn [(a : int) (b : int)] (if (int/eq a b) 0 1)) prev next))) 0))))
; Component numbering: per point in order of first appearance (native root_target / component_offsets).
(defn sd_comp :context value
  [(label : (array int)) (pvx : (array int)) (pvo : (array int)) (points : int) (vertices : int)]
  (let* [slots (array/count pvx)
         sr (array/range slots :type int)
         spoint (sd_owners pvo slots)
         sroot (exact (map (fn [(s : int)] (array/nth label (array/nth pvx s))) sr))
         order (array/grade sroot)
         firstsorted (exact (map (fn [(i : int)]
           (if (or (int/eq i 0)
                   (not (int/eq (array/nth sroot (array/nth order i))
                                (array/nth sroot (array/nth order (if (int/eq i 0) 0 (int/sub i 1)))))))
             1 0)) sr))
         ffirst (array/scatter_add order firstsorted slots)
         fscan (array/scan_sum ffirst)
         ncomp (array/nth fscan slots)
         rkey (exact (map (fn [(s : int)] (if (int/eq (array/nth ffirst s) 1) (array/nth sroot s) vertices)) sr))
         rtarget (array/scatter_add rkey (exact (map (fn [(s : int)] (int/add (array/nth fscan s) 1)) sr)) (int/add vertices 1))
         fvp (exact (map (fn [(c : int)] (int/sub (array/nth rtarget (array/nth label c)) 1)) (array/range vertices :type int)))
         ckey (exact (map (fn [(s : int)] (if (int/eq (array/nth ffirst s) 1) (array/nth fscan s) ncomp)) sr))
         src (array/scatter_add ckey (exact (map (fn [(s : int)] (int/add (array/nth pvx s) 1)) sr)) (int/add ncomp 1))
         orig (array/scatter_add ckey (exact (map (fn [(s : int)] (int/add (array/nth spoint s) 1)) sr)) (int/add ncomp 1))
         faces (array/scatter_add fvp (array/int vertices 1) (int/add ncomp 1))
         cnt (array/scatter_add spoint ffirst (int/add points 1))
         cr (array/range ncomp :type int)]
    {:n ncomp :fvp fvp
     :src (exact (map (fn [(k : int)] (int/sub (array/nth src k) 1)) cr))
     :orig (exact (map (fn [(k : int)] (int/sub (array/nth orig k) 1)) cr))
     :faces (exact (map (fn [(k : int)] (array/nth faces k)) cr))
     :cnt (exact (map (fn [(p : int)] (array/nth cnt p)) (array/range points :type int)))}))

; The kind of refinement: 0 continuous, 1 linear, 2 isolated corners, 3 split (a face-varying topology).
(defn sd_fv_kind :context value
  [(disc : int) (allone : int) (allpinned : int)]
  (cond (int/eq disc 0) 0 (int/eq allone 0) 3 (int/eq allpinned 1) 1 :else 2))
(defn sd_pinned_value :context value [] 1.0e300)

; Corner weights of the single-corner components (native branch for "every component is one face").
(defn sd_cw_single :context value
  [(cw : (array float)) (orig : (array int)) (pf : (array int)) (bmode : int) (mode : int)]
  (exact (map (fn [(k : int)]
    (let* [p (array/nth orig k)]
      (if (or (int/gt mode 0) (and (int/eq bmode 2) (int/eq (array/nth pf p) 1))) 1.0e300 (array/nth cw p))))
    (array/range (array/count orig) :type int))))

; One plane through the continuous refinement: refine the first corner values by the geometry stencil,
; pin the policy points, read each output corner at its point.
(defn sd_fv_cont :context value
  [(plane : (array float)) (fc : (array int)) (pinned : (array int))
   (st : {:offsets (array int) :sources (array int) :weights (array float)})
   (cp : {:pk (array int) :ck (array int) :pa (array int) :pb (array int) :ca (array int) :cb (array int)
          :factor (array float) :ef (array float)})
   (ea : (array int)) (eb : (array int)) (points : int) (edges : int) (scheme : int) (vpo : (array int))]
  (let* [srcv (exact (map (fn [(p : int)] (let* [c (array/nth fc p)] (if (int/ge c 0) (array/nth plane c) 0.0)))
                (array/range points :type int)))
         refined (sd_plane srcv st cp ea eb points edges scheme)
         fixed (exact (map (fn [(o : int) (r : float)]
           (if (and (int/lt o points) (int/eq (array/nth pinned (if (int/lt o points) o 0)) 1)) (array/nth srcv (if (int/lt o points) o 0)) r))
           (array/range (array/count refined) :type int) refined))]
    (exact (map (fn [(o : int)] (array/nth fixed o)) vpo))))
; Isolated corners: a corner blends towards its own value by the corner sharpness.
(defn sd_isolated :context value
  [(src : (array float)) (po : (array int)) (pv : (array int)) (nv : (array int)) (csv : (array float))
   (om : {:vk (array int) :va (array int) :vb (array int) :vprim (array int)})]
  (let* [fsum (array/segment_sum src po)
         part (exact (map (fn [(k : int) (a : int) (b : int)]
           (cond
             (int/eq k 0)
               (let* [s (array/nth src a)
                      smooth (fma 0.125 (array/nth src (array/nth nv a)) (fma 0.75 s (* 0.125 (array/nth src (array/nth pv a)))))
                      factor (sd_clamp01 (array/nth csv a))]
                 (fma (- s smooth) factor smooth))
             (int/eq k 1) (* (+ (array/nth src a) (array/nth src b)) 0.5)
             :else 0.0)) om.vk om.va om.vb))]
    (exact (map (fn [(x : float) (k : int) (f : int)]
      (if (int/eq k 2)
        (/ (array/nth fsum f) (float (int/sub (array/nth po (int/add f 1)) (array/nth po f))))
        x)) part om.vk om.vprim))))
; ---- face-varying: split topology ----
(defn sd_empty_cplan :context value []
  {:sharp (array/float 0) :child (array/float 0) :pk (array/int 0 0) :ck (array/int 0 0) :pa (array/int 0 0)
   :pb (array/int 0 0) :ca (array/int 0 0) :cb (array/int 0 0) :factor (array/float 0) :ef (array/float 0)})
(defn sd_empty_stencil :context value []
  {:offsets (array/int 0 0) :sources (array/int 0 0) :weights (array/float 0) :rep (array/int 0 0)})
; The face-varying mesh (one point per component), its stencil and crease plan.
(defn sd_split :context sop
  [(cm : {:n int :fvp (array int) :src (array int) :orig (array int) :faces (array int) :cnt (array int)})
   (tp : {:po (array int) :eov (array int) :bc (array int) :points int :prims int :vertices int})
   (pf : (array int)) (sharp : (array float)) (cw : (array float)) (vk : (array int)) (va : (array int)) (vprim : (array int))
   (scheme : int) (bmode : int) (tri : int) (method : int) (mode : int) (ecrease : int)]
  (let* [n cm.n
         fg (sop/mesh :points (array/vec3 n) :vertex_points cm.fvp :primitive_offsets tp.po :kinds (array/int tp.prims 0))
         ftp (sd_tables fg)
         kr (array/range n :type int)
         onecorner (exact (map (fn [(f : int)] (if (int/eq f 1) 1 0)) cm.faces))
         hascorner (array/scatter_add cm.orig onecorner (int/add tp.points 1))
         coff (array/scan_sum cm.cnt)
         policy (cond
           (int/eq mode 0) (array/int n 0)
           (int/eq mode 1) (exact (map (fn [(k : int)] (if (int/eq (array/nth cm.faces k) 1) 1 0)) kr))
           (int/eq mode 2) (exact (map (fn [(k : int) (p : int)]
                             (if (or (int/eq (array/nth cm.faces k) 1) (int/gt (array/nth cm.cnt p) 2)) 1 0)) kr cm.orig))
           (int/eq mode 3) (exact (map (fn [(k : int) (p : int)]
                             (let* [components (array/nth cm.cnt p) fk (array/nth cm.faces k) fb (array/nth ftp.bc k)]
                               (if (or (or (int/eq fk 1) (int/gt components 2))
                                       (or (and (int/eq components 1) (and (int/gt fb 0) (int/eq (array/nth tp.bc p) 0)))
                                           (and (int/eq components 2) (int/gt (array/nth hascorner p) 0)))) 1 0)) ) kr cm.orig))
           :else (exact (map (fn [(k : int)] (if (int/gt (array/nth ftp.bc k) 0) 1 0)) kr)))
         cw0 (exact (map (fn [(k : int) (p : int)]
           (if (or (int/eq (array/nth policy k) 1) (and (int/eq bmode 2) (int/eq (array/nth pf p) 1))) 1.0e300 (array/nth cw p)))
           kr cm.orig))
         fedge (array/range ftp.edges :type int)
         fsh (exact (map (fn [(e : int)]
           (if (int/ge (array/nth ftp.ev1 e) 0) (array/nth sharp (array/nth tp.eov (array/nth ftp.ev0 e))) 0.0)) fedge))
         internal (array/segment_max (exact (map (fn [(s : int)] (array/nth fsh (array/nth ftp.pe s)))
                      (array/range (array/count ftp.pe) :type int))) ftp.peo)
         fcw (if (and (int/eq ecrease 1) (or (int/eq mode 2) (int/eq mode 3)))
               (exact (map (fn [(k : int) (p : int)]
                 (let* [other (if (int/eq (array/nth cm.cnt p) 2)
                                (if (int/eq k (array/nth coff p)) (int/add k 1) (int/sub k 1)) -1)
                        o (if (int/ge other 0) other 0)
                        w (array/nth cw0 k)]
                   (if (and (int/ge other 0)
                            (and (= (array/nth internal k) 0.0)
                                 (and (> (array/nth internal o) 0.0) (int/gt (array/nth cm.faces o) 1))))
                     (max w (array/nth internal o)) w)))
                 kr cm.orig))
               cw0)
         fvw (if (int/eq ecrease 1)
               (exact (map (fn [(v : int)] (let* [e (array/nth tp.eov v)] (if (int/ge e 0) (array/nth sharp e) 0.0)))
                 (array/range tp.vertices :type int)))
               (array/float tp.vertices))
         fcp (sd_cplan ftp fvw (array/float tp.prims) fcw -1.0 method)
         fst (sd_stencil ftp scheme 1 tri)
         opf (exact (map (fn [(k : int) (a : int) (f : int)]
           (cond (int/eq k 0) (array/nth cm.fvp a)
                 (int/eq k 1) (int/add n (array/nth ftp.eov a))
                 :else (int/add (int/add n ftp.edges) f))) vk va vprim))]
    {:n n :src cm.src :opf opf :fedges ftp.edges :fst fst :fcp fcp :fea ftp.ea :feb ftp.eb}))
(defn sd_split_plane :context value
  [(plane : (array float))
   (sp : {:n int :src (array int) :opf (array int) :fedges int
          :fst {:offsets (array int) :sources (array int) :weights (array float)}
          :fcp {:pk (array int) :ck (array int) :pa (array int) :pb (array int) :ca (array int) :cb (array int)
                :factor (array float) :ef (array float)}
          :fea (array int) :feb (array int)})
   (scheme : int)]
  (let* [srcc (exact (map (fn [(c : int)] (array/nth plane c)) sp.src))
         refined (sd_plane srcc sp.fst sp.fcp sp.fea sp.feb sp.n sp.fedges scheme)]
    (exact (map (fn [(o : int)] (array/nth refined o)) sp.opf))))

; ---- face-varying context of one attribute ----
(defn sd_fv_ctx :context sop
  [(p0 : (array float)) (p1 : (array float)) (p2 : (array float)) (p3 : (array float))
   (tp : {:vp (array int) :po (array int) :nv (array int) :pv (array int) :eov (array int) :opp (array int)
          :pvo (array int) :pvx (array int) :bc (array int) :points int :vertices int :prims int})
   (plan : {:cp {:sharp (array float)} :cw (array float) :om {:vk (array int) :va (array int) :vprim (array int)}})
   (scheme : int) (bmode : int) (tri : int) (method : int) (mode : int) (ecrease : int)]
  (let* [points tp.points vertices tp.vertices
         pr (array/range points :type int)
         vr (array/range vertices :type int)
         pf (exact (map (fn [(p : int)] (int/sub (array/nth tp.pvo (int/add p 1)) (array/nth tp.pvo p))) pr))
         fc (exact (map (fn [(p : int)] (if (int/gt (array/nth pf p) 0) (array/nth tp.pvx (array/nth tp.pvo p)) -1)) pr))
         neq (exact (map (fn [(c : int)] (int/sub 1 (sd_eq4 p0 p1 p2 p3 c (array/nth fc (array/nth tp.vp c))))) vr))
         disc (array/scatter_add tp.vp neq (int/add points 1))
         anydisc (int/gt (array/sum (exact (map (fn [(d : int)] (if (int/gt d 0) 1 0)) disc))) 0)
         nb1 (exact (map (fn [(c : int)] (sd_nb1 tp.vp tp.nv tp.opp c)) vr))
         nb2 (exact (map (fn [(c : int)] (sd_nb2 tp.vp tp.nv tp.pv tp.opp c)) vr))
         e1 (exact (map (fn [(c : int)] (sd_join_eq p0 p1 p2 p3 nb1 c)) vr))
         e2 (exact (map (fn [(c : int)] (sd_join_eq p0 p1 p2 p3 nb2 c)) vr))
         label (sd_labels e1 e2 vertices)
         cm (sd_comp label tp.pvx tp.pvo points vertices)
         allone (int/eq (array/sum (exact (map (fn [(f : int)] (if (int/eq f 1) 0 1)) cm.faces))) 0)
         cws (sd_cw_single plan.cw cm.orig pf bmode mode)
         allpinned (int/eq (array/sum (exact (map (fn [(w : float)] (if (>= w 1.0) 0 1)) cws))) 0)
         k (cond (not anydisc) 0 (not allone) 3 allpinned 1 :else 2)
         pinned (if (int/eq k 0)
                  (exact (map (fn [(p : int)]
                    (cond (int/eq mode 0) 0
                          (int/le mode 3) (if (int/eq (array/nth pf p) 1) 1 0)
                          (int/eq mode 4) (if (int/gt (array/nth tp.bc p) 0) 1 0)
                          :else 0)) pr))
                  (array/int 0 0))
         csv (if (int/eq k 2) (exact (map (fn [(c : int)] (array/nth cws (array/nth cm.fvp c))) vr)) (array/float 0))
         sp (if (int/eq k 3)
              (sd_split cm tp pf plan.cp.sharp plan.cw plan.om.vk plan.om.va plan.om.vprim scheme bmode tri method mode ecrease)
              {:n 0 :src (array/int 0 0) :opf (array/int 0 0) :fedges 0 :fst (sd_empty_stencil) :fcp (sd_empty_cplan)
               :fea (array/int 0 0) :feb (array/int 0 0)})]
    {:k k :fc fc :pinned pinned :csv csv :sp sp}))
(defn sd_fv_apply :context value
  [(plane : (array float))
   (ctx : {:k int :fc (array int) :pinned (array int) :csv (array float)
           :sp {:n int :src (array int) :opf (array int) :fedges int
                :fst {:offsets (array int) :sources (array int) :weights (array float)}
                :fcp {:pk (array int) :ck (array int) :pa (array int) :pb (array int) :ca (array int) :cb (array int)
                      :factor (array float) :ef (array float)}
                :fea (array int) :feb (array int)}})
   (tp : {:ea (array int) :eb (array int) :po (array int) :pv (array int) :nv (array int) :points int :edges int})
   (plan : {:st {:offsets (array int) :sources (array int) :weights (array float)}
            :cp {:pk (array int) :ck (array int) :pa (array int) :pb (array int) :ca (array int) :cb (array int)
                 :factor (array float) :ef (array float)}
            :om {:vk (array int) :va (array int) :vb (array int) :vprim (array int)}
            :vpo (array int)})
   (scheme : int)]
  (cond
    (int/eq ctx.k 0) (sd_fv_cont plane ctx.fc ctx.pinned plan.st plan.cp tp.ea tp.eb tp.points tp.edges scheme plan.vpo)
    (int/eq ctx.k 1) (sd_linear plane tp.po plan.om)
    (int/eq ctx.k 2) (sd_isolated plane tp.po tp.pv tp.nv ctx.csv plan.om)
    :else (sd_split_plane plane ctx.sp scheme)))
; A vertex attribute: face-varying refinement unless the interpolation is All (or Bilinear), which is linear.
(defn sd_vplane :context value
  [(plane : (array float)) (ctx : {:k int :fc (array int) :pinned (array int) :csv (array float)
           :sp {:n int :src (array int) :opf (array int) :fedges int
                :fst {:offsets (array int) :sources (array int) :weights (array float)}
                :fcp {:pk (array int) :ck (array int) :pa (array int) :pb (array int) :ca (array int) :cb (array int)
                      :factor (array float) :ef (array float)}
                :fea (array int) :feb (array int)}})
   (tp : {:ea (array int) :eb (array int) :po (array int) :pv (array int) :nv (array int) :points int :edges int})
   (plan : {:st {:offsets (array int) :sources (array int) :weights (array float)}
            :cp {:pk (array int) :ck (array int) :pa (array int) :pb (array int) :ca (array int) :cb (array int)
                 :factor (array float) :ef (array float)}
            :om {:vk (array int) :va (array int) :vb (array int) :vprim (array int)}
            :vpo (array int)})
   (scheme : int) (mode : int)]
  (if (or (int/eq mode 5) (int/eq scheme 2))
    (sd_linear plane tp.po plan.om)
    (sd_fv_apply plane ctx tp plan scheme)))
(defn sd_attr_v :context sop
  [(acc : geometry) (source : geometry) (name : text) (kind : text)
   (tp : {:vp (array int) :po (array int) :nv (array int) :pv (array int) :eov (array int) :opp (array int)
          :ea (array int) :eb (array int) :pvo (array int) :pvx (array int) :bc (array int)
          :points int :edges int :vertices int :prims int})
   (plan : {:st {:offsets (array int) :sources (array int) :weights (array float)}
            :cp {:sharp (array float) :pk (array int) :ck (array int) :pa (array int) :pb (array int) :ca (array int)
                 :cb (array int) :factor (array float) :ef (array float)}
            :cw (array float)
            :om {:vk (array int) :va (array int) :vb (array int) :vprim (array int)}
            :vpo (array int)})
   (scheme : int) (bmode : int) (tri : int) (method : int) (mode : int) (ecrease : int)]
  (let* [z (array/float tp.vertices)]
    (cond
      (equal? name "creaseweight") acc
      (equal? kind "float")
        (let* [p (sop/attr source name :owner "vertex" :type float)
               ctx (sd_fv_ctx p z z z tp plan scheme bmode tri method mode ecrease)]
          (sop/with_attr acc name (sd_vplane p ctx tp plan scheme mode) :owner "vertex" :type float))
      (equal? kind "vec2")
        (let* [v (sop/attr source name :owner "vertex" :type vec2)
               x (sd_xs2 v) y (sd_ys2 v)
               ctx (sd_fv_ctx x y z z tp plan scheme bmode tri method mode ecrease)]
          (sop/with_attr acc name
            (sd_join2 (sd_vplane x ctx tp plan scheme mode) (sd_vplane y ctx tp plan scheme mode))
            :owner "vertex" :type vec2))
      (equal? kind "vec3")
        (let* [v (sop/attr source name :owner "vertex" :type vec3)
               x (sd_xs v) y (sd_ys v) w (sd_zs v)
               ctx (sd_fv_ctx x y w z tp plan scheme bmode tri method mode ecrease)]
          (sop/with_attr acc name
            (sd_join3 (sd_vplane x ctx tp plan scheme mode) (sd_vplane y ctx tp plan scheme mode)
                      (sd_vplane w ctx tp plan scheme mode))
            :owner "vertex" :type vec3))
      (equal? kind "vec4")
        (let* [v (sop/attr source name :owner "vertex" :type vec4)
               x (sd_xs4 v) y (sd_ys4 v) w (sd_zs4 v) u (sd_ws4 v)
               ctx (sd_fv_ctx x y w u tp plan scheme bmode tri method mode ecrease)]
          (sop/with_attr acc name
            (sd_join4 (sd_vplane x ctx tp plan scheme mode) (sd_vplane y ctx tp plan scheme mode)
                      (sd_vplane w ctx tp plan scheme mode) (sd_vplane u ctx tp plan scheme mode))
            :owner "vertex" :type vec4))
      :else acc)))

; ---- validation (native Subdivide.validate): the first failing check as a code, 0 when the mesh is valid ----
(defn sd_reason :context value [(code : int)]
  (cond (int/eq code 1) "input must contain polygon geometry"
        (int/eq code 2) "only polygon primitives are supported"
        (int/eq code 3) "polygons must contain at least three vertices"
        (int/eq code 4) "Loop subdivision requires triangle polygons"
        (int/eq code 5) "a polygon contains a zero-length topology edge"
        (int/eq code 6) "a polygon references the same point more than once"
        (int/eq code 7) "positions must be finite"
        (int/eq code 8) "non-manifold edges are not supported"
        (int/eq code 9) "a boundary vertex does not have exactly two boundary edges"
        (int/eq code 10) "a vertex has non-manifold polygon incidence"
        (int/eq code 11) "a vertex has disconnected polygon fans"
        :else "creaseweight and cornerweight attributes must be float, finite and non-negative"))
(defn sd_fail :context value [(code : int)]
  (error "invalid_topology" "subdivide could not produce valid geometry"
    :cause (str "subdivide [invalid_topology]: Rdk_mesh.Subdivide.subdivide: " (sd_reason code))))
(defn sd_check :context value
  [(tp : {:vp (array int) :po (array int) :pov (array int) :nv (array int) :pv (array int) :opp (array int) :eov (array int) :peo (array int)
          :pvo (array int) :bc (array int) :points int :edges int :vertices int :prims int})
   (kinds : (array int)) (pos : (array vec3)) (scheme : int) (abad : int)]
  (let* [vr (array/range tp.vertices :type int)
         pr (array/range tp.prims :type int)
         sizes (exact (map (fn [(f : int)] (int/sub (array/nth tp.po (int/add f 1)) (array/nth tp.po f))) pr))]
    (cond
      (or (int/eq tp.points 0) (int/eq tp.prims 0)) 1
      (int/gt (array/sum kinds) 0) 2
      (int/lt (array/min sizes) 3) 3
      (and (int/eq scheme 1) (int/gt (array/max sizes) 3)) 4
      (int/gt (array/sum (exact (map (fn [(v : int)]
        (if (int/eq (array/nth tp.vp v) (array/nth tp.vp (array/nth tp.nv v))) 1 0)) vr))) 0) 5
      (int/gt (let* [keys (exact (map (fn [(v : int)] (int/add (int/mul (array/nth tp.vp v) tp.prims) (array/nth tp.pov v))) vr))
                     order (array/grade keys)]
                (array/sum (exact (map (fn [(i : int)]
                  (if (int/eq (array/nth keys (array/nth order i)) (array/nth keys (array/nth order (int/add i 1)))) 1 0))
                  (array/range (int/sub tp.vertices 1) :type int))))) 0) 6
      (int/gt (array/sum (exact (map (fn [(q : vec3)]
        (if (and (= (- q.x q.x) 0.0) (and (= (- q.y q.y) 0.0) (= (- q.z q.z) 0.0))) 0 1)) pos))) 0) 7
      (int/gt (array/max (array/scatter_add (exact (map (fn [(e : int)] (if (int/ge e 0) e tp.edges)) tp.eov))
                           (array/int tp.vertices 1) (int/add tp.edges 1))) 2) 8
      (int/gt (array/sum (exact (map (fn [(c : int)] (if (or (int/eq c 0) (int/eq c 2)) 0 1)) tp.bc))) 0) 9
      (int/gt (array/sum (exact (map (fn [(p : int)]
        (let* [n (int/sub (array/nth tp.peo (int/add p 1)) (array/nth tp.peo p))
               f (int/sub (array/nth tp.pvo (int/add p 1)) (array/nth tp.pvo p))]
          (if (int/eq (array/nth tp.bc p) 0) (if (int/eq n f) 0 1) (if (int/eq n (int/add f 1)) 0 1))))
        (array/range tp.points :type int)))) 0) 10
      (int/gt (array/max (array/scatter_add tp.vp
         (let* [e1 (exact (map (fn [(c : int)] (sd_nb1 tp.vp tp.nv tp.opp c)) vr))
                e2 (exact (map (fn [(c : int)] (sd_nb2 tp.vp tp.nv tp.pv tp.opp c)) vr))
                label (sd_labels e1 e2 tp.vertices)]
           (exact (map (fn [(c : int) (l : int)] (if (int/eq c l) 1 0)) vr label)))
         (int/add tp.points 1))) 1) 11
      (int/gt abad 0) 12
      :else 0)))

(defmacro sd_pass [src scheme bmode tri method ov genres rm final rname mode]
  `(let* [sdp_tp# (sd_tables ~src)
          sdp_topo# (sop/topology ~src)
          sdp_code# (sd_check sdp_tp# sdp_topo#.kinds (sop/attr ~src "P") ~scheme (sd_attr_bad ~src))]
     (cond
       (int/gt sdp_code# 0) (sd_fail sdp_code#)
       :else
       (let* [sdp_vis# (sd_visible ~src ~rm sdp_tp#.prims)
              sdp_unit# (sd_units sdp_tp#.pov sdp_vis# ~scheme sdp_tp#.vertices sdp_tp#.prims)
              sdp_plan# (sd_plan ~src sdp_tp# sdp_unit# ~scheme ~bmode ~tri ~method ~ov)
              sdp_om# (sd_omap sdp_tp# sdp_unit# ~scheme)
              sdp_pe# (sop/attr_entries ~src :owner "point")
              sdp_ve# (sop/attr_entries ~src :owner "vertex")
              sdp_pn# (sop/group_names ~src "*" :owner "point")
              sdp_vn# (sop/group_names ~src "*" :owner "vertex")
              sdp_fn# (sop/group_names ~src "*" :owner "primitive")
              sdp_0# (sd_stage ~src sdp_tp# sdp_plan# ~scheme ~ov ~genres ~final ~rname)
              sdp_1# (fold [sdp_a# sdp_0#] [sdp_i# (array/range (array/count sdp_pe#.name) :type int)]
                       (sd_attr_p sdp_a# ~src (array/nth sdp_pe#.name sdp_i#) (array/nth sdp_pe#.type sdp_i#)
                         sdp_tp# sdp_plan# ~scheme))
              sdp_2# (fold [sdp_b# sdp_1#] [sdp_j# (array/range (array/count sdp_ve#.name) :type int)]
                       (sd_attr_v sdp_b# ~src (array/nth sdp_ve#.name sdp_j#) (array/nth sdp_ve#.type sdp_j#)
                         sdp_tp# sdp_plan# ~scheme ~bmode ~tri ~method ~mode
                         (if (or (>= ~ov 0.0) (or (sop/has_attr ~src "creaseweight" :owner "vertex") (sop/has_attr ~src "creaseweight" :owner "primitive"))) 1 0)))
              sdp_3# (fold [sdp_c# sdp_2#] [sdp_k# (array/range (array/count sdp_pn#) :type int)]
                       (sd_group_p sdp_c# ~src (array/nth sdp_pn# sdp_k#) sdp_tp# ~scheme))
              sdp_4# (fold [sdp_d# sdp_3#] [sdp_l# (array/range (array/count sdp_vn#) :type int)]
                       (sd_group_v sdp_d# ~src (array/nth sdp_vn# sdp_l#) sdp_tp# sdp_om#))]
         (fold [sdp_e# sdp_4#] [sdp_m# (array/range (array/count sdp_fn#) :type int)]
           (sd_group_f sdp_e# ~src (array/nth sdp_fn# sdp_m#) sdp_om#))))))

; The native sop/subdivide_cracks kind: the partial-group crack path, and polygon-curve meshes.
(defn sd_delegate :context sop
  [(geo : geometry) (cr : geometry) (has_cr : bool) (group : text) (scheme : text) (iterations : int) (cracks : text)
   (crack_bias : float) (consistent_topology : bool) (crease_group : text) (crease_weight_mode : text)
   (crease_weight : float) (generate_resulting_creases : bool) (resulting_crease_group : text) (hole_group : text)
   (remove_holes : bool) (boundary_interpolation : text) (face_varying_interpolation : text)
   (triangle_policy : text) (creasing_method : text) (treat_curves_as_independent : bool)
   (recompute_point_normals : bool)]
  (if has_cr
    (sop/subdivide_cracks geo cr :group group :scheme scheme :iterations iterations :cracks cracks
      :crack_bias crack_bias :consistent_topology consistent_topology :crease_group crease_group
      :crease_weight_mode crease_weight_mode :crease_weight crease_weight
      :generate_resulting_creases generate_resulting_creases :resulting_crease_group resulting_crease_group
      :hole_group hole_group :remove_holes remove_holes :boundary_interpolation boundary_interpolation
      :face_varying_interpolation face_varying_interpolation :triangle_policy triangle_policy
      :creasing_method creasing_method :treat_curves_as_independent treat_curves_as_independent
      :recompute_point_normals recompute_point_normals)
    (sop/subdivide_cracks geo :group group :scheme scheme :iterations iterations :cracks cracks
      :crack_bias crack_bias :consistent_topology consistent_topology :crease_group crease_group
      :crease_weight_mode crease_weight_mode :crease_weight crease_weight
      :generate_resulting_creases generate_resulting_creases :resulting_crease_group resulting_crease_group
      :hole_group hole_group :remove_holes remove_holes :boundary_interpolation boundary_interpolation
      :face_varying_interpolation face_varying_interpolation :triangle_policy triangle_policy
      :creasing_method creasing_method :treat_curves_as_independent treat_curves_as_independent
      :recompute_point_normals recompute_point_normals)))
(defnode sop/subdivide :label "Subdivide" :category ["Topology"]
  :validate (and (and (int/ge iterations 1) (and (>= crack_bias 0.0) (<= crack_bias 1.0)))
                 (and (and (= (- crease_weight crease_weight) 0.0) (>= crease_weight 0.0))
                      (or generate_resulting_creases (text/blank? (text/trim resulting_crease_group)))))
  :code "E_PARAM" :message "sop/subdivide: invalid parameters"
  [(input : geometry)
   (creases : geometry :required false)
   (group : text "" :label "Primitive group")
   (scheme : text "Catmull-Clark" :label "Scheme" :choices ["Catmull-Clark" "Loop" "Bilinear"])
   (iterations : int 1 :label "Depth" :min 1 :max 6 :hard_min 1)
   (cracks : text "Do not close" :label "Close cracks" :choices ["Do not close" "Pull, no edge division" "Pull, divide edges" "Pull, triangulate" "Stitch, no edge division" "Stitch, divide edges" "Stitch, triangulate"])
   (crack_bias : float 0.5 :label "Pull bias" :folder ["Cracks"] :min 0 :max 1)
   (consistent_topology : bool false :label "Consistent topology" :folder ["Cracks"])
   (crease_group : text "" :label "Crease group" :folder ["Creases"])
   (crease_weight_mode : text "Explicit" :label "Crease weight mode" :folder ["Creases"] :choices ["Explicit" "Auto"])
   (crease_weight : float 1.0 :label "Crease weight" :folder ["Creases"] :min 0 :max 10 :hard_min 0)
   (generate_resulting_creases : bool false :label "Generate resulting creases" :folder ["Creases"])
   (resulting_crease_group : text "" :label "Resulting crease group" :folder ["Creases"])
   (hole_group : text "subdivision_hole" :label "Hole group" :folder ["Holes"])
   (remove_holes : bool false :label "Remove holes" :folder ["Holes"])
   (boundary_interpolation : text "Edge and corner" :label "Point boundaries" :folder ["Interpolation"] :choices ["None" "Edge only" "Edge and corner"])
   (face_varying_interpolation : text "Boundaries" :label "Vertex boundaries" :folder ["Interpolation"] :choices ["None" "Corners only" "Corners plus 1" "Corners plus 2" "Boundaries" "All"])
   (triangle_policy : text "Catmull-Clark" :label "Triangles" :folder ["Interpolation"] :choices ["Catmull-Clark" "Smooth"])
   (creasing_method : text "Uniform" :label "Creasing method" :folder ["Creases"] :choices ["Uniform" "Chaikin"])
   (treat_curves_as_independent : bool false :label "Treat curves independently")
   (recompute_point_normals : bool false :label "Recompute point normals")]
  (let* [scheme_p (cond (equal? scheme "Catmull-Clark") 0 (equal? scheme "Loop") 1 :else 2)
         bmode_p (cond (equal? boundary_interpolation "None") 0 (equal? boundary_interpolation "Edge only") 1 :else 2)
         tri_p (if (equal? triangle_policy "Smooth") 1 0)
         fvmode_p (cond (equal? face_varying_interpolation "None") 0 (equal? face_varying_interpolation "Corners only") 1 (equal? face_varying_interpolation "Corners plus 1") 2 (equal? face_varying_interpolation "Corners plus 2") 3 (equal? face_varying_interpolation "Boundaries") 4 :else 5)
         method_p (if (equal? creasing_method "Chaikin") 1 0)
         scheme_i (sd_osd_scheme input scheme_p)
         bmode (sd_osd input "osd_vtxboundaryinterpolation" bmode_p 2)
         fvmode (sd_osd input "osd_fvarlinearinterpolation" fvmode_p 5)
         method (sd_osd input "osd_creasingmethod" method_p 1)
         tri (sd_osd input "osd_trianglesubdiv" tri_p 1)
         osd_bad (or (or (int/lt scheme_i 0) (int/lt bmode 0)) (or (int/lt fvmode 0) (or (int/lt method 0) (int/lt tri 0))))
         explicit (equal? crease_weight_mode "Explicit")
         has_creases (not (equal? creases nil))
         sel_name (text/trim group)
         has_sel (not (text/blank? sel_name))
         sel_found (fold [found false] [probe (sop/group_names input "*" :owner "primitive")] (or found (equal? probe sel_name)))
         csel_name (text/trim crease_group)
         csel_blank (text/blank? csel_name)
         has_csel (and has_creases (not csel_blank))
         csel_found (if has_csel
                      (fold [found false] [probe (sop/group_names creases "*" :owner "primitive")] (or found (equal? probe csel_name)))
                      true)
         hole_name (text/trim hole_group)
         has_hole (not (text/blank? hole_name))
         hole_found (fold [found false] [probe (sop/group_names input "*" :owner "primitive")] (or found (equal? probe hole_name)))
         rname (text/trim resulting_crease_group)
         rlit (fold [l ""] [probe (array/text 1 (if (text/blank? rname) "x" rname))] (text/glob_literal probe))
         has_rname (not (text/blank? rname))
         topo (sop/topology input)
         kinds topo.kinds
         had_n (sop/has_attr input "N" :owner "point")]
    (cond
      (and (not has_creases) (not csel_blank))
        (error "invalid_argument" "sop/subdivide: crease group requires a crease input")
      (and has_sel (not sel_found))
        (error "missing_group" (str "subdivide could not find primitive group " (text/repr sel_name)))
      (not csel_found)
        (error "missing_group" (str "subdivide could not find crease primitive group " (text/repr csel_name)))
      (and has_hole (not hole_found))
        (error "missing_group" (str "subdivide could not find hole primitive group " (text/repr hole_name)))
      osd_bad
        (error "invalid_topology" "subdivide could not produce valid geometry"
          :cause (str "subdivide [invalid_topology]: Rdk_mesh.Subdivide.subdivide: invalid detail attribute "
                      (cond (int/lt scheme_i 0) "osd_scheme" (int/lt bmode 0) "osd_vtxboundaryinterpolation"
                            (int/lt fvmode 0) "osd_fvarlinearinterpolation" (int/lt method 0) "osd_creasingmethod"
                            :else "osd_trianglesubdiv")))
      (int/gt (array/sum kinds) 0)
        (sd_delegate input creases has_creases group scheme iterations cracks crack_bias consistent_topology crease_group crease_weight_mode crease_weight generate_resulting_creases resulting_crease_group hole_group remove_holes boundary_interpolation face_varying_interpolation triangle_policy creasing_method treat_curves_as_independent recompute_point_normals)
      :else
      (let* [p0 (if has_creases (sd_cinput input creases csel_name has_csel (if explicit crease_weight -1.0)) input)
             p1 (if has_hole (sd_copy_hole p0 hole_name) p0)
             p2 (if (and (int/eq bmode 0) (not (int/eq scheme_i 2))) (sd_bholes p1) p1)
             p3 (if (and has_rname (int/ge iterations 1)) (sop/with_group (sop/delete_group p2 rlit :owner "edge") (array/int (sop/count p2 :edges) 0) :name rname :owner "edge") p2)
             prims (sop/count input :primitives)
             smask (if has_sel (sop/group input :name sel_name :owner "primitive") (array/int prims 1))
             hmask (if (and remove_holes (sd_has_hole p3)) (sop/group p3 :name "subdivision_hole" :owner "primitive") (array/int prims 0))
             card (array/sum (exact (map (fn [(s : int) (h : int)] (if (or (int/eq s 1) (int/eq h 1)) 1 0)) smask hmask)))]
        (cond
          (and has_sel (int/eq card 0)) input
          (and has_sel (int/lt card prims)) (sd_delegate input creases has_creases group scheme iterations cracks crack_bias consistent_topology crease_group crease_weight_mode crease_weight generate_resulting_creases resulting_crease_group hole_group remove_holes boundary_interpolation face_varying_interpolation triangle_policy creasing_method treat_curves_as_independent recompute_point_normals)
          :else
          (let* [result (fold [acc p3] [i (array/range iterations :type int)]
            (sd_pass acc scheme_i bmode tri method
              (if (and (and explicit (not has_creases)) (int/eq i 0)) crease_weight -1.0)
              (or generate_resulting_creases (int/lt i (int/sub iterations 1)))
              (and remove_holes (int/eq i (int/sub iterations 1)))
              (int/eq i (int/sub iterations 1))
              rname fvmode))]
            (if (and recompute_point_normals had_n) (sop/normals result :owner "Point" :weighting "Face area") result)))))))
