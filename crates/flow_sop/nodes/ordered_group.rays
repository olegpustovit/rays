; Whole Group Ordered draft. Uses text/tokens (split on space, comma, tab and newline, dropping
; empty tokens) and text/to_int, a total reader returning {:value :valid} for a trimmed decimal token.
(defn ordered_group_error :context value [(reason : text)]
  (error "ordered_group_failed" "ordered_group could not produce valid geometry" :cause reason))
(defn ordered_group_index :context value [(token : text)]
  (let* [parsed (text/to_int token)]
    (if parsed.valid parsed.value (error "E_PARAM" (str "sop/ordered_group: expected integer, got " (text/repr token))))))
(defn ordered_group_normalize :context value [(raw : text)]
  (fold [out ""] [token (text/tokens raw)]
    (let* [element (ordered_group_index token)]
      (if (int/lt element 0) (error "E_PARAM" (str "sop/ordered_group: expected a non-negative element index, got " element))
        (if (equal? out "") (str element) (str out " " element))))))
(defnode sop/ordered_group :label "Group Ordered" :category ["Group" "Create"]
  [(in0 : geometry)
   (owner : text "Points" :label "Group type" :choices ["Points" "Vertices" "Primitives"])
   (name : text "ordered" :label "Output group")
   (elements : text "0" :label "Elements in order" :kind encoded :normalize ordered_group_normalize)]
  (let* [selected (case owner "Vertices" "vertex" "Primitives" "primitive" :else "point")
         length (case owner "Vertices" (sop/count in0 :vertices) "Primitives" (sop/count in0 :primitives)
                  :else (sop/count in0 :points))
         indices (map (fn [(token : text)] (ordered_group_index token)) (text/tokens elements))
         counts (array/scatter_add indices (array/int (array/count indices) 1) length)]
    (cond
      (text/blank? name) (ordered_group_error "Group: empty name")
      (int/gt (array/max (array/concat (array/int 1 -1) indices)) (int/sub length 1))
        (ordered_group_error "Group.ordered: element index out of bounds")
      (int/gt (array/max (array/concat (array/int 1 0) counts)) 1)
        (ordered_group_error "Group.ordered: duplicate element index")
      :else (sop/with_group in0 (exact counts) :name name :owner selected :order (exact indices)))))
