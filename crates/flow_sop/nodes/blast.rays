; Whole-node draft of Blast: deletes the elements of a group (or everything else) and
; carries the survivors through sop/remap. Uses edge_ancestry and int_gather from the prelude.
(defnode sop/blast :label "Blast" :category ["Topology" "Delete"]
  [(in0 : geometry)
   (owner : text "Primitives" :label "Group type" :choices ["Points" "Vertices" "Primitives"])
   (group : text "group" :label "Group")
   (selected : bool true :label "Delete selected")
   (compact_points : bool false :label "Remove unused points")
   (policy : text "Destroy touched primitives" :label "Point deletion policy"
     :choices ["Destroy touched primitives" "Heal primitives"])]
  (let* [kind (case owner "Points" "point" "Vertices" "vertex" :else "primitive")
         found (fold [found false] [name (sop/group_names in0 "" :owner kind)]
                 (or found (equal? name group)))]
    (if (not found)
      (error "missing_group" (str "blast could not find " kind " group " (text/repr group)))
      (blast_apply in0 owner kind (sop/group in0 :name group :owner kind) selected compact_points policy))))
