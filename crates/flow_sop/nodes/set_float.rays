(workspace set_float_node
(defnode sop/set_float :label "Set Float" :category ["Attribute" "Set"]
  :validate (not (text/blank? name)) :code "E_PARAM" :message "sop/set_float: empty name"
  [(in0 : geometry)
   (owner : text "Point" :label "Owner" :choices ["Point" "Vertex" "Primitive" "Detail"])
   (name : text "value" :label "Attribute"
     :validate (not (and (equal? owner "Point") (equal? name "P")))
     :code "E_PARAM" :message "sop/set_float: cannot replace canonical P")
   (value : float 0.0 :label "Value" :min -10 :max 10)]
  (setter_constant in0 owner name float array/float value))
)
