; Whole-node draft. One centroid point per piece: the whole detail, each primitive, a point piece (points
; sharing a value of an int or text point attribute) or a primitive piece (the unique points of primitives
; sharing a value). Methods: point mass, bounding box, convex hull (one sop/convex_hull per piece, then the
; native fan / tetrahedron accumulation). Members of a piece are listed in native order and reduced by
; segment operations; arithmetic keeps the native order and its arm64 multiply-add fusion.
(defn ec_error :context value [(reason : text)]
  (error "invalid_geometry" "extract_centroid could not produce valid geometry"
    :cause (str "extract_centroid [invalid_geometry]: " reason)))
(defn ec_plan :context value
  [(ok : bool) (reason : text) (mp : (array int)) (mq : (array int)) (offsets : (array int)) (count : int)
   (reps : (array int))]
  {:ok ok :reason reason :mp mp :mq mq :offsets offsets :count count :reps reps})
; Dense ids by first appearance from first = array/index_of keys keys.
(defn ec_classify :context value [(first : (array int))]
  (let* [n (array/count first)
         is_first (exact (map (fn [(i : int) (f : int)] (if (int/eq i f) 1 0)) (array/range n :type int) first))
         offs (array/scan_sum is_first)]
    {:ids (exact (map (fn [(f : int)] (array/nth offs f)) first))
     :count (array/sum is_first)
     :reps (array/compact is_first)}))
(defn ec_first :context sop [(geo : geometry) (owner : text) (name : text) (kind : text)]
  (if (equal? kind "int")
    (let* [v (sop/attr geo name :owner owner :type int)] (array/index_of v v))
    (let* [v (sop/attr geo name :owner owner :type text)] (array/index_of v v))))
; Members grouped by piece id with ascending member order inside a piece.
(defn ec_grouped_points :context value [(ids : (array int)) (count : int)]
  (let* [order (array/grade ids)
         sizes (array/scatter_add ids (array/int (array/count ids) 1) count)]
    (ec_plan true "" order (int_gather ids order) (array/scan_sum sizes) count (array/int 0))))
; Primitive pieces: unique (piece, point) pairs ordered by piece then point.
(defn ec_grouped_primitives :context sop [(geo : geometry) (ids : (array int)) (count : int)]
  (let* [topo (sop/topology geo)
         adjacency (sop/adjacency geo)
         points (sop/count geo :points)]
    (if (int/gt points (int/div 4611686018427387903 (if (int/gt count 0) count 1)))
      (ec_plan false "piece/point incidence key exceeds integer limits" (array/int 0) (array/int 0) (array/int 0) 0 (array/int 0))
      (let* [piece_of_vertex (exact (map (fn [(p : int)] (array/nth ids p)) adjacency.primitive_of_vertex))
             keys (exact (map (fn [(q : int) (p : int)] (int/add (int/mul q points) p)) piece_of_vertex topo.vertex_points))
             order (array/grade keys)
             sorted (int_gather keys order)
             n (array/count sorted)
             unique (exact (map (fn [(i : int) (k : int)]
               (if (int/eq i 0) 1 (if (int/eq k (array/nth sorted (int/sub i 1))) 0 1)))
               (array/range n :type int) sorted))
             kept (array/compact unique)
             uniq (int_gather sorted kept)
             mq (exact (map (fn [(k : int)] (int/div k points)) uniq))
             mp (exact (map (fn [(k : int)] (int/mod k points)) uniq))
             sizes (array/scatter_add mq (array/int (array/count mq) 1) count)]
        (ec_plan true "" mp mq (array/scan_sum sizes) count (array/int 0))))))
(defn ec_absmax :context value [(p : vec3)] (max (abs p.x) (max (abs p.y) (abs p.z))))
(defn ec_vec3 :context value [(x : (array float)) (y : (array float)) (z : (array float))]
  (exact (map (fn [(a : float) (b : float) (c : float)] [a b c]) x y z)))
; Point mass of one list of points.
(defn ec_mass_list :context value [(pts : (array vec3))]
  (let* [scale (array/max (array/concat (array/float 1 0.0) (exact (map ec_absmax pts))))
         n (float (array/count pts))
         total (fold [s [0.0 0.0 0.0]] [p pts] [(+ s.x (/ p.x scale)) (+ s.y (/ p.y scale)) (+ s.z (/ p.z scale))])
         factor (/ scale n)]
    (if (= scale 0.0) [0.0 0.0 0.0] [(* total.x factor) (* total.y factor) (* total.z factor)])))
; Point mass of every piece.
(defn ec_mass :context value [(mpos : (array vec3)) (mq : (array int)) (offsets : (array int)) (count : int)]
  (let* [scale (array/segment_max (exact (map ec_absmax mpos)) offsets)
         sx (array/segment_sum (exact (map (fn [(p : vec3) (q : int)] (/ p.x (array/nth scale q))) mpos mq)) offsets)
         sy (array/segment_sum (exact (map (fn [(p : vec3) (q : int)] (/ p.y (array/nth scale q))) mpos mq)) offsets)
         sz (array/segment_sum (exact (map (fn [(p : vec3) (q : int)] (/ p.z (array/nth scale q))) mpos mq)) offsets)
         sizes (exact (map (fn [(a : int) (b : int)] (int/sub b a)) (array/slice offsets 0 count) (array/slice offsets 1 count)))
         factor (exact (map (fn [(s : float) (n : int)] (/ s (float n))) scale sizes))]
    (ec_vec3 (exact (map (fn [(a : float) (f : float)] (* a f)) sx factor))
             (exact (map (fn [(a : float) (f : float)] (* a f)) sy factor))
             (exact (map (fn [(a : float) (f : float)] (* a f)) sz factor)))))
; Bounding-box centre of every piece.
(defn ec_bounds :context value [(mpos : (array vec3)) (offsets : (array int))]
  (let* [lo (array/segment_min mpos offsets)
         hi (array/segment_max mpos offsets)]
    (exact (map (fn [(a : vec3) (b : vec3)]
      [(+ (* a.x 0.5) (* b.x 0.5)) (+ (* a.y 0.5) (* b.y 0.5)) (+ (* a.z 0.5) (* b.z 0.5))]) lo hi))))
; Hull of one coplanar polygon: area-weighted fan from its first corner. Each stage is its own kernel.
(defn ec_corner :context value [(hp : (array vec3)) (vp : (array int)) (index : int) (o : vec3) (scale : float)]
  (/ (- (array/nth hp (array/nth vp index)) o) scale))
(defn ec_hull_polygon :context value [(hp : (array vec3)) (vp : (array int)) (first : int) (last : int)]
  (let* [scale (array/max (exact (map ec_absmax hp)))
         fallback (ec_mass_list (exact (map (fn [(i : int)] (array/nth hp i)) (array/slice vp first (int/sub last first)))))
         a (ec_corner hp vp first [0.0 0.0 0.0] scale)
         triangles (if (int/gt (int/sub last first) 2) (int/sub (int/sub last first) 2) 0)
         ks (array/range triangles :type int)
         bs (exact (map (fn [(k : int)] (ec_corner hp vp (int/add first (int/add k 1)) [0.0 0.0 0.0] scale)) ks))
         cs (exact (map (fn [(k : int)] (ec_corner hp vp (int/add first (int/add k 2)) [0.0 0.0 0.0] scale)) ks))
         terms (exact (map (fn [(b : vec3) (c : vec3)]
                 (let* [u (- b a)
                        v (- c a)
                        nx (fma (* -1.0 u.z) v.y (* u.y v.z))
                        ny (fma (* -1.0 u.x) v.z (* u.z v.x))
                        nz (fma (* -1.0 u.y) v.x (* u.x v.y))]
                   [(sqrt (fma nz nz (fma ny ny (* nx nx))))
                    (/ (+ (+ a.x b.x) c.x) 3.0) (/ (+ (+ a.y b.y) c.y) 3.0) (/ (+ (+ a.z b.z) c.z) 3.0)]))
                 bs cs))
         total (fold [s [0.0 0.0 0.0 0.0]] [term terms]
                 [(+ s.x term.x) (fma term.x term.y s.y) (fma term.x term.z s.z) (fma term.x term.w s.w)])]
    (cond (= scale 0.0) [0.0 0.0 0.0]
          (= total.x 0.0) fallback
          :else [(/ (* scale total.y) total.x) (/ (* scale total.z) total.x) (/ (* scale total.w) total.x)])))
; Hull of a solid: signed tetrahedra from the first hull point.
(defn ec_hull_solid :context value [(hp : (array vec3)) (vp : (array int)) (offsets : (array int)) (prims : int)]
  (let* [o (array/nth hp 0)
         fallback (ec_mass_list hp)
         scale (array/max (exact (map (fn [(p : vec3)] (ec_absmax (- p o))) hp)))
         ks (array/range prims :type int)
         as (exact (map (fn [(k : int)] (ec_corner hp vp (array/nth offsets k) o scale)) ks))
         bs (exact (map (fn [(k : int)] (ec_corner hp vp (int/add (array/nth offsets k) 1) o scale)) ks))
         cs (exact (map (fn [(k : int)] (ec_corner hp vp (int/add (array/nth offsets k) 2) o scale)) ks))
         terms (exact (map (fn [(a : vec3) (b : vec3) (c : vec3)]
                 (let* [t1 (fma (* -1.0 b.z) c.y (* b.y c.z))
                        t2 (fma (* -1.0 b.x) c.z (* b.z c.x))
                        t3 (fma (* -1.0 b.y) c.x (* b.x c.y))]
                   [(fma a.z t3 (fma a.y t2 (* a.x t1)))
                    (+ (+ a.x b.x) c.x) (+ (+ a.y b.y) c.y) (+ (+ a.z b.z) c.z)]))
                 as bs cs))
         total (fold [s [0.0 0.0 0.0 0.0]] [term terms]
                 [(+ s.x term.x) (fma term.x term.y s.y) (fma term.x term.z s.z) (fma term.x term.w s.w)])]
    (cond (= scale 0.0) o
          (= total.x 0.0) fallback
          :else [(+ o.x (/ (* scale total.y) (* 4.0 total.x)))
                 (+ o.y (/ (* scale total.z) (* 4.0 total.x)))
                 (+ o.z (/ (* scale total.w) (* 4.0 total.x)))])))
; Every candidate is computed unconditionally (arrays padded so indexing is safe) and one is selected, so
; no kernel sits under a branch that depends on the hull.
(defn ec_hull_center :context sop [(hull : geometry)]
  (let* [hp (sop/attr hull :P)
         topo (sop/topology hull)
         prims (sop/count hull :primitives)
         hc (array/count hp)
         pad (array/int 4 0)
         vp (array/concat topo.vertex_points pad)
         offsets (array/concat topo.primitive_offsets pad)
         kinds (array/concat topo.kinds pad)
         a (array/nth hp 0)
         b (array/nth hp (if (int/gt hc 1) 1 0))
         line [(+ (* a.x 0.5) (* b.x 0.5)) (+ (* a.y 0.5) (* b.y 0.5)) (+ (* a.z 0.5) (* b.z 0.5))]
         polygon (ec_hull_polygon hp vp (array/nth offsets 0) (if (int/gt (array/nth offsets 1) (array/nth offsets 0)) (array/nth offsets 1) (array/nth offsets 0)))
         solid (ec_hull_solid hp vp offsets prims)]
    (cond
      (int/eq hc 1) a
      (and (int/eq prims 1) (int/eq (array/nth kinds 0) 1)) line
      (int/eq prims 1) polygon
      :else solid)))
; Hull centre of piece number piece: members first..last of mp.
(defn ec_hull_piece :context sop [(positions : (array vec3)) (mp : (array int)) (offsets : (array int)) (piece : int)]
  (let* [pts (exact (map (fn [(p : int)] (array/nth positions p))
               (array/slice mp (array/nth offsets piece) (int/sub (array/nth offsets (int/add piece 1)) (array/nth offsets piece)))))
         source (sop/mesh :points pts :vertex_points (array/int 0) :primitive_offsets (array/int 1) :kinds (array/int 0))
         hull (with_error (sop/convex_hull source :preserve_point_payload false)
                (fn [failure] (assoc failure :code "invalid_geometry")))]
    (ec_hull_center hull)))
(defn ec_hull_append :context sop [(acc : geometry) (c : vec3)]
  (let* [old (sop/attr acc "__ec_c" :owner "detail" :type float_array)
         tail (exact (map (fn [(k : int)] (cond (int/eq k 0) c.x (int/eq k 1) c.y :else c.z)) (array/range 3 :type int)))
         joined (array/concat old.values tail)]
    (sop/with_attr acc "__ec_c" {:offsets (array/concat (array/int 1 0) (array/int 1 (array/count joined))) :values joined}
      :owner "detail" :type float_array)))
(defn ec_hull_read :context sop [(done : geometry) (count : int)]
  (let* [v (sop/attr done "__ec_c" :owner "detail" :type float_array)]
    (exact (map (fn [(i : int)]
      [(array/nth v.values (int/mul 3 i)) (array/nth v.values (int/add (int/mul 3 i) 1)) (array/nth v.values (int/add (int/mul 3 i) 2))])
      (array/range count :type int)))))
(defnode sop/extract_centroid :label "Extract Centroid" :category ["Create" "Point"]
  :validate (and (or (not (or (equal? run_over "Point pieces") (equal? run_over "Primitive pieces")))
                     (and (not (text/blank? piece_attribute)) (not (equal? piece_attribute "P"))))
                 (and (not (equal? source_primitive_attribute "P")) (not (equal? piece_output_attribute "P"))))
  :code "E_PARAM" :message "sop/extract_centroid: piece, source primitive and output attribute names cannot be P"
  [(in0 : geometry)
   (run_over : text "Detail" :label "Run over" :choices ["Detail" "Primitives" "Point pieces" "Primitive pieces"])
   (piece_attribute : text "piece" :label "Piece attribute")
   (method_ : text "Point mass" :label "Method" :choices ["Point mass" "Bounding box" "Convex hull"])
   (source_primitive_attribute : text "" :label "Source primitive attribute" :folder ["Output"])
   (piece_output_attribute : text "" :label "Piece output attribute" :folder ["Output"])]
  (let* [src_name (text/trim source_primitive_attribute)
         out_name (text/trim piece_output_attribute)
         points (sop/count in0 :points)
         prims (sop/count in0 :primitives)
         pieces_over (cond (equal? run_over "Point pieces") "point" (equal? run_over "Primitive pieces") "primitive" :else "")
         kind (if (text/blank? pieces_over) ""
                (if (sop/has_attr in0 piece_attribute :owner pieces_over) (sop/attr_type in0 piece_attribute :owner pieces_over) "missing"))
         usable (or (equal? kind "int") (equal? kind "text"))
         empty_plan (ec_plan false "" (array/int 0) (array/int 0) (array/int 0) 0 (array/int 0))]
    (cond
      (equal? src_name "P") (ec_error "source primitive attribute must be non-empty and cannot be P")
      (equal? out_name "P") (ec_error "piece output attribute must be non-empty and cannot be P")
      (and (not (text/blank? pieces_over)) (equal? kind "missing"))
        (ec_error (str pieces_over " piece attribute " (text/repr piece_attribute) " was not found"))
      (and (not (text/blank? pieces_over)) (not usable))
        (ec_error (str "piece attribute " (text/repr piece_attribute) " must use integer or text storage"))
      (and (equal? run_over "Detail") (int/eq points 0)) (ec_error "cannot extract a centroid from empty geometry")
      (and (equal? run_over "Primitives") (int/eq prims 0)) (ec_error "cannot extract primitive centroids without primitives")
      :else
        (let* [classes (if (text/blank? pieces_over) {:ids (array/int 0) :count 0 :reps (array/int 0)}
                         (ec_classify (ec_first in0 pieces_over piece_attribute kind)))
               plan (cond
                      (equal? run_over "Detail")
                        (ec_plan true "" (array/range points :type int) (array/int points 0)
                          (array/concat (array/int 1 0) (array/int 1 points)) 1 (array/int 0))
                      (equal? run_over "Primitives")
                        (let* [topo (sop/topology in0) adjacency (sop/adjacency in0)]
                          (ec_plan true "" topo.vertex_points adjacency.primitive_of_vertex topo.primitive_offsets prims (array/int 0)))
                      (int/eq classes.count 0)
                        (ec_plan false (if (equal? pieces_over "point") "cannot extract pieces from empty geometry"
                                         "cannot extract pieces without primitives")
                          (array/int 0) (array/int 0) (array/int 0) 0 (array/int 0))
                      (equal? pieces_over "point")
                        (let* [g (ec_grouped_points classes.ids classes.count)]
                          (ec_plan true "" g.mp g.mq g.offsets classes.count classes.reps))
                      :else
                        (let* [g (ec_grouped_primitives in0 classes.ids classes.count)]
                          (ec_plan g.ok g.reason g.mp g.mq g.offsets classes.count classes.reps)))]
          (if (not plan.ok) (ec_error plan.reason)
            (let* [positions (sop/attr in0 :P)
                   mpos (exact (map (fn [(p : int)] (array/nth positions p)) plan.mp))
                   ; Convex hull: one hull call per piece in a zone that carries only geometry; the centres
                   ; ride on the detail attribute __ec_c (x y z per piece) and are read back inside the final
                   ; one-step zone that builds the output.
                   hulled (fold [acc (sop/with_attr in0 "__ec_c" {:offsets (array/concat (array/int 1 0) (array/int 1 0)) :values (array/float 0 0.0)}
                                       :owner "detail" :type float_array)]
                            [piece (if (equal? method_ "Convex hull") (array/range plan.count :type int) (array/int 0))]
                            (ec_hull_append acc (ec_hull_piece positions plan.mp plan.offsets piece)))]
              (fold [done hulled] [step (array/int 1 0)]
              (let* [centers (cond
                             (equal? method_ "Point mass") (ec_mass mpos plan.mq plan.offsets plan.count)
                             (equal? method_ "Bounding box") (ec_bounds mpos plan.offsets)
                             :else (ec_hull_read done plan.count))
                   shell (sop/mesh :points centers :vertex_points (array/int 0) :primitive_offsets (array/int 1) :kinds (array/int 0))
                   detail_only (sop/delete_group
                     (sop/delete_attrs in0 :point "*" :vertex "*" :primitive "*") "*" :owner "any")
                   base (sop/remap detail_only shell :points (array/int plan.count -1)
                          :vertices (array/int 0) :primitives (array/int 0) :positions "target")
                   with_source (if (and (equal? run_over "Primitives") (not (text/blank? src_name)))
                                 (sop/with_attr base src_name (array/range plan.count :type int) :owner "point" :type int)
                                 base)
                   output_name (if (text/blank? out_name) piece_attribute out_name)]
              (cond
                (text/blank? pieces_over) with_source
                (equal? kind "int")
                  (let* [column (sop/attr in0 piece_attribute :owner pieces_over :type int)]
                    (sop/with_attr with_source output_name (int_gather column plan.reps) :owner "point" :type int))
                :else
                  (let* [column (sop/attr in0 piece_attribute :owner pieces_over :type text)]
                    (sop/with_attr with_source output_name
                      (exact (map (fn [(i : int)] (array/nth column i)) plan.reps)) :owner "point" :type text)))))))))))
