#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 4) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1) readonly buffer Rays { vec4 rays[]; };
struct Hit { uint hit; uint primitive; uint instance; float t; vec2 barycentrics; };
layout(set = 0, binding = 2) buffer Hits { Hit hits[]; };
layout(set = 0, binding = 3) uniform Mask { uint mask; };
// instance is the record's user id (Metal's user_instance_id), the instance custom index.
void main() {
  uint i = gl_GlobalInvocationID.x;
  rayQueryEXT q;
  rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT, mask, rays[i * 2].xyz, 0.001, rays[i * 2 + 1].xyz, 100.0);
  while (rayQueryProceedEXT(q)) {}
  bool hit = rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
  hits[i] = Hit(hit ? 1u : 0u, hit ? uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true)) : 0u,
                hit ? uint(rayQueryGetIntersectionInstanceCustomIndexEXT(q, true)) : 0u,
                hit ? rayQueryGetIntersectionTEXT(q, true) : 0.0,
                hit ? rayQueryGetIntersectionBarycentricsEXT(q, true) : vec2(0.0));
}
