#version 450
#extension GL_EXT_samplerless_texture_functions : require
// Trilinear LOD blend by hand: a compute encoder binds no sampler, Metal's kernel uses an inline one.
layout(local_size_x = 3) in;
layout(set = 0, binding = 0) uniform texture2D image;
layout(set = 0, binding = 1) buffer Result { vec4 values[]; } result;
void main() {
  uint i = gl_GlobalInvocationID.x;
  float level = float(i) * 0.5;
  result.values[i] = mix(texelFetch(image, ivec2(0), int(floor(level))),
                         texelFetch(image, ivec2(0), int(ceil(level))), fract(level));
}
