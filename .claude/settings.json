{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-raw-tests.sh\"",
            "timeout": 10,
            "statusMessage": "Checking test command uses cargo t"
          }
        ]
      }
    ]
  }
}
