; Boxes are packed pairs: [x y tile-id], [width height 0]. Each level keeps
; unsplittable leaves and expands its remaining boxes in painter order.
(workspace recursive_rectangles

  (defn scheme-hash :context value [(scheme : int)]
    (int/and (+ (int/mul (+ scheme 1) 1103515245) 12345) 4611686018427387903))

  (defn palette-color :context value [(scheme : int) (tile : int)]
    (let* [hash (-> tile
                    (int/mul 73856093)
                    (-> tile
                        (int/mul tile)
                        (int/mul 19349663)
                        (int/xor))
                    (int/and 4611686018427387903))
           seed (scheme-hash scheme)
           slot (int/mod hash 8)
           hue (/ (mod seed 360000) 1000)
           harmony (mod (int/div seed 360000) 5)
           offset (cond
                    (= harmony 0) (- (* slot 13) 46)
                    (and (= harmony 1) (< slot 4)) (- (* slot 8) 12)
                    (= harmony 1) (+ 180 (- (* (- slot 4) 8) 12))
                    (and (= harmony 2) (< slot 3)) (- (* slot 7) 7)
                    (and (= harmony 2) (< slot 6)) (+ 150 (- (* (- slot 3) 7) 7))
                    (= harmony 2) (+ 210 (- (* (- slot 6) 7) 4))
                    (= harmony 3) (+ (* (mod slot 3) 120) (* (int/div slot 3) 7))
                    :else (+ (* (mod slot 4) 90) (* (int/div slot 4) 9)))
           jitter (- (/ (mod (int/div hash 97) 900) 100) 4.5)
           saturation (+ 0.56 (/ (mod (+ (int/div seed 31) (* slot 47)) 260) 1000))
           lightness (+ 0.34 (/ (mod (+ (int/div seed 73) (* slot 83)) 330) 1000))]
      (color/hsl (+ (+ hue offset) jitter) saturation lightness)))

  (defn split-level :context value [(boxes : (array vec3)) (depth : int) (field : float)]
    (let* [raw (map (fn [i]
                      (let* [parent (int/div (int i) 4)
                             child (mod (int/div (int i) 2) 2)
                             part (mod i 2)
                             p (array/nth boxes (* parent 2))
                             s (array/nth boxes (+ (* parent 2) 1))
                             split-x (>= s.x 6)
                             split-y (>= s.y 6)
                             ratio (+ 0.14
                                      (* 0.72
                                         (noise3 [(+ (+ (* (+ p.x (* s.x 0.5)) 0.018) field) (* depth 0.37)) (+ (- (* (+ p.y (* s.y 0.5)) 0.018) field) (* depth 0.61)) 0]
                                                 :seed 451)))
                             orientation (/ (int/and (+ (int/mul (int p.z) 1103515245) 12345)
                                                     65535)
                                            65535)
                             horizontal (and split-x
                                             (or (not split-y) (> orientation 0.5)))
                             first (int (max 3
                                             (min (- (if horizontal s.x s.y) 3)
                                                  (int (* (if horizontal s.x s.y) ratio)))))]
                        (if (not (or split-x split-y))
                            (if (= child 0)
                                (if (= part 0) p s)
                                (if (= part 0) p [-1 -1 0]))
                            (if (= part 0)
                                [(if (and horizontal (= child 1)) (+ p.x first) p.x) (if (and (not horizontal) (= child 1)) (+ p.y first) p.y) (+ (* p.z 2) child)]
                                [(if horizontal (if (= child 0) first (- s.x first)) s.x) (if horizontal s.y (if (= child 0) first (- s.y first))) 0]))))
                    (array/range (* (array/count boxes) 2)))
           kept (filter (fn [i]
                          (let* [s (array/nth raw (+ (* (int i) 2) 1))] (>= s.x 0)))
                        (-> raw
                            (array/count)
                            (int/div 2)
                            (array/range)))]
      (map (fn [i]
             (array/nth raw
                        (+ (* (int (array/nth kept (int/div (int i) 2))) 2)
                           (mod i 2))))
           (array/range (* (array/count kept) 2)))))

  (graph model :context host
    (state [previous {:scheme 0 :control 0.5}]
           {:scheme (+ previous.scheme
                       (if (fold [pressed false]
                                 [event (get (frame/input) :events)]
                             (or pressed
                                 (and (equal? event.kind "pointer-pressed")
                                      (equal? event.button "left"))))
                           1
                           0))
            :control (+ previous.control
                        (* (- (/ (max 0 (min (frame/width) (pointer/x)))
                                 (max 1 (frame/width)))
                              previous.control)
                           (- 1 (exp (* -10 (max 0 (frame/dt)))))))}))

  (graph picture :context draw
    (let* [model (ref model)
           iterations (+ 4
                         (int (* (/ (max 0 (min (frame/height) (pointer/y)))
                                    (max 1 (frame/height)))
                                 12)))
           side (int (/ (max 80 (- (min (frame/width) (frame/height)) 96)) (sqrt 2)))
           boxes (fold [boxes (array/concat (array/vec3 1 [0 0 1])
                                            (array/vec3 1 [side side 0]))]
                       [depth (range iterations)]
                   (split-level boxes depth (* model.control 8)))
           indices (-> boxes
                       (array/count)
                       (int/div 2)
                       (array/range))
           positions (map (fn [i]
                            (let* [p (array/nth boxes (* (int i) 2))] [p.x p.y 0]))
                          indices)
           sizes (map (fn [i]
                        (let* [s (array/nth boxes (+ (* (int i) 2) 1))]
                          [(max 1 (- s.x 1)) (max 1 (- s.y 1)) 0]))
                      indices)
           colors (map (fn [i]
                         (let* [p (array/nth boxes (* (int i) 2))]
                           (palette-color model.scheme (int p.z))))
                       indices)]
      (-> (mod (scheme-hash model.scheme) 360000)
          (/ 1000)
          (color/hsl 0.16 0.93)
          (draw/background)
          (draw/merge (draw/translate [(int/div (frame/width) 2) (int/div (frame/height) 2) 0]
                                      (draw/rotate 0.7853981633974483
                                                   (draw/translate [(int/div (- 0 side) 2) (int/div (- 0 side) 2) 0]
                                                                   (draw/rects positions sizes :fill colors))))))))

  (graph actions :context host
    (host/quit (or (key/down "escape") (key/down "q"))))

  (graph editor :context editor
    (ui/workspace (ui/canvas (ref picture) :focus true) :effects (ref actions)))

  (graph window :context settings
    (settings/config :title "Recursive rectangles" :width 720 :height 720)))
