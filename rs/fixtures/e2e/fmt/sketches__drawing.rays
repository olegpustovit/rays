; Up to 128 strokes of 4096 packed points; each stroke feeds one line batch.
(workspace drawing

  (defn inside :context value [(p : vec3) (x : int) (y : int) (w : int) (h : int)]
    (and (and (>= p.x x) (< p.x (+ x w))) (and (>= p.y y) (< p.y (+ y h)))))

  (defn add-point :context value [(stroke : {:color int :width int :points (array vec3)}) (point : vec3)]
    (let* [n (array/count stroke.points)]
      (if (>= n 4096)
          stroke
          (if (= n 0)
              (assoc stroke :points (array/vec3 1 point))
              (let* [last (array/nth stroke.points (- n 1))
                     dx (- point.x last.x)
                     dy (- point.y last.y)]
                (if (< (+ (* dx dx) (* dy dy)) 4)
                    stroke
                    (assoc stroke
                           :points (array/concat stroke.points (array/vec3 1 point)))))))))

  (defn finish :context value [(model : {:strokes (list {:color int :width int :points (array vec3)}) :active bool :current {:color int :width int :points (array vec3)} :color int :width int :status text :save bool}) (point : vec3) (append : bool)]
    (if model.active
        (assoc model
               :strokes (take 128
                              (concat (list (if append
                                                (add-point model.current point)
                                                model.current))
                                      model.strokes))
               :active false
               :status "Drag to draw")
        model))

  (graph model :context host
    (state [previous {:strokes (list) :active false :current {:color 0 :width 10 :points (array/vec3 0)} :color 0 :width 10 :status "Drag to draw" :save false}]
           (fold [model (assoc previous :save false)]
                 [event (get (frame/input) :events)]
             (let* [p [(int event.position.x) (int event.position.y) 0]]
               (cond
                 (and (equal? event.kind "pointer-pressed")
                      (equal? event.button "left"))
                   (if (< p.y 92)
                       (let* [inactive (assoc model :active false)]
                         (cond
                           (inside p 8 8 62 34) (assoc inactive
                                                       :strokes (list)
                                                       :status "Canvas cleared")
                           (inside p 76 8 62 34) (assoc inactive
                                                        :strokes (rest model.strokes)
                                                        :status "Undid the latest stroke")
                           (inside p 144 8 62 34) (assoc inactive
                                                         :save true
                                                         :status "Saved _out/rays-drawing.png")
                           (inside p 215 8 30 34) (assoc inactive :color 0)
                           (inside p 253 8 30 34) (assoc inactive :color 1)
                           (inside p 291 8 30 34) (assoc inactive :color 2)
                           (inside p 329 8 30 34) (assoc inactive :color 3)
                           (inside p 8 50 36 34) (assoc inactive
                                                        :width (max 2 (- model.width 2)))
                           (inside p 52 50 36 34) (assoc inactive
                                                         :width (min 32 (+ model.width 2)))
                           :else inactive))
                       (assoc model
                              :active true
                              :current {:color model.color
                                        :width model.width
                                        :points (array/vec3 1 p)}
                              :status "Drawing"))
                 (equal? event.kind "pointer-moved") (if model.active
                                                         (assoc model
                                                                :current (add-point model.current p))
                                                         model)
                 (and (equal? event.kind "pointer-released")
                      (equal? event.button "left"))
                   (finish model p true)
                 (or
                     (and (equal? event.kind "pointer-cancelled")
                          (equal? event.button "left"))
                     (equal? event.kind "focus-lost"))
                   (finish model p false)
                 (equal? event.kind "key-pressed") (cond
                                                     (or (equal? event.key "c")
                                                         (equal? event.key "C"))
                                                       (assoc model
                                                              :strokes (list)
                                                              :active false
                                                              :status "Canvas cleared")
                                                     (or (equal? event.key "z")
                                                         (equal? event.key "Z"))
                                                       (assoc model
                                                              :strokes (rest model.strokes)
                                                              :active false
                                                              :status "Undid the latest stroke")
                                                     (equal? event.key "[") (assoc model
                                                                                   :width (max 2 (- model.width 2)))
                                                     (equal? event.key "]") (assoc model
                                                                                   :width (min 32 (+ model.width 2)))
                                                     (or (equal? event.key "s")
                                                         (equal? event.key "S"))
                                                       (assoc model
                                                              :save true
                                                              :status "Saved _out/rays-drawing.png")
                                                     :else model)
                 :else model)))))

  (graph picture :context draw
    (let* [model (ref model)
           palette (list "#22d3ee" "#fb7185" "#fbbf24" "#a78bfa")
           empty {:color 0 :width 10 :points (array/vec3 0)}]
      (draw/merge (draw/background "#0b1020")
                  (for [i (range 129)]
                    (let* [j (- 127 i)
                           stroke (if (= i 128)
                                      (if model.active model.current empty)
                                      (if (< j (count model.strokes))
                                          (nth model.strokes j)
                                          empty))
                           n (array/count stroke.points)
                           first (if (> n 0) (array/nth stroke.points 0) [0 0 0])]
                      (draw/merge (draw/circle first
                                               (max 1 (int/div stroke.width 2))
                                               :fill (if (> n 0)
                                                         (nth palette stroke.color)
                                                         "#00000000"))
                                  (draw/lines (array/slice stroke.points
                                                           0
                                                           (max 0 (- n 1)))
                                              (array/slice stroke.points
                                                           (if (> n 0) 1 0)
                                                           (max 0 (- n 1)))
                                              :color (nth palette stroke.color)
                                              :width stroke.width))))
                  (draw/rect [0 0 0]
                             [(frame/width) 92 0]
                             :fill (list (/ 9 255)
                                         (/ 14 255)
                                         (/ 25 255)
                                         (/ 245 255)))
                  (for [button (list {:x 8 :y 8 :w 62 :label "Clear"}
                                     {:x 76 :y 8 :w 62 :label "Undo"}
                                     {:x 144 :y 8 :w 62 :label "Save"})]
                    (draw/merge (draw/rounded_rect [button.x button.y 0]
                                    [button.w 34 0]
                                    :radius 6
                                    :fill "#1f2937"
                                    :stroke "#475569")
                                (draw/text [(+ button.x 12) (+ button.y 8) 0]
                                           button.label
                                           :size 14)))
                  (for [i (range 4)]
                    (draw/circle [(+ 230 (* i 38)) 25 0]
                                 (if (= i model.color) 12 9)
                                 :fill (nth palette i)
                                 :stroke "#ffffff"))
                  (for [button (list {:x 8 :y 50 :w 36 :label "−"}
                                     {:x 52 :y 50 :w 36 :label "+"})]
                    (draw/merge (draw/rounded_rect [button.x button.y 0]
                                    [button.w 34 0]
                                    :radius 6
                                    :fill "#1f2937"
                                    :stroke "#475569")
                                (draw/text [(+ button.x 12) (+ button.y 8) 0]
                                           button.label
                                           :size 14)))
                  (draw/circle [112 67 0]
                               (max 1 (int/div model.width 2))
                               :fill (nth palette model.color))
                  (draw/text [136 58 0]
                             (str model.width " px · draw · S save")
                             :size 13)
                  (draw/text [12 (- (frame/height) 26) 0]
                             model.status
                             :size 13
                             :color (list (/ 226 255)
                                          (/ 232 255)
                                          (/ 240 255)
                                          (/ 190 255))))))

  (graph actions :context host
    (host/save_png "_out/rays-drawing.png" (get (ref model) :save)))

  (graph editor :context editor
    (ui/workspace (ui/canvas (ref picture) :focus true) :effects (ref actions)))

  (graph window :context settings
    (settings/config :title "Rays freehand drawing" :width 800 :height 500)))
