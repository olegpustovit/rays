; Run from the repository root:
; rays render sketches/hero_ui.rays --camera hero --size 2400x3000 -o hero.png
; In panel, supply a cropped PNG, its pixel dimensions and the physical screen width.
; Use a full 16:10 screenshot resized to 1920x1200. Set path, columns and rows in panel.
; The five telephoto scene presets assume a screen width of 9.6. The custom pose is editable.
; usage = 05-usage-dashboard, permission = 01-sessions-sidebar.
; diff = 02-chat-transcript, topology = 06-machine-topology, sessions = 03-work-filters.
(workspace hero_ui
  (defn phosphor :context value [(v : float)]
    (pow (max 0.0 (/ (- v 0.106) 0.894)) 1.90))

  (graph panel :context sop
    [(path : text "pxui/tools/pxui_gallery/fixtures/gallery_kit_dusk_1x.png")
     (columns : int 640) (rows : int 464) (width : float 9.6)]
    (let* [texels (sop/image_texels (image/load path))
           rgba (sop/attr texels "rgba" :owner "point" :type "vec4")
           height (* width (/ (float rows) (float columns)))
           ; ponytail: use one uniformly spaced vertex per resampled texel for distant full-window
           ; views. Mesh memory grows with pixel count. Use sampled emission for tighter lenses.
           grid (sop/grid :counts "Point counts" :columns columns :rows rows :width width :height height)
           cd (exact (map (fn [(c : vec4)]
                  (let* [l (+ (+ (* c.x 0.2126) (* c.y 0.7152)) (* c.z 0.0722))
                         ink (* 0.13 (phosphor l))]
                    [(+ 0.0051 (* c.w (+ ink (* 0.73 (phosphor c.x)))))
                     (+ 0.007 (* c.w (+ ink (* 0.78 (phosphor c.y)))))
                     (+ 0.010 (* c.w (+ ink (* 0.82 (phosphor c.z))))) 1.0])) rgba))
           pixels (sop/material (sop/with_attr grid "Cd" cd :owner "point" :type vec4)
                    :material "Screen" :color [0 0 0] :emission [1 1 1] :roughness 0.4)
           body (sop/box :size [(+ width 0.06) 0.036 (+ height 0.06)] :center [0 -0.0181 0] :normals "Point")
           rim (sop/material (sop/with_attr body "Cd" (array/vec4 (sop/count body :points) [1 1 1 1])
                                             :owner "point" :type vec4)
                 :material "Window edge" :color [0 0 0] :emission [0.023 0.029 0.036] :roughness 0.4)]
      (sop/merge pixels rim)))

  (graph world :context world
    (world/gradient :name "Black studio"
      :zenith [0.00012 0.00018 0.00028] :horizon [0.00012 0.00018 0.00028] :nadir [0.00012 0.00018 0.00028]))

  (graph scene :context scene
    [(shot : text "custom") (eye : vec3 [-27 37 47]) (aim : vec3 [0 0 0]) (up : vec3 [0.5 1 0])
     (fov : float 0.232) (focus : float 64) (aperture : float 9)]
    (let* [pose (cond
            (equal? shot "usage")
              {:eye [-23.589291 32.457346 34.627202] :aim [-0.358455 0.000000 0.186072] :up [0.789281 0.612399 -0.044749]
               :fov 0.223 :focus 53.439584 :aperture 7.800000}
            (equal? shot "permission")
              {:eye [-9.947960 29.156463 42.594602] :aim [-0.224173 0.000000 0.476253] :up [0.788285 0.575898 -0.216676]
               :fov 0.232 :focus 53.257088 :aperture 8.050000}
            (equal? shot "diff")
              {:eye [18.565941 29.122714 41.344456] :aim [0.325817 0.000000 0.376466] :up [-0.756913 0.642459 -0.119702]
               :fov 0.232 :focus 54.600022 :aperture 8.300000}
            (equal? shot "topology")
              {:eye [7.947694 56.788173 21.687158] :aim [0.100415 0.000000 0.126934] :up [-0.788370 0.310563 -0.531059]
               :fov 0.232 :focus 62.121658 :aperture 10.200000}
            (equal? shot "sessions")
              {:eye [14.750471 50.945169 40.407574] :aim [0.129769 0.000000 0.237525] :up [-0.672494 0.567548 -0.475018]
               :fov 0.218 :focus 68.363705 :aperture 8.400000}
            :else {:eye eye :aim aim :up up :fov fov :focus focus :aperture aperture})
           camera (scene/camera :name "hero" :eye pose.eye :target pose.aim :fov pose.fov :up pose.up
                                :aperture pose.aperture :focus_distance pose.focus)
           screen (scene/geometry (ref panel) :name "UI screen")
           dome (scene/world (ref world) :exposure -0.68)]
      (scene/root (scene/merge screen camera dome)
        :camera camera :renderer "Path traced" :width 2400 :height 3000 :max_spp 512 :bounces 1))))
