; From the repository root:
; rays render sketches/hero_ui.rays --camera tele/permission -o permission.png
; Use the viewport camera name to change takes and / j to find the material graphs.
; The scene's studio input adds the floor and backing glass for lighting edits.
(workspace hero_ui
  (graph screen :context material
    [(path : text "sketches/hero_ui/01-sessions-sidebar.png") (strength : float 1.0) (tint : vec3 [1 1 1])]
    (material/standard :name "Screen" :texture (image/load path) :color [0 0 0]
      :emission [(* strength tint.x) (* strength tint.y) (* strength tint.z)] :roughness 0.4))

  (graph graphite :context material
    (material/standard :name "Window edge" :color [0 0 0] :emission [0.023 0.029 0.036] :roughness 0.4))

  (graph tele_grade :context material
    (material/film :exposure -0.68 :bloom 0.16 :bloom_threshold 0.4117647058823529
                   :bloom_sigma 0.005416666666666667 :grain 0.0117647058823529))

  (graph close_grade :context material
    (material/film :exposure 0.55 :bloom 0.16 :bloom_threshold 0.5686274509803921
                   :bloom_sigma 0.004583333333333333 :grain 0.0))

  (graph studio_floor :context material
    (material/standard :name "Studio floor" :color [0.008 0.010 0.014] :roughness 0.82))

  (graph glass :context material
    (material/standard :name "Smoked glass" :color [0.013 0.018 0.026] :roughness 0.16))

  (graph floor_mesh :context sop
    (sop/material (sop/box :size [10 0.1 10] :center [0 -0.31 0]) :material (ref studio_floor)))

  (graph glass_mesh :context sop
    (sop/material (sop/box :size [9.64 0.025 6.04] :center [0 -0.1 0]) :material (ref glass)))

  (graph panel :context sop
    [(width : float 9.6) (height : float 6.0) (crop : vec4 [0 0 1 1])]
    (let* [grid (sop/grid :columns 1 :rows 1 :width width :height height :uv_attribute "uv")
           uv (sop/attr grid "uv" :type "vec2")]
      (sop/with_attr grid "uv"
        (exact (map (fn [(p : vec2)] [(+ crop.x (* p.x crop.z)) (+ crop.y (* p.y crop.w))]) uv))
        :type vec2)))

  (graph rim :context sop
    [(width : float 9.6) (height : float 6.0)]
    (sop/material (sop/box :size [(+ width 0.06) 0.036 (+ height 0.06)] :center [0 -0.0181 0] :normals "Point")
      :material (ref graphite)))

  (graph world :context world
    [(close : bool false)]
    (let* [sky (if close [0.001 0.001 0.002] [0.00012 0.00018 0.00028])]
      (world/gradient :name "Black studio" :zenith sky :horizon sky :nadir sky)))

  (graph scene :context scene
    [(take : text "tele/permission") (preview : bool true) (studio : bool false)]
    (let* [
           tele_usage (scene/camera :name "tele/usage"
             :eye [-23.589291 32.457346 34.627202] :target [-0.358455 0.000000 0.186072] :up [0.789281 0.612399 -0.044749]
             :fov 0.223 :focus_distance 53.439584 :aperture 7.800000)
           tele_usage_square (scene/camera :name "tele/usage-square"
             :eye [-23.589291 32.457346 34.627202] :target [-0.358455 0.000000 0.186072] :up [0.789281 0.612399 -0.044749]
             :fov 0.223 :focus_distance 53.439584 :aperture 7.800000)
           tele_permission (scene/camera :name "tele/permission"
             :eye [-9.947960 29.156463 42.594602] :target [-0.224173 0.000000 0.476253] :up [0.788285 0.575898 -0.216676]
             :fov 0.232 :focus_distance 53.257088 :aperture 8.050000)
           tele_permission_square (scene/camera :name "tele/permission-square"
             :eye [-9.947960 29.156463 42.594602] :target [-0.224173 0.000000 0.476253] :up [0.788285 0.575898 -0.216676]
             :fov 0.232 :focus_distance 53.257088 :aperture 8.050000)
           tele_diff (scene/camera :name "tele/diff"
             :eye [18.565941 29.122714 41.344456] :target [0.325817 0.000000 0.376466] :up [-0.756913 0.642459 -0.119702]
             :fov 0.232 :focus_distance 54.600022 :aperture 8.300000)
           tele_topology (scene/camera :name "tele/topology"
             :eye [7.947694 56.788173 21.687158] :target [0.100415 0.000000 0.126934] :up [-0.788370 0.310563 -0.531059]
             :fov 0.232 :focus_distance 62.121658 :aperture 10.200000)
           tele_sessions (scene/camera :name "tele/sessions"
             :eye [14.750471 50.945169 40.407574] :target [0.129769 0.000000 0.237525] :up [-0.672494 0.567548 -0.475018]
             :fov 0.218 :focus_distance 68.363705 :aperture 8.400000)
           close_usage (scene/camera :name "close/usage"
             :eye [1.1598823 2.6037481 2.2509740] :target [0.2755000 0.0000000 0.1675000] :up [-0.0634388 0.6365713 -0.7686043]
             :fov 0.459 :focus_distance 4.0464810 :aperture 0.1150000)
           close_usage_square (scene/camera :name "close/usage-square"
             :eye [1.1598823 2.6037481 2.2509740] :target [0.2755000 0.0000000 0.1675000] :up [-0.0634388 0.6365713 -0.7686043]
             :fov 0.459 :focus_distance 4.0464810 :aperture 0.1150000)
           close_permission (scene/camera :name "close/permission"
             :eye [-0.0689331 2.5861440 2.8089022] :target [0.0935000 0.0000000 0.4860000] :up [-0.1910333 0.6492546 -0.7361894]
             :fov 0.53 :focus_distance 3.6430709 :aperture 0.1200000)
           close_permission_square (scene/camera :name "close/permission-square"
             :eye [-0.0689331 2.5861440 2.8089022] :target [0.0935000 0.0000000 0.4860000] :up [-0.1910333 0.6492546 -0.7361894]
             :fov 0.53 :focus_distance 3.6430709 :aperture 0.1200000)
           close_diff (scene/camera :name "close/diff"
             :eye [0.4842607 1.0521356 1.7905247] :target [0.1585000 0.0000000 0.3795000] :up [0.0903515 0.7882819 -0.6086445]
             :fov 0.49 :focus_distance 1.7936398 :aperture 0.0700000)
           close_topology (scene/camera :name "close/topology"
             :eye [0.1755976 4.0657299 1.4891748] :target [-0.0675000 0.0000000 0.1105000] :up [0.1996412 0.3039441 -0.9315371]
             :fov 0.53 :focus_distance 4.5257754 :aperture 0.1500000)
           close_sessions (scene/camera :name "close/sessions"
             :eye [0.0510000 2.2642884 1.5728844] :target [0.0510000 0.0000000 0.1580000] :up [-0.1564345 0.5233951 -0.8376072]
             :fov 0.52 :focus_distance 2.9349596 :aperture 0.1000000)
           camera (cond
             (equal? take "tele/usage") tele_usage
             (equal? take "tele/usage-square") tele_usage_square
             (equal? take "tele/permission") tele_permission
             (equal? take "tele/permission-square") tele_permission_square
             (equal? take "tele/diff") tele_diff
             (equal? take "tele/topology") tele_topology
             (equal? take "tele/sessions") tele_sessions
             (equal? take "close/usage") close_usage
             (equal? take "close/usage-square") close_usage_square
             (equal? take "close/permission") close_permission
             (equal? take "close/permission-square") close_permission_square
             (equal? take "close/diff") close_diff
             (equal? take "close/topology") close_topology
             (equal? take "close/sessions") close_sessions
             :else tele_permission)
           stock (cond
             (or (equal? take "tele/usage") (equal? take "tele/usage-square"))
               {:path "05-usage-dashboard.png" :crop [0 0 1 1] :width 9.6 :height 6.0 :close false}
             (equal? take "tele/diff")
               {:path "02-chat-transcript.png" :crop [0 0 1 1] :width 9.6 :height 6.0 :close false}
             (equal? take "tele/topology")
               {:path "06-machine-topology.png" :crop [0 0 1 1] :width 9.6 :height 6.0 :close false}
             (equal? take "tele/sessions")
               {:path "03-work-filters.png" :crop [0 0 1 1] :width 9.6 :height 6.0 :close false}
             ; The crop coordinates use the 1920 × 1200 framing grid.
             (or (equal? take "close/usage") (equal? take "close/usage-square"))
               {:path "05-usage-dashboard.png" :crop [(/ 470.0 1920.0) (/ 3.0 1200.0) (/ 844.0 1920.0) (/ 850.0 1200.0)]
                :width 2.5320000 :height (* 2.5320000 (/ 1680.0 1668.0)) :close true}
             (or (equal? take "close/permission") (equal? take "close/permission-square"))
               {:path "01-sessions-sidebar.png" :crop [(/ 969.0 1920.0) (/ 4.0 1200.0) (/ 914.0 1920.0) (/ 1189.0 1200.0)]
                :width 2.7420000 :height (* 2.7420000 (/ 1908.0 1468.0)) :close true}
             (equal? take "close/diff")
               {:path "02-chat-transcript.png" :crop [(/ 1110.0 1920.0) (/ 227.0 1200.0) (/ 482.0 1920.0) (/ 734.0 1200.0)]
                :width 1.4460000 :height (* 1.4460000 (/ 1468.0 964.0)) :close true}
             (equal? take "close/topology")
               {:path "06-machine-topology.png" :crop [(/ 974.0 1920.0) 0 (/ 858.0 1920.0) (/ 1014.0 1200.0)]
                :width 2.5740000 :height (* 2.5740000 (/ 1820.0 1540.0)) :close true}
             (equal? take "close/sessions")
               {:path "01-sessions-sidebar.png" :crop [0 0 (/ 527.0 1920.0) (/ 729.0 1200.0)]
                :width 1.5810000 :height (* 1.5810000 (/ 1458.0 1054.0)) :close true}
             :else {:path "01-sessions-sidebar.png" :crop [0 0 1 1] :width 9.6 :height 6.0 :close false})
           square (or (or (equal? take "tele/usage-square") (equal? take "tele/permission-square"))
                      (or (equal? take "close/usage-square") (equal? take "close/permission-square")))
           screen (scene/geometry (ref panel :width stock.width :height stock.height :crop stock.crop)
                    :name "UI screen" :material (ref screen :path (str "sketches/hero_ui/" stock.path)))
           edge (if stock.close (scene/merge)
                  (scene/geometry (ref rim :width stock.width :height stock.height) :name "Window edge"))
           dome (scene/world (ref world :close stock.close))
           grade (if stock.close (ref close_grade) (ref tele_grade))
           floor (if studio
                    (scene/geometry (ref floor_mesh) :name "Studio floor")
                    (scene/merge))
           back (if studio
                    (scene/geometry (ref glass_mesh) :name "Smoked glass")
                    (scene/merge))]
      (scene/root
        (scene/merge screen edge dome floor back
          tele_usage tele_usage_square tele_permission tele_permission_square tele_diff
          tele_topology tele_sessions close_usage close_usage_square close_permission
          close_permission_square close_diff close_topology close_sessions)
        :camera camera :film grade :renderer "Path traced" :width 2400
        :height (if square 2400 3000)
        :max_spp (if preview 16 (if stock.close 320 512)) :bounces 1)))

  (graph editor :context editor
    (let* [preview (ui/viewport (ref scene) :look_through true)
           network (ui/graph)
           inspector (ui/inspector)
           controls (ui/split_at "vertical" 0.5 network inspector)]
      (ui/workspace (ui/split_at "horizontal" 0.65 preview controls)))))
