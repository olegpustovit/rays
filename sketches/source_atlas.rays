; Source Atlas: every source file once in an asymmetric quadtree, each indexed file a nested
; field of its real rust-analyzer symbols. Leaf dots encode source span; branches are scopes.
; Generate first: tools/source_atlas_index
; Run: cargo run -p rays_bin -- sketches/source_atlas.rays
; Scroll zooms at the pointer, click dives, drag pans, right click steps back, R or Space resets,
; T shows cells, H or Tab hides the overlay, S saves _out/source-atlas.png, Escape quits.
(workspace source_atlas
  (graph data :context host (table/load "../_out/source_atlas/atlas.tsv"))

  (defn smooth :context value [(low : float) (high : float) (v : float)]
    (let* [u (max 0.0 (min 1.0 (/ (- v low) (- high low))))] (* (* u u) (- 3.0 (* 2.0 u)))))

  ; The plate: art between the header rule and the inspector, a sidebar on wide windows.
  (defn plate :context value [(w : float) (h : float)]
    (let* [sidebar (if (>= w 1100.0) 302.0 0.0)
           top (max 0.0 (- h 132.0))
           bottom (- top 12.0)]
      {:sidebar sidebar :top top :bottom bottom :right (- (- w sidebar) 22.0)
       :side (max 64.0 (min (- (- w sidebar) 88.0) (- bottom 84.0)))
       :ox (* (- w sidebar) 0.5) :oy (* (+ 74.0 bottom) 0.5)}))

  ; Child `k` of a node when it exists and holds the world point, else -1. A cell is [x y size kind].
  (defn holds :context value [(cell : (array vec4)) (first : int) (n : int) (k : int) (wx : float) (wy : float)]
    (let* [at (int (min (int/sub (array/count cell) 1) (int/add first k)))
           c (array/nth cell at)]
      (if (and (< k n) (and (and (>= wx c.x) (< wx (+ c.x c.z))) (and (>= wy c.y) (< wy (+ c.y c.z))))) at -1)))

  ; Deepest node holding a world point: [deepest, nearest named node, file-tree node].
  ; A node's children are contiguous rows, at most four.
  (defn locate :context value [(cell : (array vec4)) (child : (array int)) (count : (array int)) (wx : float) (wy : float)]
    (let* [walk (iterate 64 {:n 0 :named 0 :tile 0 :done false}
                         (fn [s]
                           (let* [first (array/nth child s.n)
                                  n (array/nth count s.n)
                                  hit (int (max (max (holds cell first n 0 wx wy) (holds cell first n 1 wx wy))
                                                (max (holds cell first n 2 wx wy) (holds cell first n 3 wx wy))))
                                  c (array/nth cell (int (max 0 hit)))]
                             (if (< hit 0) {:n s.n :named s.named :tile s.tile :done true}
                                 {:n hit :named (if (or (= c.w 3.0) (= c.w 6.0)) s.named hit)
                                  :tile (if (< c.w 3.0) hit s.tile) :done false})))
                         :until (fn [previous s] s.done))]
      [walk.n walk.named walk.tile]))

  ; Static selections and weights: computed once, never per frame.
  (graph field :context host
    (let* [d (ref data)
           ids (array/range (array/count d.kind) :type int)]
      {:cell (exact (map (fn [(i : int)] [(array/nth d.x i) (array/nth d.y i) (array/nth d.size i) (float (array/nth d.kind i))]) ids))
       :tiles (filter (fn [(i : int)] (< (array/nth d.kind i) 3)) ids)
       :twigs (filter (fn [(i : int)] (and (>= (array/nth d.kind i) 3) (= (array/nth d.kind (array/nth d.parent i)) 3))) ids)
       :leaves (filter (fn [(i : int)] (>= (array/nth d.kind i) 5)) ids)
       ; Dot weight: the share of a leaf's 16 by 16 samples that its source span lights.
       :weight (exact (map (fn [(i : int)] (int/add 25 (int (min 64.0 (floor (* 12.0 (log (+ 1.0 (max 1.0 (float (array/nth d.mass i)))))))))))
                           ids))
       :files (sum [i ids] (if (or (= (array/nth d.kind i) 1) (= (array/nth d.kind i) 2)) 1 0))
       :symbols (sum [i ids] (if (or (= (array/nth d.kind i) 4) (= (array/nth d.kind i) 5)) 1 0))
       :lines (sum [i ids] (if (or (= (array/nth d.kind i) 1) (= (array/nth d.kind i) 2)) (array/nth d.last i) 0))}))

  (graph view :context host [(initial_zoom : float 1.0) (center : vec3 [0.5 0.5 0.0])]
    (let* [d (ref data)
           cell (get (ref field) :cell)
           p (plate (frame/width) (frame/height))
           input (frame/input)]
      (state [old {:cx center.x :cy center.y :zoom initial_zoom :tx center.x :ty center.y :tz initial_zoom
                   :px 0.0 :py 0.0 :press false :press_x 0.0 :press_y 0.0 :dragged false
                   :ui true :cells false :key_ui false :key_cells false :hover -1}]
        (let* [px (pointer/x) py (pointer/y)
               inside (and (and (>= px 24.0) (< px p.right)) (and (>= py 74.0) (< py p.bottom)))
               extent (* p.side old.zoom)
               wx (+ old.cx (/ (- px p.ox) extent))
               wy (+ old.cy (/ (- py p.oy) extent))
               left (pointer/down)
               wheel (fold [v 0.0] [event input.events]
                           (+ v (case event.kind "scrolled" (* event.delta.y 0.17)
                                                 "trackpad-scrolled" (* event.delta.y 0.012)
                                                 "pinched" (log (max 0.01 event.scale)) :else 0.0)))
               pressed (fold [v false] [event input.events]
                             (or v (and (equal? event.kind "pointer-pressed") (equal? event.button "left"))))
               released (fold [v false] [event input.events]
                              (or v (and (equal? event.kind "pointer-released") (equal? event.button "left"))))
               back (fold [v false] [event input.events]
                          (or v (and (equal? event.kind "pointer-pressed") (equal? event.button "right"))))
               reset (or (key/down "r") (key/down "space"))
               key_ui (or (key/down "h") (key/down "tab"))
               key_cells (key/down "t")
               press (if pressed inside (and old.press left))
               press_x (if pressed px old.press_x)
               press_y (if pressed py old.press_y)
               dx (- px old.px) dy (- py old.py)
               pan (and (or (and (pointer/down "middle") inside) (and left old.press))
                        (or (not (= dx 0.0)) (not (= dy 0.0))))
               dragged (if pressed false (or old.dragged (and (and pan left) (> (+ (abs dx) (abs dy)) 2.0))))
               dive (and (and released old.press)
                         (and inside (and (not old.dragged) (< (+ (abs (- px old.press_x)) (abs (- py old.press_y))) 8.0))))
               clicked (if dive (locate cell d.child d.count wx wy) [0.0 0.0 0.0])
               tile (int clicked.z)
               target (array/nth cell tile)
               tile_size target.z
               ; Wheel: keep the world point under the pointer while the target zoom changes.
               wheel_zoom (max 0.65 (min 180.0 (* old.tz (exp wheel))))
               zoomed (and inside (not (= wheel 0.0)))
               tz (cond reset 1.0
                        dive (max 0.65 (min 180.0 (min (* old.zoom 3.2) (/ 0.7 tile_size))))
                        back (max 1.0 (/ old.zoom 2.8))
                        zoomed wheel_zoom
                        :else old.tz)
               slide_x (if pan (/ dx extent) 0.0)
               slide_y (if pan (/ dy extent) 0.0)
               tx (cond reset 0.5
                        dive (+ target.x (* tile_size 0.5))
                        zoomed (- (- wx (/ (- px p.ox) (* p.side wheel_zoom))) slide_x)
                        :else (- old.tx slide_x))
               ty (cond reset 0.5
                        dive (+ target.y (* tile_size 0.5))
                        zoomed (- (- wy (/ (- py p.oy) (* p.side wheel_zoom))) slide_y)
                        :else (- old.ty slide_y))
               ease (- 1.0 (exp (* -11.0 (max 0.0 (min 0.1 (frame/dt))))))
               zoom (if (< (abs (- tz old.zoom)) 0.00001) tz (+ old.zoom (* (- tz old.zoom) ease)))
               cx (if (< (abs (- tx old.cx)) 0.00001) tx (+ old.cx (* (- tx old.cx) ease)))
               cy (if (< (abs (- ty old.cy)) 0.00001) ty (+ old.cy (* (- ty old.cy) ease)))
               still (and (and (= px old.px) (= py old.py)) (and (= zoom old.zoom) (and (= cx old.cx) (= cy old.cy))))
               found (if (or still (not inside)) [0.0 0.0 0.0]
                         (locate cell d.child d.count
                                 (+ cx (/ (- px p.ox) (* p.side zoom))) (+ cy (/ (- py p.oy) (* p.side zoom)))))
               hover (cond (not inside) -1 still old.hover :else (int found.y))]
          {:cx cx :cy cy :zoom zoom :tx tx :ty ty :tz tz :px px :py py
           :press (and press (not released)) :press_x press_x :press_y press_y :dragged (and dragged (not released))
           :ui (if (and key_ui (not old.key_ui)) (not old.ui) old.ui)
           :cells (if (and key_cells (not old.key_cells)) (not old.cells) old.cells)
           :key_ui key_ui :key_cells key_cells :hover hover}))))

  (defn tint :context value [(group : int)]
    (case group 1 [0.702 0.710 0.671] 2 [0.855 0.847 0.788] 3 [0.722 0.769 0.761] 4 [0.659 0.694 0.690]
                :else [0.890 0.890 0.839]))

  ; Marks have no alpha: a faded mark is mixed into the ink it sits on.
  (defn ink :context value [(color : vec3) (alpha : float)]
    (+ [0.059 0.075 0.071] (* (- color [0.059 0.075 0.071]) alpha)))

  ; A node on screen as [x y side]; the camera is [x offset, y offset, points per world unit].
  (defn spot :context value [(cell : (array vec4)) (cam : vec3) (i : int)]
    (let* [c (array/nth cell i)] [(+ cam.x (* c.x cam.z)) (+ cam.y (* c.y cam.z)) (* c.z cam.z)]))

  ; Inside the art: `lim` is its right and bottom edge.
  (defn seen :context value [(q : vec3) (lim : vec3)]
    (and (and (>= (+ q.x q.z) 24.0) (>= (+ q.y q.z) 74.0)) (and (< q.x lim.x) (< q.y lim.y))))

  ; A collapsed node crossfades into its children between 2 and 4 points, so a node's opacity is
  ; the product over its ancestors. ponytail: three ancestors; a chain of more than three
  ; single-child scopes under 4 points would need a longer walk.
  (defn chain :context value [(parent : (array int)) (cell : (array vec4)) (cam : vec3) (i : int)]
    (let* [a (array/nth parent i) b (array/nth parent a) c (array/nth parent b)
           sa (array/nth cell a) sb (array/nth cell b) sc (array/nth cell c)]
      (* (* (smooth 2.0 4.0 (* sa.z cam.z)) (smooth 2.0 4.0 (* sb.z cam.z))) (smooth 2.0 4.0 (* sc.z cam.z)))))

  ; What a node shows as itself: a point while collapsed, fading out as its children take over;
  ; a named scope keeps a centre mark from 8 points up.
  (defn node-alpha :context value [(parent : (array int)) (cell : (array vec4)) (cam : vec3) (i : int)]
    (let* [q (spot cell cam i) c (array/nth cell i)]
      (* (chain parent cell cam i)
         (cond (and (= c.w 4.0) (> q.z 8.0)) (smooth 8.0 16.0 q.z)
               (>= c.w 5.0) (- 1.0 (smooth 1.0 4.0 q.z))
               (= c.w 2.0) (if (< q.z 2.0) 1.0 0.0)
               :else (- 1.0 (smooth 2.0 4.0 q.z))))))

  ; Stipple levels 0 and 1 of leaf `i`: sample 3 of its four is the centre representative.
  (defn coarse-alpha :context value [(parent : (array int)) (cell : (array vec4)) (cam : vec3) (i : int) (k : int)]
    (let* [q (spot cell cam i)]
      (* (chain parent cell cam i) (if (= k 3) (smooth 1.0 4.0 q.z) (smooth 4.0 8.0 q.z)))))

  ; A cell outline: unindexed files are always hollow; with cells shown, every file and branch.
  (defn frame-alpha :context value [(parent : (array int)) (cell : (array vec4)) (cam : vec3) (lim : vec3) (cells : bool) (i : int)]
    (let* [q (spot cell cam i) c (array/nth cell i)]
      (if (and (seen q lim) (cond (= c.w 2.0) (>= q.z 2.0) (= c.w 1.0) (and cells (> q.z 90.0)) :else (and cells (> q.z 12.0))))
          (chain parent cell cam i) 0.0)))

  ; One of the two segments of file-tree node `i` as [x1 y1 x2 y2]: the orthogonal path from its
  ; parent's centre, or with cells shown a branch's corner tick.
  (defn limb :context value [(parent : (array int)) (cell : (array vec4)) (cam : vec3) (lim : vec3) (cells : bool) (i : int) (part : int)]
    (let* [c (spot cell cam i) q (spot cell cam (array/nth parent i)) kind (array/nth cell i)
           cx (+ c.x (* c.z 0.5)) cy (+ c.y (* c.z 0.5))
           qx (+ q.x (* q.z 0.5)) qy (+ q.y (* q.z 0.5))
           x (+ (floor c.x) 2.0) y (+ (floor c.y) 2.0)
           reach (min 15.0 (floor (/ (max 1.0 (floor c.z)) 8.0)))]
      (if cells
          (if (and (and (= kind.w 0.0) (> c.z 110.0)) (seen c lim))
              [x y (if (= part 0) (+ (floor c.x) reach) x) (if (= part 0) y (+ (floor c.y) reach))]
              [0.0 0.0 0.0 0.0])
          (if (and (and (> i 0) (> q.z 10.0)) (seen q lim))
              [(if (= part 0) qx cx) qy cx (if (= part 0) qy cy)]
              [0.0 0.0 0.0 0.0]))))

  ; A leaf's stable sample: lit when its hash falls under the leaf's weight. Cubing modulo a
  ; prime under 2^15.5 mixes without leaving 32 bits, which the device's integers are.
  (defn lit :context value [(seed : int) (id : int) (weight : int)]
    (let* [h (int/mod (int/add (int/mod seed 46337) (int/add (int/mul id 7919) 1)) 46337)
           cube (int/mod (int/mul (int/mod (int/mul h h) 46337) h) 46337)]
      (< (int/mod (int/add cube id) 100) weight)))

  ; One stipple dot at sample (a, b) of a leaf's 16 by 16 grid; functions and methods stand tall.
  (defn dot-at :context value [(q : vec3) (tall : bool) (a : int) (b : int)]
    (let* [dot (max 0.75 (/ q.z 32.0))]
      [(- (+ q.x (* q.z (/ (+ (float a) 0.5) 16.0))) (* dot 0.5))
       (- (+ q.y (* q.z (/ (+ (float b) 0.5) 16.0))) (* dot (if tall 1.0 0.5))) 0.0]))
  (defn dot-size :context value [(q : vec3) (tall : bool) (keep : bool)]
    (let* [dot (max 0.75 (/ q.z 32.0))]
      (if keep [dot (if tall (* dot 2.0) dot) 0.0] [0.0 0.0 0.0])))

  ; Lattice columns (or rows) of a `pitch`-point grid over `extent` points, one past each edge.
  (defn across :context value [(extent : float) (pitch : float)]
    (int/add (int (ceil (/ extent pitch))) 2))

  ; The cell that owns each lattice point of four screen grids, or -1: leaves over 8, 16 and 32
  ; points for the stipple levels, then files over 180 points for labels. A cell larger than the
  ; pitch always holds a lattice point and its first one owns it, so a bounded number of slots
  ; replaces a per-frame filter over every node. One region for all four: a region this size runs
  ; on the device, and smaller ones would not. `view` is [centre x, centre y, scale].
  (defn slots :context value [(cell : (array vec4)) (child : (array int)) (count : (array int))
                              (view : vec3) (mid : vec3) (lim : vec3)]
    (let* [n8 (int/mul (across (- lim.x 24.0) 8.0) (across (- lim.y 74.0) 8.0))
           n16 (int/mul (across (- lim.x 24.0) 16.0) (across (- lim.y 74.0) 16.0))
           n32 (int/mul (across (- lim.x 24.0) 32.0) (across (- lim.y 74.0) 32.0))
           n180 (int/mul (across (- lim.x 24.0) 180.0) (across (- lim.y 74.0) 180.0))]
      (map (fn [(k : int)]
             (let* [files (>= k (int/add n8 (int/add n16 n32)))
                    pitch (cond (< k n8) 8.0 (< k (int/add n8 n16)) 16.0 (not files) 32.0 :else 180.0)
                    slot (cond (< k n8) k (< k (int/add n8 n16)) (int/sub k n8) (not files) (int/sub k (int/add n8 n16))
                               :else (int/sub k (int/add n8 (int/add n16 n32))))
                    cols (across (- lim.x 24.0) pitch)
                    col (int/mod slot cols) row (int/div slot cols)
                    wx (+ view.x (/ (- (+ 24.0 (* (float col) pitch)) mid.x) view.z))
                    wy (+ view.y (/ (- (+ 74.0 (* (float row) pitch)) mid.y) view.z))
                    before_x (+ view.x (/ (- (+ 24.0 (* (float (int/sub col 1)) pitch)) mid.x) view.z))
                    before_y (+ view.y (/ (- (+ 74.0 (* (float (int/sub row 1)) pitch)) mid.y) view.z))
                    found (locate cell child count wx wy)
                    n (int (if files found.z found.x))
                    c (array/nth cell n)]
               (if (and (and (if files (or (= c.w 1.0) (= c.w 2.0)) (>= c.w 5.0)) (> (* c.z view.z) pitch))
                        (and (or (= col 0) (< before_x c.x)) (or (= row 0) (< before_y c.y))))
                   n -1)))
           (array/range (int/add (int/add n8 n16) (int/add n32 n180)) :type int))))

  ; The stipple level that appears between `pitch` and twice `pitch` points, drawn for the
  ; `count` slots from `base`: `per` by `per` samples a slot, `step` grid cells apart; those of
  ; coarser levels belong to their own sets.
  (defn stipple :context draw [(owners : (array int)) (base : int) (count : int) (cell : (array vec4)) (lsp : (array int))
                               (seed : (array int)) (weight : (array int)) (group : (array int)) (cam : vec3) (lim : vec3)
                               (pitch : float) (per : int) (step : int)]
    (let* [marks (array/range (int/mul count (int/mul per per)) :type int)]
      (draw/rects
        (map (fn [(m : int)]
               (let* [i (int (max 0 (array/nth owners (int/add base (int/div m (int/mul per per))))))
                      e (int/mod m (int/mul per per))]
                 (dot-at (spot cell cam i) (or (= (array/nth lsp i) 12) (= (array/nth lsp i) 6))
                         (int/mul step (int/mod e per)) (int/mul step (int/div e per))))) marks)
        (map (fn [(m : int)]
               (let* [owner (array/nth owners (int/add base (int/div m (int/mul per per))))
                      i (int (max 0 owner))
                      e (int/mod m (int/mul per per))
                      a (int/mul step (int/mod e per)) b (int/mul step (int/div e per))
                      q (spot cell cam i)]
                 (dot-size q (or (= (array/nth lsp i) 12) (= (array/nth lsp i) 6))
                           (and (and (>= owner 0) (seen q lim))
                                (and (not (and (= (int/mod a (int/mul step 2)) 0) (= (int/mod b (int/mul step 2)) 0)))
                                     (lit (array/nth seed i) (int/add a (int/mul b 16)) (array/nth weight i))))))) marks)
        :fill (map (fn [(m : int)]
                     (let* [i (int (max 0 (array/nth owners (int/add base (int/div m (int/mul per per))))))
                            q (spot cell cam i)]
                       (ink (tint (array/nth group i)) (smooth pitch (* pitch 2.0) q.z)))) marks))))

  (defn kind-name :context value [(kind : int) (lsp : int)]
    (case kind 1 "FILE" 2 "UNINDEXED FILE"
      :else (case lsp 1 "FILE" 2 "MODULE" 3 "NAMESPACE" 4 "PACKAGE" 5 "CLASS" 6 "METHOD" 7 "PROPERTY" 8 "FIELD"
                      9 "CONSTRUCTOR" 10 "ENUM" 11 "INTERFACE" 12 "FUNCTION" 13 "VARIABLE" 14 "CONSTANT" 15 "STRING"
                      16 "NUMBER" 17 "BOOLEAN" 18 "ARRAY" 19 "OBJECT" 20 "KEY" 21 "NULL" 22 "ENUM MEMBER" 23 "STRUCT"
                      24 "EVENT" 25 "OPERATOR" 26 "TYPE PARAMETER" :else "SYMBOL")))

  (graph picture :context draw
    (let* [d (ref data) f (ref field) view (ref view) widths (get (ref profile) :width)
           cell f.cell
           w (float (frame/width)) h (float (frame/height))
           p (plate w h)
           scale (* p.side view.zoom)
           cam [(- p.ox (* view.cx scale)) (- p.oy (* view.cy scale)) scale]
           lim [p.right p.bottom 0.0]
           ids (array/range (array/count d.kind) :type int)
           paper [0.882 0.847 0.753]

           ; Every node once: the point a collapsed node is, or a named scope's centre mark.
           node_at (map (fn [(i : int)]
                          (let* [q (spot cell cam i) half (if (and (= (array/nth d.kind i) 4) (> q.z 8.0)) 1.0 0.5)]
                            [(- (+ q.x (* q.z 0.5)) half) (- (+ q.y (* q.z 0.5)) half) 0.0])) ids)
           node_size (map (fn [(i : int)]
                            (let* [q (spot cell cam i) side (if (and (= (array/nth d.kind i) 4) (> q.z 8.0)) 2.0 1.0)]
                              (if (and (seen q lim) (> (node-alpha d.parent cell cam i) 0.004)) [side side 0.0] [0.0 0.0 0.0]))) ids)
           node_fill (map (fn [(i : int)]
                            (let* [q (spot cell cam i)]
                              (ink (if (and (= (array/nth d.kind i) 4) (> q.z 8.0)) paper (tint (array/nth d.group i)))
                                   (node-alpha d.parent cell cam i)))) ids)

           ; File-tree branches: orthogonal parent-child paths; with cells shown, corner ticks.
           tiles f.tiles
           limbs (array/range (int/mul (array/count tiles) 2) :type int)
           limb_from (map (fn [(j : int)] (let* [l (limb d.parent cell cam lim view.cells (array/nth tiles (int/div j 2)) (int/mod j 2))] [l.x l.y 0.0])) limbs)
           limb_to (map (fn [(j : int)] (let* [l (limb d.parent cell cam lim view.cells (array/nth tiles (int/div j 2)) (int/mod j 2))] [l.z l.w 0.0])) limbs)
           limb_color (map (fn [(j : int)]
                             (let* [parent (array/nth d.parent (array/nth tiles (int/div j 2)))
                                    q (spot cell cam parent)]
                               (if view.cells [0.506 0.537 0.463]
                                   (ink (if (< (array/nth d.depth parent) 2) [0.157 0.188 0.173] [0.247 0.278 0.247])
                                        (smooth 10.0 18.0 q.z))))) limbs)

           ; Symbol branches: a packing node to each of its parts.
           twigs f.twigs
           twig_ids (array/range (array/count twigs) :type int)
           twig_from (map (fn [(j : int)]
                            (let* [q (spot cell cam (array/nth d.parent (array/nth twigs j)))]
                              (if (and (> q.z 8.0) (seen q lim)) [(+ q.x (* q.z 0.5)) (+ q.y (* q.z 0.5)) 0.0] [0.0 0.0 0.0]))) twig_ids)
           twig_to (map (fn [(j : int)]
                          (let* [i (array/nth twigs j) c (spot cell cam i) q (spot cell cam (array/nth d.parent i))]
                            (if (and (> q.z 8.0) (seen q lim)) [(+ c.x (* c.z 0.5)) (+ c.y (* c.z 0.5)) 0.0] [0.0 0.0 0.0]))) twig_ids)
           twig_color (map (fn [(j : int)]
                             (let* [i (array/nth twigs j) q (spot cell cam (array/nth d.parent i))]
                               (ink (* (tint (array/nth d.group i)) 0.28) (smooth 8.0 16.0 q.z)))) twig_ids)

           ; Four one-point edges a cell: stroked rectangles are tessellated on the host.
           edges (array/range (int/mul (array/count tiles) 4) :type int)
           frame_at (map (fn [(j : int)]
                           (let* [i (array/nth tiles (int/div j 4)) edge (int/mod j 4) q (spot cell cam i)
                                  c (array/nth cell i)
                                  side (max 1.0 (- (max 1.0 (floor q.z)) (if (= c.w 1.0) 3.0 2.0)))]
                             [(+ (+ (floor q.x) 1.0) (if (= edge 3) (- side 1.0) 0.0))
                              (+ (+ (floor q.y) 1.0) (if (= edge 1) (- side 1.0) 0.0)) 0.0])) edges)
           frame_size (map (fn [(j : int)]
                             (let* [i (array/nth tiles (int/div j 4)) q (spot cell cam i) c (array/nth cell i)
                                    side (max 1.0 (- (max 1.0 (floor q.z)) (if (= c.w 1.0) 3.0 2.0)))]
                               (if (> (frame-alpha d.parent cell cam lim view.cells i) 0.004)
                                   (if (< (int/mod j 4) 2) [side 1.0 0.0] [1.0 side 0.0])
                                   [0.0 0.0 0.0]))) edges)
           frame_color (map (fn [(j : int)]
                              (let* [i (array/nth tiles (int/div j 4))]
                                (if (= (array/nth d.kind i) 0)
                                    (if (= (int/mod (array/nth d.depth i) 2) 0) [0.212 0.243 0.200] [0.153 0.176 0.149])
                                    (ink (* (tint (array/nth d.group i)) 0.35) (frame-alpha d.parent cell cam lim view.cells i))))) edges)
           tile_ids (array/range (array/count tiles) :type int)
           corner_at (map (fn [(j : int)]
                            (let* [q (spot cell cam (array/nth tiles j)) side (max 1.0 (floor q.z))]
                              [(- (+ (floor q.x) side) 5.0) (- (+ (floor q.y) side) 5.0) 0.0])) tile_ids)
           corner_size (map (fn [(j : int)]
                              (let* [i (array/nth tiles j) q (spot cell cam i)]
                                (if (and (and view.cells (= (array/nth d.kind i) 0)) (and (> q.z 110.0) (seen q lim))) [2.0 2.0 0.0] [0.0 0.0 0.0]))) tile_ids)

           ; Stipple levels 0 and 1, four samples a leaf: its centre representative and three quarters.
           leaves f.leaves
           coarse (array/range (int/mul (array/count leaves) 4) :type int)
           coarse_at (map (fn [(j : int)]
                            (let* [i (array/nth leaves (int/div j 4)) k (int/mod j 4)]
                              (dot-at (spot cell cam i) (or (= (array/nth d.lsp i) 12) (= (array/nth d.lsp i) 6))
                                      (int/mul 8 (int/mod k 2)) (int/mul 8 (int/div k 2))))) coarse)
           coarse_size (map (fn [(j : int)]
                              (let* [i (array/nth leaves (int/div j 4)) k (int/mod j 4) q (spot cell cam i)]
                                (dot-size q (or (= (array/nth d.lsp i) 12) (= (array/nth d.lsp i) 6))
                                          (and (and (seen q lim) (> (coarse-alpha d.parent cell cam i k) 0.004))
                                               (or (= k 3) (lit (array/nth d.seed i) (int/add (int/mul 8 (int/mod k 2)) (int/mul 128 (int/div k 2))) (array/nth f.weight i))))))) coarse)
           coarse_fill (map (fn [(j : int)]
                              (let* [i (array/nth leaves (int/div j 4))]
                                (ink (tint (array/nth d.group i)) (coarse-alpha d.parent cell cam i (int/mod j 4))))) coarse)

           eye [view.cx view.cy scale] mid [p.ox p.oy 0.0]
           owners (slots cell d.child d.count eye mid lim)
           n8 (int/mul (across (- lim.x 24.0) 8.0) (across (- lim.y 74.0) 8.0))
           n16 (int/mul (across (- lim.x 24.0) 16.0) (across (- lim.y 74.0) 16.0))
           n32 (int/mul (across (- lim.x 24.0) 32.0) (across (- lim.y 74.0) 32.0))
           n180 (int/sub (array/count owners) (int/add n8 (int/add n16 n32)))

           ; Function leaves rule up to 12 lines from their file's line-length profile.
           rules (array/range (int/mul n16 12) :type int)
           rule_at (map (fn [(m : int)]
                          (let* [i (int (max 0 (array/nth owners (int/add n8 (int/div m 12))))) q (spot cell cam i)
                                 rows (float (min 12 (max 1 (array/nth d.mass i))))]
                            [q.x (+ q.y (/ (* (float (int/mod m 12)) q.z) rows)) 0.0])) rules)
           rule_size (map (fn [(m : int)]
                            (let* [owner (array/nth owners (int/add n8 (int/div m 12))) i (int (max 0 owner)) row (int/mod m 12)
                                   q (spot cell cam i)
                                   width (array/nth widths (int/add (int/mul (array/nth d.file i) 32)
                                                                    (int/mod (int/add (int/add (array/nth d.first i) 31) row) 32)))]
                              (if (and (and (>= owner 0) (or (= (array/nth d.lsp i) 12) (= (array/nth d.lsp i) 6)))
                                       (and (> q.z 24.0) (< row (min 12 (max 1 (array/nth d.mass i))))))
                                  [(max 0.5 (/ (* q.z (float width)) 120.0)) 0.75 0.0] [0.0 0.0 0.0]))) rules)
           rule_fill (map (fn [(m : int)]
                            (let* [i (int (max 0 (array/nth owners (int/add n8 (int/div m 12))))) q (spot cell cam i)]
                              (ink (* (tint (array/nth d.group i)) 0.7) (smooth 24.0 40.0 q.z)))) rules)

           ; File names appear on cells over 180 points.
           named (int/add n8 (int/add n16 n32))
           ; ponytail: 96 label slots cover an art area up to about 1900 by 1300 points.
           labels (for [k (range 96)]
                    (let* [slot (int/add named (int (min k (int/sub n180 1))))
                           on (and (< k n180) (>= (array/nth owners slot) 0))
                           i (int (max 0 (array/nth owners slot)))
                           q (spot cell cam i) side (max 1.0 (floor q.z))]
                      (draw/merge
                        (draw/rect [(+ (floor q.x) 6.0) (+ (floor q.y) 6.0) 0.0]
                                   (if on [(min (- side 12.0) (+ (* (float (array/nth d.chars i)) 7.0) 12.0)) 21.0 0.0] [0.0 0.0 0.0])
                                   :fill "#0f1312")
                        (draw/text [(+ (floor q.x) 11.0) (+ (floor q.y) 9.0) 0.0] (if on (array/nth d.tag i) "") :size 11 :color "#e1d8c0"))))

           hover view.hover
           h0 (int (max 0 hover))
           hq (spot cell cam h0)
           kind (array/nth d.kind h0)
           inspected (and (>= hover 0) (> kind 0))
           art (draw/merge
                 (draw/rects frame_at frame_size :fill frame_color)
                 (draw/lines limb_from limb_to :color limb_color :width 1.0)
                 (draw/lines twig_from twig_to :color twig_color :width 1.0)
                 (draw/rects node_at node_size :fill node_fill)
                 (draw/rects coarse_at coarse_size :fill coarse_fill)
                 (stipple owners 0 n8 cell d.lsp d.seed f.weight d.group cam lim 8.0 4 4)
                 (stipple owners n8 n16 cell d.lsp d.seed f.weight d.group cam lim 16.0 8 2)
                 (stipple owners (int/add n8 n16) n32 cell d.lsp d.seed f.weight d.group cam lim 32.0 16 1)
                 (draw/rects rule_at rule_size :fill rule_fill)
                 (draw/rects corner_at corner_size :fill "#e67543")
                 labels
                 (draw/rect [(floor hq.x) (floor hq.y) 0.0]
                            (if inspected [(max 1.0 (floor hq.z)) (max 1.0 (floor hq.z)) 0.0] [0.0 0.0 0.0]) :stroke "#e67543"))

           ; The plate's chrome. Text is not clipped: the indexer keeps previews short.
           split (max 240.0 (floor (* w 0.43)))
           side_x (- w 282.0)
           first (array/nth d.first h0) last (array/nth d.last h0)
           span (int/add (int/sub last first) 1)
           hundredths (int (round (* view.zoom 100.0)))
           ruler (for [k (range 17)]
                   (let* [x (floor (+ cam.x (* (/ (float k) 16.0) scale))) on (and (> x 32.0) (< x p.right))]
                     (draw/merge
                       (draw/line [x 64 0] [x (if on (if (= (int/mod k 4) 0) 72.0 68.0) 64.0) 0] :color "#818976" :width 1.0)
                       (draw/text [(+ x 4.0) 62 0] (if (and on (= (int/mod k 4) 0)) (case k 0 "00" 4 "04" 8 "08" 12 "0C" :else "10") "")
                                  :size 8 :color "#818976"))))
           legend (for [k (range 5)]
                    (let* [y (+ 541.0 (* (float k) 20.0)) on (< (+ y 12.0) (- p.bottom 24.0))]
                      (draw/merge
                        (draw/rect [side_x (+ y 3.0) 0] (if on [6 6 0] [0 0 0])
                                   :fill (case k 0 "#a8b1b0" 1 "#e3e3d6" 2 "#b3b5ab" 3 "#dad8c9" :else "#b8c4c2"))
                        (draw/text [(+ side_x 18.0) y 0]
                                   (if on (case k 0 "CORE / BINDINGS" 1 "LIBRARIES" 2 "TESTS" 3 "SKETCHES" :else "EXAMPLES") "")
                                   :size 10 :color "#818976"))))
           sidebar (draw/merge
                     (draw/line [(- side_x 22.0) 80 0] [(- side_x 22.0) p.bottom 0] :color "#363e33" :width 1.0)
                     (draw/text [side_x 84 0] "RECURSIVE FIELD / 01" :size 10 :color "#e67543")
                     (draw/text [(- side_x 3.0) 121 0] "SOURCE" :size 44 :color "#e1d8c0")
                     (draw/text [(- side_x 3.0) 165 0] "STRATA" :size 44 :color "#e1d8c0")
                     (draw/text [side_x 239 0] "A repository, folded into space." :size 12 :color "#818976")
                     (draw/text [side_x 260 0] "Files / modules / types / values." :size 12 :color "#818976")
                     (draw/text [side_x 281 0] "Real symbols. Recursive space." :size 12 :color "#818976")
                     (draw/line [side_x 323 0] [(- w 34.0) 323 0] :color "#363e33" :width 1.0)
                     (draw/text [side_x 345 0] (str f.files) :size 35 :color "#e1d8c0")
                     (draw/text [side_x 392 0] "SOURCE FILES" :size 10 :color "#818976")
                     (draw/text [side_x 435 0] (str f.symbols) :size 35 :color "#e1d8c0")
                     (draw/text [side_x 482 0] "LSP SYMBOLS / NESTED SCOPE" :size 10 :color "#818976")
                     (draw/line [side_x 518 0] [(- w 34.0) 518 0] :color "#363e33" :width 1.0)
                     legend
                     (draw/text [side_x (- p.bottom 16.0) 0]
                                (if (> h 780.0)
                                    (str "MAGNIFICATION     " (if (< hundredths 1000) "0" "") (int/div hundredths 100) "."
                                         (if (< (int/mod hundredths 100) 10) "0" "") (int/mod hundredths 100) " X")
                                    "")
                                :size 10 :color "#e67543"))
           left_x 32.0 right_x (+ split 20.0)
           inspector (draw/merge
                       (draw/text [left_x (+ p.top 14.0) 0] (if inspected (array/nth d.path h0) "SYMBOL INSPECTOR")
                                  :size (if inspected 11 10) :color "#e67543")
                       (draw/text [left_x (+ p.top 36.0) 0]
                                  (if inspected (str (kind-name kind (array/nth d.lsp h0)) "  /  " (array/nth d.label h0))
                                      "Hover a mark to inspect its symbol")
                                  :size 16 :color "#e1d8c0")
                       (draw/text [left_x (+ p.top 64.0) 0]
                                  (if inspected
                                      (str "LINES " first "-" last "  /  " span " LINES"
                                           (cond (= kind 4) "  /  NESTED SCOPE"
                                                 (= kind 5) (str "  /  DOT WEIGHT " (array/nth f.weight h0) "/100")
                                                 :else (str "  /  " (array/nth d.bytes h0) " BYTES")))
                                      (str f.files " FILES  /  " f.symbols " SYMBOLS  /  " f.lines " LINES"))
                                  :size 11 :color "#818976")
                       (draw/text [right_x (+ p.top 14.0) 0] (if inspected "SOURCE PREVIEW" "READING THE FIELD") :size 10 :color "#e67543")
                       (for [k (range 3)]
                         (let* [number (int/add first k)]
                           (draw/text [right_x (+ (+ p.top 36.0) (* (float k) 20.0)) 0]
                                      (cond (not inspected)
                                            (case k 0 "Leaf dots = source span; branches = nested scopes."
                                                    1 "Zoom reveals detail. Density is not a complexity score."
                                                    :else "SCROLL zoom   DRAG pan   CLICK dive   R reset   T cells   H hide")
                                            (< k span)
                                            (str (cond (< number 10) "    " (< number 100) "   " (< number 1000) "  " (< number 10000) " " :else "")
                                                 number "   " (case k 0 (array/nth d.l0 h0) 1 (array/nth d.l1 h0) :else (array/nth d.l2 h0)))
                                            :else "")
                                      :size (if (and (not inspected) (= k 2)) 11 12)
                                      :color (if (or inspected (= k 0)) "#e1d8c0" "#818976")))))
           chrome (draw/merge
                    (draw/text [32 24 0] "RAYS     /     COMPUTATIONAL CARTOGRAPHY" :size 13 :color "#e1d8c0")
                    (draw/text [(- w 205.0) 26 0] "PLATE 001     /     SOURCE" :size 10 :color "#818976")
                    (draw/line [32 56 0] [(- w 32.0) 56 0] :color "#363e33" :width 1.0)
                    ruler
                    (draw/translate [(if (> p.sidebar 0.0) 0.0 100000.0) 0 0] sidebar)
                    (draw/line [32 p.top 0] [(- w 32.0) p.top 0] :color "#363e33" :width 1.0)
                    (draw/line [split (+ p.top 15.0) 0] [split (- h 28.0) 0] :color "#363e33" :width 1.0)
                    inspector
                    (draw/text [left_x (+ p.top 94.0) 0] "LEAF DENSITY FOLLOWS SOURCE SPAN" :size 10 :color "#818976"))]
      (draw/merge (draw/background "#0f1312") art
                  ; Flat ink covers what the art's clip would cut.
                  (draw/rect [0 0 0] [w 74 0] :fill "#0f1312")
                  (draw/rect [0 p.bottom 0] [w (- h p.bottom) 0] :fill "#0f1312")
                  (draw/rect [0 0 0] [24 h 0] :fill "#0f1312")
                  (draw/rect [p.right 0 0] [(- w p.right) h 0] :fill "#0f1312")
                  ; H hides the overlay by moving it off the canvas: the drawing keeps one shape.
                  (draw/translate [0 (if view.ui 0.0 100000.0) 0] chrome))))

  (graph profile :context host (table/load "../_out/source_atlas/profile.tsv"))

  (graph actions :context host
    (list (host/save_png "_out/source-atlas.png" (key/down "s"))
          (host/quit (key/down "escape"))))

  (graph settings :context settings (settings/config :title "Rays / Source Strata" :width 1440 :height 1000))
  (graph editor :context editor (ui/workspace (ui/canvas (ref picture) :focus true) :effects (ref actions))))
