; Source Ledger: every symbol of the repository in reading order, one tick each. A crate starts a
; new line, a file leaves a gap, a tick's height is its source span, and the sheet reads like a
; page of text whose words are functions.
; Generate first: tools/source_atlas_index
; Run: cargo run -p rays_bin -- sketches/source_ledger.rays
; Scroll zooms at the pointer, drag pans, R or Space resets, C changes the inks, S saves
; _out/source-ledger.png, Escape quits.
(workspace source_ledger
  (graph data :context host (table/load "../_out/source_atlas/atlas.tsv"))
  (graph crates :context host (table/load "../_out/source_atlas/crates.tsv"))

  ; The sheet is 1000 by 1300 units, as large as the window allows: `u` points a unit, its corner
  ; at (x, y). The field of ticks is 776 by 1020 units from (118, 128).
  (defn sheet :context value [(w : float) (h : float)]
    (let* [u (min (/ w 1000.0) (/ h 1300.0)) x (* (- w (* 1000.0 u)) 0.5) y (* (- h (* 1300.0 u)) 0.5)]
      {:u u :x x :y y :left (+ x (* 118.0 u)) :top (+ y (* 128.0 u)) :right (+ x (* 894.0 u)) :bottom (+ y (* 1148.0 u))
       :ox (+ x (* 506.0 u)) :oy (+ y (* 638.0 u))}))

  ; The whole layout, once: the fewest columns at which every crate's lines fit the field, a
  ; tick's cell nine fifths as tall as it is wide, and every tick's place in field units.
  (graph field :context host [(initial_zoom : float 1.0) (center : vec3 [388.0 510.0 0.0])]
    (let* [d (ref data) crate (ref crates)
           ids (array/range (array/count d.kind) :type int)
           leaves (filter (fn [(i : int)] (= (array/nth d.kind i) 5)) ids)
           leaf_ids (array/range (array/count leaves) :type int)
           crate_ids (array/range (array/count crate.cells) :type int)
           cells (exact (map (fn [(c : int)] (int (array/nth crate.cells c))) crate_ids))
           lines_at (fn [(cols : int)] (sum [c crate_ids] (int/div (int/add (array/nth cells c) (int/sub cols 1)) cols)))
           ; ponytail: columns from 24 in twos up to 1022; a repository of a million symbols needs more.
           cols (fold [best 1022] [k (range 500)]
                      (let* [n (int/add 24 (int/mul k 2))]
                        (if (and (= best 1022) (<= (* (float (lines_at n)) (* 1.8 (/ 776.0 (float n)))) 1020.0)) n best)))
           pitch (/ 776.0 (float cols)) drop (* 1.8 pitch)
           rows (exact (map (fn [(c : int)] (int/div (int/add (array/nth cells c) (int/sub cols 1)) cols)) crate_ids))
           start (array/scan_sum rows)]
      {:leaves leaves :pitch pitch :drop drop :start start :rows rows :zoom initial_zoom :center center
       :lines (int (array/sum rows))
       ; A tick as [x y height]: centred in its cell's drop, a one-line symbol a dash.
       :tick (exact (map (fn [(j : int)]
                           (let* [i (array/nth leaves j) cell (array/nth d.cell i)
                                  height (* (* drop 0.78) (+ 0.16 (* 0.84 (min 1.0 (sqrt (/ (float (array/nth d.mass i)) 40.0))))))]
                             [(* (float (int/mod cell cols)) pitch)
                              (+ (* (float (int/add (array/nth start (array/nth d.crate i)) (int/div cell cols))) drop) (* (- drop height) 0.5))
                              height])) leaf_ids))}))

  ; A tick's ink: blues for a function, a method and a field, grey for the rest; a span of 40
  ; lines is orange and one over 70 red. Or greys, the long spans in black and red.
  (defn tone :context value [(palette : int) (lsp : int) (span : int)]
    (if (= palette 1)
        (cond (> span 70) [0.878 0.196 0.169] (>= span 40) [0.082 0.094 0.110] (or (= lsp 12) (= lsp 6)) [0.247 0.275 0.302] (= lsp 8) [0.545 0.576 0.604] :else [0.749 0.773 0.788])
        (cond (> span 70) [0.878 0.196 0.169] (>= span 40) [0.933 0.482 0.212] (= lsp 12) [0.106 0.310 0.769] (= lsp 6) [0.239 0.525 0.875] (= lsp 8) [0.553 0.741 0.922] :else [0.604 0.635 0.663])))

  ; The camera over the field: [centre x, centre y, zoom], eased to its target. The wheel turns
  ; about the point under the pointer, which stays there on every frame of the way.
  (graph view :context host
    (let* [f (ref field)
           s (sheet (float (frame/width)) (float (frame/height)))
           input (frame/input)]
      (state [old {:cx f.center.x :cy f.center.y :zoom f.zoom :tx f.center.x :ty f.center.y :tz f.zoom :px 0.0 :py 0.0 :palette 0 :key false}]
        (let* [px (pointer/x) py (pointer/y)
               inside (and (and (>= px s.left) (< px s.right)) (and (>= py s.top) (< py s.bottom)))
               ax (+ old.tx (/ (- px s.ox) (* s.u old.tz)))
               ay (+ old.ty (/ (- py s.oy) (* s.u old.tz)))
               wheel (fold [v 0.0] [event input.events]
                           (+ v (case event.kind "scrolled" (* event.delta.y 0.17)
                                                 "trackpad-scrolled" (* event.delta.y 0.012)
                                                 "pinched" (log (max 0.01 event.scale)) :else 0.0)))
               reset (or (key/down "r") (key/down "space"))
               key (key/down "c")
               dx (- px old.px) dy (- py old.py)
               pan (and (and (or (pointer/down) (pointer/down "middle")) inside) (or (not (= dx 0.0)) (not (= dy 0.0))))
               wheel_zoom (max 1.0 (min 32.0 (* old.tz (exp wheel))))
               zoomed (and inside (not (= wheel 0.0)))
               tz (cond reset 1.0 zoomed wheel_zoom :else old.tz)
               slide_x (if pan (/ dx (* s.u old.zoom)) 0.0)
               slide_y (if pan (/ dy (* s.u old.zoom)) 0.0)
               tx (cond reset 388.0 zoomed (- (- ax (/ (- px s.ox) (* s.u wheel_zoom))) slide_x) :else (- old.tx slide_x))
               ty (cond reset 510.0 zoomed (- (- ay (/ (- py s.oy) (* s.u wheel_zoom))) slide_y) :else (- old.ty slide_y))
               ease (- 1.0 (exp (* -11.0 (max 0.0 (min 0.1 (frame/dt))))))
               ; easing the centre and 1/zoom by one factor keeps the anchored point under the pointer
               zoom (if (< (abs (- tz old.zoom)) (* 0.00001 tz)) tz
                        (/ 1.0 (+ (/ 1.0 old.zoom) (* (- (/ 1.0 tz) (/ 1.0 old.zoom)) ease))))
               near (/ 0.001 tz)
               cx (if (< (abs (- tx old.cx)) near) tx (+ old.cx (* (- tx old.cx) ease)))
               cy (if (< (abs (- ty old.cy)) near) ty (+ old.cy (* (- ty old.cy) ease)))]
          {:cx cx :cy cy :zoom zoom :tx tx :ty ty :tz tz :px px :py py
           :palette (if (and key (not old.key)) (int/sub 1 old.palette) old.palette) :key key}))))

  ; A count with its thousands apart, up to 999,999.
  (defn grouped :context value [(n : int)]
    (if (< n 1000) (str n) (str (int/div n 1000) "," (if (< (int/mod n 1000) 100) "0" "") (if (< (int/mod n 1000) 10) "0" "") (int/mod n 1000))))

  ; The sheet's lettering in Departure Mono, set from a baseline in sheet units; `s` is [x y u].
  (defn mono :context draw [(s : vec3) (x : float) (y : float) (label : text) (size : float) (align : text) (mute : bool)]
    (draw/text [(+ s.x (* s.z x)) (+ s.y (* s.z (- y (* size 0.82)))) 0.0] label :size (int (max 5.0 (round (* s.z size))))
               :color (if mute "#6b7278" "#15181c") :font "departure" :align align))

  (graph picture :context draw
    (let* [d (ref data) crate (ref crates) f (ref field) view (ref view)
           w (float (frame/width)) h (float (frame/height))
           p (sheet w h)
           u p.u s [p.x p.y p.u]
           scale (* u view.zoom)
           cam [(- p.ox (* view.cx scale)) (- p.oy (* view.cy scale)) scale]
           lim [p.left p.top p.right p.bottom]
           palette view.palette
           ticks f.tick
           tick_ids (array/range (array/count ticks) :type int)
           wide (* (* f.pitch 0.64) scale)
           mark_at (map (fn [(j : int)] (let* [q (array/nth ticks j)] [(+ cam.x (* q.x cam.z)) (+ cam.y (* q.y cam.z)) 0.0])) tick_ids)
           mark_size (map (fn [(j : int)]
                            (let* [q (array/nth ticks j) x (+ cam.x (* q.x cam.z)) y (+ cam.y (* q.y cam.z)) tall (* q.z cam.z)]
                              (if (and (and (>= (+ x wide) lim.x) (< x lim.z)) (and (>= (+ y tall) lim.y) (< y lim.w))) [wide tall 0.0] [0.0 0.0 0.0]))) tick_ids)
           mark_fill (map (fn [(j : int)] (let* [i (array/nth f.leaves j)] (tone palette (array/nth d.lsp i) (array/nth d.mass i)))) tick_ids)

           ; A crate of 2,500 lines and two rows or more is named in the margin, beside its first row.
           ; ponytail: 96 crates.
           names (for [k (range 96)]
                   (let* [c (int (min k (int/sub (array/count crate.cells) 1)))
                          y (+ cam.y (* (* (+ (float (array/nth f.start c)) 0.5) f.drop) cam.z))
                          on (and (and (< k (array/count crate.cells)) (and (>= (array/nth f.rows c) 2) (> (array/nth crate.lines c) 2500)))
                                  (and (>= y (+ p.top (* 3.0 u))) (< y (- p.bottom (* 3.0 u)))))]
                     (draw/text [(- p.left (* 10.0 u)) (- y (* 4.5 u)) 0.0] (if on (array/nth crate.name c) "")
                                :size (int (max 5.0 (round (* 7.0 u)))) :color "#6b7278" :font "departure" :align "right")))
           foot (+ (+ 128.0 (* (float f.lines) f.drop)) 44.0)
           key (fn [(x : float) (label : text) (n : int)]
                 (draw/merge
                   (draw/rect [(+ p.x (* u (+ 118.0 x))) (+ p.y (* u (- foot 9.0))) 0.0] [(* 4.0 u) (* 10.0 u) 0.0]
                              :fill (if (= palette 1) (case n 0 "#3f464d" 1 "#3f464d" 2 "#8b939a" 3 "#bfc5c9" 4 "#15181c" :else "#e0322b")
                                        (case n 0 "#1b4fc4" 1 "#3d86df" 2 "#8dbdeb" 3 "#9aa2a9" 4 "#ee7b36" :else "#e0322b")))
                   (mono s (+ 128.0 x) foot label 11.0 "left" true)))]
      (draw/merge
        (draw/background "#fdfdfc")
        (draw/rects mark_at mark_size :fill mark_fill)
        ; Flat paper covers what the field's clip would cut.
        (draw/rect [0 0 0] [w p.top 0] :fill "#fdfdfc")
        (draw/rect [0 p.bottom 0] [w (- h p.bottom) 0] :fill "#fdfdfc")
        (draw/rect [0 0 0] [p.left h 0] :fill "#fdfdfc")
        (draw/rect [p.right 0 0] [(- w p.right) h 0] :fill "#fdfdfc")
        names
        (mono s 118.0 70.0 "SOURCE LEDGER" 22.0 "left" false)
        (mono s 118.0 92.0 (str (grouped (array/count ticks)) " SYMBOLS IN READING ORDER / ONE TICK EACH") 11.0 "left" true)
        (mono s 894.0 70.0 "PLATE 002" 11.0 "right" false)
        (key 0.0 "FUNCTION" 0)
        (key 86.8 "METHOD" 1)
        (key 160.4 "FIELD" 2)
        (key 227.4 "OTHER" 3)
        (key 294.4 "40+ LINES" 4)
        (key 387.8 "70+ LINES" 5)
        (mono s 118.0 (+ foot 24.0) "A NEW LINE IS A CRATE / A GAP IS A FILE / HEIGHT IS SPAN" 11.0 "left" true)
        (mono s 894.0 (+ foot 24.0) "rays / 13.11.26" 11.0 "right" false))))

  (graph actions :context host
    (list (host/save_png "_out/source-ledger.png" (key/down "s"))
          (host/quit (key/down "escape"))))

  (graph settings :context settings (settings/config :title "Rays / Source Ledger" :width 770 :height 1000))
  (graph editor :context editor (ui/workspace (ui/canvas (ref picture) :focus true) :effects (ref actions))))
