; # flow_contours
;
; A contour map typed in glyphs, every pixel computed by a Rays Lisp kernel on the GPU lane.
;
; One animated height field, `(noise3 [x y drift])`, is read two ways. `lines` reads it per pixel
; and draws the levels as lines about a pixel wide (the distance to the level divided by a
; one-pixel finite difference of the height). `glyph` reads it once per cell of the grid and
; marks the cells inside one contour band: `x` on the outermost, then dots, `0` and `1`, and solid
; blocks innermost. A glyph is a box, a ring or two diagonals of the cell-local distances, so
; there is no font and no texture.
;
; A cell's glyph is chosen by a hash of the cell index, not of the height, so a glyph only
; appears or leaves as a contour passes over its cell and never flickers between kinds.
;
; The picture is six kernels composited by alpha (`contours`, `xs`, `dots`, `zeros`, `ones`,
; `blocks`); together they would not fit one 64-register packed program.
;
; The dataflow is `speed`, `scale`, `cell`, `levels`, `base` -> `field` -> six layers -> `result`.
; The value cards at the left are the controls, scrubbed in place: `speed` is the drift, `scale`
; the blob size (smaller is bigger), `cell` the side of a glyph cell in pixels, `levels` the
; contour density, `base` the height of the outermost contour. `field` is the one record every
; layer reads; its `width` and `height` are `(frame/width)` and `(frame/height)`, so the picture
; fills its canvas pane at any size, and its `columns` and `rows` follow from `cell`.
; Select a layer chip to edit its rows in
; the inspector: `level` (which band it follows), `share_from`..`share_to` (the share of cells
; marked), its shape (`narrow`, `radius`, `stroke`, `diagonal`) and `grey`.
; Run: `dune exec sketches/flow_contours/main.exe`.

(workspace flow_contours

  ; A contour map typed in glyphs, every pixel computed by a Lisp kernel on the GPU.
  ; One height field, (noise3 [x y drift]) in units of a grid of square cells, is read
  ; two ways: per pixel for the contour lines, and once per cell (x quantized without floor:
  ; cell = x - mod x 1) to decide which cells carry a glyph.
  ; Each layer is its own kernel: all of them in one would not fit the 64 registers.
  ; Dataflow: speed, scale, cell, levels, base -> field -> six layers -> result.
  ; A glyph in every cell whose height sits in contour band `level` (0 is the outermost) and
  ; whose own hash, a noise of the cell index that never changes with time, falls in
  ; share_from..share_to.  With a b the distances from the cell centre, the shape is
  ; |max(a narrow, b) - radius| < stroke   and   |a - b| < diagonal
  ; so radius 0 is a box, a radius is a ring, and a small diagonal keeps only an x.
  (defmacro glyph [field level share_from share_to narrow radius stroke diagonal grey]
    `(let* [field# ~field]
       (draw/image (image/map (fn [uv#]
                                (let* [one# 1.0
                                       half# 0.5
                                       spread# 0.37
                                       x# (* uv#.x field#.columns)
                                       y# (* uv#.y field#.rows)
                                       in_x# (mod x# one#)
                                       in_y# (mod y# one#)
                                       cell_x# (- x# in_x#)
                                       cell_y# (- y# in_y#)
                                       height# (noise3 [(* (+ cell_x# half#) field#.scale) (* (+ cell_y# half#) field#.scale) field#.drift]
                                                       :octaves 2)
                                       band# (- (- (* height# field#.levels) field#.base)
                                                ~level)
                                       hash# (mod (* 61
                                                     (noise3 [(* cell_x# spread#) (* cell_y# spread#) half#]))
                                                  one#)
                                       a# (abs (- in_x# half#))
                                       b# (abs (- in_y# half#))
                                       chosen# (and (< (abs (- band# half#)) 0.4)
                                                    (and (> hash# ~share_from)
                                                         (< hash# ~share_to)))
                                       inside# (and (< (abs (- (max (* a# ~narrow) b#) ~radius))
                                                       ~stroke)
                                                    (< (abs (- a# b#)) ~diagonal))
                                       grey# ~grey]
                                  [grey# grey# grey# (if (and chosen# inside#) one# 0.0)]))
                              :width field#.width
                              :height field#.height)
                   :at [0 0 0])))

  ; Contour lines at the count + 1 levels from field.base up, about a pixel wide whatever the
  ; slope: the distance to the level is divided by a one-pixel finite difference of the height.
  (defmacro lines [field count grey]
    `(let* [field# ~field]
       (draw/image (image/map (fn [uv#]
                                (let* [one# 1.0
                                       half# 0.5
                                       pixel# (/ (* field#.scale field#.columns)
                                                 field#.width)
                                       x# (* (* uv#.x field#.columns) field#.scale)
                                       y# (* (* uv#.y field#.rows) field#.scale)
                                       height# (noise3 [x# y# field#.drift] :octaves 2)
                                       slope_x# (- (noise3 [(+ x# pixel#) y# field#.drift]
                                                           :octaves 2)
                                                   height#)
                                       slope_y# (- (noise3 [x# (+ y# pixel#) field#.drift]
                                                           :octaves 2)
                                                   height#)
                                       band# (- (* height# field#.levels) field#.base)
                                       to_level# (abs (- (mod (+ band# half#) one#) half#))
                                       pixels# (/ to_level#
                                                  (* field#.levels
                                                     (sqrt (+ (* slope_x# slope_x#)
                                                              (* slope_y# slope_y#)))))
                                       grey# ~grey]
                                  [grey# grey# grey# (if (and (> band# (- 0 half#)) (< band# (+ ~count half#))) (max 0 (- one# (* pixels# 0.8))) 0.0)]))
                              :width field#.width
                              :height field#.height)
                   :at [0 0 0])))

  (graph picture :context draw
    (let* [
           ; how fast the field drifts
           speed 0.02
           ; blob size: smaller is bigger
           scale 0.05
           ; side of a glyph cell, in pixels
           cell 12.5
           ; contour density
           levels 48.0
           ; height of the outermost contour
           base 24.0
           ; the one height field every layer reads, and the picture it is drawn on: the
           ; whole viewport, cut into square cells
           field {:width (float (frame/width))
                  :height (float (frame/height))
                  :columns (/ (frame/width) cell)
                  :rows (/ (frame/height) cell)
                  :drift (* t speed)
                  :scale scale
                  :levels levels
                  :base base}
           background (draw/background "#0f0f11")
           contours (lines field 4 0.36)
           xs (glyph field 0 0.2 1 1 0 0.3 0.09 0.85)
           dots (glyph field 1 0.3 1 1 0 0.09 1 0.8)
           zeros (glyph field 2 0 0.4 1.4 0.27 0.07 1 0.9)
           ones (glyph field 2 0.4 0.6 4.5 0 0.32 1 0.9)
           blocks (glyph field 3 0.5 1 1 0 1 1 0.95)]
      (draw/merge background contours xs dots zeros ones blocks)))

  (graph settings :context settings
    (settings/config :title "Contours in glyphs, on the GPU"
                     :width 1500
                     :height 900))

  (graph scene :context scene
    (let* [camera (scene/camera :eye [4 5 5] :target [0 0 0])
           light (scene/light :translate [0 5 3] :intensity 50)]
      (scene/root (scene/merge camera light) :camera camera)))

  (graph editor :context editor
    (let* [preview (if true (ui/canvas (ref picture)) (ui/viewport (ref scene)))
           network (ui/graph "picture" :focus true)
           inspector (ui/inspector :of network)
           outline (ui/outline)
           network_dock (ui/split-at "horizontal" 0.5 outline network)
           split_at (ui/split "horizontal"
                              preview
                              (ui/split "horizontal"
                                        network_dock
                                        inspector
                                        :second_size 260)
                              :second_size 880)]
      (ui/workspace split_at))))

(layout (panel ["editor" "network"] :collapsed false)
        (panel ["editor" "outline"] :collapsed false)
        (node ["picture" "blocks"] :level "chip")
        (node ["picture" "contours"] :level "chip")
        (node ["picture" "dots"] :level "chip")
        (node ["picture" "ones"] :level "chip")
        (node ["picture" "xs"] :level "chip")
        (node ["picture" "zeros"] :level "chip"))
