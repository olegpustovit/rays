#!/usr/bin/env python3
"""Index source files with rust-analyzer documentSymbol; Python stdlib only.

Run tools/source_atlas_index, then rays sketches/source_atlas.rays.
Only the small fixture table is committed. Real output/cache live in _out/.
"""
import argparse
import hashlib
import json
import math
import os
from pathlib import Path
import queue
import subprocess
import sys
import threading
import time

EXTENSIONS = {'.rs'}
EXCLUDED = {'.git', 'target', '_out', '_build', '_opam', 'node_modules', 'vendor', 'fixtures', 'history'}
COLUMNS = [('parent', 'int'), ('x', 'float'), ('y', 'float'), ('size', 'float'), ('kind', 'int'), ('group', 'int'), ('depth', 'int'), ('child', 'int'), ('count', 'int'), ('owner', 'int'), ('file', 'int'), ('lsp', 'int'), ('first', 'int'), ('last', 'int'), ('mass', 'int'), ('seed', 'int'), ('bytes', 'int'), ('crate', 'int'), ('cell', 'int'), ('cells', 'int'), ('level', 'int'), ('top', 'int'), ('label', 'text'), ('tag', 'text'), ('path', 'text'), ('l0', 'text'), ('l1', 'text'), ('l2', 'text'), ('chars', 'int')]
# `crate` is a row of crates.tsv, whose `ax`, `ay` is the corner of the crate's longest file. `cell` is a leaf's place in its crate's reading order, one cell
# skipped between files; a file or a scope has the `cell` of its first leaf and the `cells` to its last, and `level` counts the scopes
# around a symbol. `top` is the lines of the longer files of a file's crate.
CRATES = [('x0', 'float'), ('y0', 'float'), ('x1', 'float'), ('y1', 'float'), ('ax', 'float'), ('ay', 'float'), ('files', 'int'), ('lines', 'int'), ('cells', 'int'), ('chars', 'int'), ('name', 'text'), ('title', 'text'), ('rank', 'int')]
# A number comes last: a row never ends in the tab of an empty text cell.
# Node kinds: the file quadtree, then each indexed file's nested symbol field.
BRANCH, FILE, HOLLOW, PACK, SCOPE, LEAF, EMPTY = range(7)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def seed(text):
    h = 216613626
    for c in text.encode():
        h = ((h ^ c) * 16777619) & 0x3fffffff
    return h


class Lsp:
    def __init__(self, executable, root, files, timeout):
        self.timeout = timeout
        self.serial = 0
        self.messages = queue.Queue()
        self.process = subprocess.Popen([executable], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        threading.Thread(target=self.read, daemon=True).start()
        # Detached files need no Cargo workspace, build or sysroot: documentSymbol is syntactic.
        options = {'linkedProjects': [], 'detachedFiles': [str(f) for f in files], 'checkOnSave': False, 'cargo': {'buildScripts': {'enable': False}, 'sysroot': None}, 'procMacro': {'enable': False}}
        self.request('initialize', {'processId': os.getpid(), 'rootUri': root.as_uri(), 'capabilities': {'textDocument': {'documentSymbol': {'hierarchicalDocumentSymbolSupport': True}}}, 'initializationOptions': options})
        self.send('initialized', {})

    def read(self):
        try:
            while True:
                length = None
                while True:
                    line = self.process.stdout.readline()
                    if not line:
                        raise EOFError('rust-analyzer closed its output')
                    if line == b'\r\n':
                        break
                    key, value = line.decode().split(':', 1)
                    if key.lower() == 'content-length':
                        length = int(value)
                if length is None or length > 64 * 1024 * 1024:
                    raise ValueError('invalid LSP content length')
                payload = bytearray()
                while len(payload) < length:
                    chunk = self.process.stdout.read(length - len(payload))
                    if not chunk:
                        raise EOFError('truncated LSP message')
                    payload.extend(chunk)
                self.messages.put(json.loads(payload))
        except Exception as error:
            self.messages.put(error)

    def send(self, method, params, request_id=None):
        message = {'jsonrpc': '2.0', 'method': method, 'params': params}
        if request_id is not None:
            message['id'] = request_id
        payload = json.dumps(message, ensure_ascii=False).encode()
        self.process.stdin.write(f'Content-Length: {len(payload)}\r\n\r\n'.encode() + payload)
        self.process.stdin.flush()

    def request(self, method, params):
        self.serial += 1
        request_id = self.serial
        self.send(method, params, request_id)
        deadline = time.monotonic() + self.timeout
        while True:
            message = self.messages.get(timeout=max(0, deadline - time.monotonic()))
            if isinstance(message, Exception):
                raise message
            if message.get('id') != request_id:
                continue
            if 'error' in message:
                raise RuntimeError(f'{method}: {message["error"]}')
            return message.get('result')

    def symbols(self, path, text):
        uri = path.as_uri()
        self.send('textDocument/didOpen', {'textDocument': {'uri': uri, 'languageId': 'rust', 'version': 1, 'text': text}})
        try:
            # null means the server has not loaded the file yet (an empty file answers []), and
            # ContentModified asks to retry: neither is ever a result, so neither is ever cached.
            deadline = time.monotonic() + self.timeout
            while True:
                try:
                    result = self.request('textDocument/documentSymbol', {'textDocument': {'uri': uri}})
                    if result is not None:
                        return result
                except RuntimeError as error:
                    if '-32801' not in str(error):
                        raise
                if time.monotonic() > deadline:
                    raise RuntimeError(f'{path}: rust-analyzer never answered documentSymbol')
                time.sleep(0.05)
        finally:
            self.send('textDocument/didClose', {'textDocument': {'uri': uri}})

    def close(self):
        self.process.terminate()
        try:
            self.process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait()
        self.process.stdin.close()
        self.process.stdout.close()


def sources(root):
    for directory, dirs, files in os.walk(root, followlinks=False):
        dirs[:] = sorted(d for d in dirs if d not in EXCLUDED and not d.startswith('.') and not (Path(directory) / d).is_symlink())
        for name in sorted(files):
            path = Path(directory) / name
            if not path.is_symlink() and path.suffix in EXTENSIONS:
                yield path


def group(path):
    if '/tests/' in '/' + path or '/test_' in '/' + path:
        return 1
    if path.startswith('sketches/'):
        return 2
    if '/examples/' in '/' + path or '/pxui_gallery/' in path:
        return 3
    if path.startswith('pxui/crates/open/'):
        return 4
    return 0


def crate_name(root, path, known):
    """The directory of the nearest Cargo.toml under the root, else the one above src, tests, examples or benches."""
    parts = path.split('/')[:-1]
    for n in range(len(parts), 0, -1):
        directory = '/'.join(parts[:n])
        if directory not in known:
            known[directory] = (root / directory / 'Cargo.toml').is_file()
        if known[directory]:
            return parts[n - 1]
    for n, part in enumerate(parts):
        if part in ('src', 'tests', 'examples', 'benches') and n > 0:
            return parts[n - 1]
    return parts[0] if parts else 'source'


def crates(files, root_node):
    """Number the crates in path order and place every leaf and file within its crate."""
    names = list(dict.fromkeys(f['crate'] for f in files))
    rows = [{'name': name, 'title': name.upper().replace('_', ' '), 'chars': len(name), 'x0': 1.0, 'y0': 1.0, 'x1': 0.0, 'y1': 0.0, 'files': 0, 'lines': 0, 'cells': 0} for name in names]
    nodes = {}

    def visit(node, file, level):
        if node['kind'] in (FILE, HOLLOW):
            file = node['file']
            nodes[file] = {'node': node, 'leaves': [], 'groups': [node]}
        if file is not None:
            node['crate'] = names.index(files[file]['crate'])
            if node['kind'] in (SCOPE, LEAF):
                node['level'] = level
            if node['kind'] == LEAF:
                nodes[file]['leaves'].append(node)
            if node['kind'] == SCOPE:
                nodes[file]['groups'].append(node)
        for child in node['children']:
            visit(child, file, level + (node['kind'] == SCOPE))

    def leaves_under(node):
        return [node] if node['kind'] == LEAF else [leaf for child in node['children'] for leaf in leaves_under(child)]

    visit(root_node, None, 0)
    for k, row in enumerate(rows):
        members = [n for n, f in enumerate(files) if f['crate'] == row['name']]
        for n in members:
            node = nodes[n]['node']
            if row['files']:
                row['cells'] += 1
            for leaf in sorted(nodes[n]['leaves'], key=lambda leaf: (leaf['first'], leaf['label'])):
                leaf['cell'] = row['cells']
                row['cells'] += 1
            for group in nodes[n]['groups']:
                held = [leaf['cell'] for leaf in leaves_under(group)]
                if held:
                    group['cell'], group['cells'] = min(held), max(held) - min(held) + 1
            row['files'] += 1
            row['x0'], row['y0'] = min(row['x0'], node['x']), min(row['y0'], node['y'])
            row['x1'], row['y1'] = max(row['x1'], node['x'] + node['size']), max(row['y1'], node['y'] + node['size'])
        for n in sorted(members, key=lambda n: (-len(files[n]['lines']), files[n]['path'])):
            if not row['lines']:
                row['ax'], row['ay'] = nodes[n]['node']['x'], nodes[n]['node']['y']
            nodes[n]['node']['top'] = row['lines']
            row['lines'] += max(1, len(files[n]['lines']))
    for rank, k in enumerate(sorted(range(len(rows)), key=lambda k: (-rows[k]['lines'], rows[k]['name']))):
        rows[k]['rank'] = rank
    return rows


def span(symbol, path, count):
    r = symbol.get('range', symbol.get('location', {}).get('range'))
    if r is None:
        raise ValueError(f'{path}: symbol has no range')
    first = r['start']['line'] + 1
    last = r['end']['line'] + (r['end']['character'] > 0)
    if not 1 <= first <= max(1, count) or last < first or last > max(1, count):
        raise ValueError(f'{path}: invalid symbol span {first}:{last}')
    return first, last


def cut(weights, a, b, target):
    while a < b:
        mid = (a + b) // 2
        if weights[mid] < target:
            a = mid + 1
        else:
            b = mid
    return a


def quadrants(weights, ratios, lo, hi, turn):
    """Unequal, rotated quadrant budgets over prefix weights; every item lands in exactly one."""
    n = min(4, hi - lo)
    cursor, fraction = lo, 0.0
    for i in range(n):
        fraction += ratios[i]
        limit = hi - (n - i - 1)
        target = weights[lo] + fraction * (weights[hi] - weights[lo])
        end = hi if i == n - 1 else max(cursor + 1, min(limit, cut(weights, cursor, hi, target)))
        q = (i + turn) % 4
        yield cursor, end, q % 2, q // 2
        cursor = end


def common_label(files, lo, hi):
    a, b = files[lo]['path'], files[hi - 1]['path']
    prefix = os.path.commonprefix([a, b])
    return prefix[:prefix.rindex('/') + 1] if '/' in prefix else 'source'


def file_tree(files):
    weights = [0.0]
    for f in files:
        weights.append(weights[-1] + 1 + math.sqrt(len(f['lines'])))

    def make(x, y, size, lo, hi, depth):
        if hi - lo == 1:
            f = files[lo]
            node = {'x': x, 'y': y, 'size': size, 'kind': HOLLOW if f['symbols'] is None else FILE, 'depth': depth, 'children': [], **f['row']}
            if f['symbols'] is not None:
                inset = size * 0.025
                node['children'] = [scope(f, x + inset, y + inset, size - 2 * inset, f['symbols'])]
            return node
        label = common_label(files, lo, hi)
        turn = (seed(files[lo]['path']) ^ (hi - lo)) % 4
        children = [make(x + qx * size / 2, y + qy * size / 2, size / 2, a, b, depth + 1)
                    for a, b, qx, qy in quadrants(weights, (0.07, 0.15, 0.29, 0.49), lo, hi, turn)]
        return {'x': x, 'y': y, 'size': size, 'kind': BRANCH, 'depth': depth, 'children': children, 'label': label, 'group': group(label)}

    return make(0.0, 0.0, 1.0, 0, len(files), 0)


def scope(f, x, y, size, symbols):
    """One file's nested symbols: the same weighted packing, named scopes inset inside their symbol."""
    count = len(f['lines'])
    items = sorted(symbols, key=lambda s: (span(s, f['path'], count)[0], s['name']))
    weights = [0.0]
    for s in items:
        first, last = span(s, f['path'], count)
        weights.append(weights[-1] + math.sqrt(last - first + 1))

    def pack(x, y, size, lo, hi):
        base = {'x': x, 'y': y, 'size': size, 'group': f['row']['group'], 'path': f['path'], 'file': f['row']['file']}
        if hi == lo:
            return {**base, 'kind': EMPTY, 'children': [], 'seed': seed(f['path'])}
        if hi - lo == 1:
            s = items[lo]
            first, last = span(s, f['path'], count)
            inner = s.get('children', [])
            children = [scope(f, x + size * 0.08, y + size * 0.08, size * 0.84, inner)] if inner else []
            return {**base, 'kind': SCOPE if inner else LEAF, 'children': children, 'lsp': s['kind'], 'first': first, 'last': last,
                    'mass': last - first + 1, 'seed': seed(s['name']), 'label': s['name'], 'tag': s['name'] if len(s['name']) <= 14 else s['name'][:12] + '..', **preview(f['lines'], first, last)}
        children = [pack(x + qx * size / 2, y + qy * size / 2, size / 2, a, b)
                    for a, b, qx, qy in quadrants(weights, (0.10, 0.18, 0.29, 0.43), lo, hi, seed(items[lo]['name']) % 4)]
        return {**base, 'kind': PACK, 'children': children}

    return pack(x, y, size, 0, len(items))


def preview(lines, first, last):
    rows = [line.replace('\t', '    ')[:132] for line in lines[first - 1:min(last, first + 2)]]
    return {'l' + str(i): rows[i] if i < len(rows) else '' for i in range(3)}


def table_rows(root):
    """Breadth-first rows: a node's children are contiguous and follow it."""
    rows, pending = [], [(root, 0, 0)]
    while pending:
        following = []
        for node, parent, owner in pending:
            i = len(rows)
            owner = i if node['kind'] <= HOLLOW else owner
            rows.append({'parent': parent, 'owner': owner, **node})
            following.extend((child, i, owner) for child in node['children'])
        pending = following
    cursor = 1
    for row in rows:
        row['child'], row['count'] = cursor, len(row.pop('children'))
        cursor += row['count']
    return rows


def escape(value):
    return str(value).replace('\\', '\\\\').replace('\t', '\\t').replace('\n', '\\n').replace('\r', '\\r')


def write_table(path, columns, rows):
    path.parent.mkdir(parents=True, exist_ok=True)
    text = '\t'.join(name + ':' + kind for name, kind in columns) + '\n'
    text += ''.join('\t'.join(escape(row.get(name, 0 if kind == 'int' else '')) for name, kind in columns) + '\n' for row in rows)
    temporary = path.with_suffix(path.suffix + '.tmp')
    temporary.write_text(text, encoding='utf-8')
    temporary.replace(path)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument('--output', type=Path)
    parser.add_argument('--cache', type=Path)
    parser.add_argument('--lsp', default='rust-analyzer')
    parser.add_argument('--timeout', type=float, default=30)
    args = parser.parse_args()
    root = args.root.resolve()
    output = args.output or root / '_out/source_atlas/atlas.tsv'
    cache = args.cache or root / '_out/source_atlas/symbols'
    cache.mkdir(parents=True, exist_ok=True)
    version = subprocess.check_output([args.lsp, '--version'], text=True).strip()
    lsp = None
    files = []
    known = {}
    hits = 0
    try:
        found = sorted(sources(root), key=lambda p: p.relative_to(root).as_posix())
        for file in found:
            path = file.relative_to(root).as_posix()
            raw = file.read_bytes()
            text = raw.decode('utf-8')
            lines = text.splitlines()
            symbols = None
            if file.suffix == '.rs':
                key = digest(version.encode() + b'\0' + raw)
                saved = cache / (key + '.json')
                if saved.exists():
                    symbols = json.loads(saved.read_text())
                    hits += 1
                else:
                    if lsp is None:
                        lsp = Lsp(args.lsp, root, [f for f in found if f.suffix == '.rs'], args.timeout)
                    symbols = lsp.symbols(file, text)
                    temporary = saved.with_suffix('.tmp')
                    temporary.write_text(json.dumps(symbols, ensure_ascii=False), encoding='utf-8')
                    temporary.replace(saved)
            # `width` hashes a line to its number modulo 32 (the longest wins); `mean` cuts the file
            # into 32 slices, first line to last, and keeps each slice's mean line length.
            profile, total, held = [0] * 32, [0] * 32, [0] * 32
            for n, line in enumerate(lines):
                profile[n % 32] = max(profile[n % 32], min(120, len(line)))
                total[n * 32 // len(lines)] += len(line)
                held[n * 32 // len(lines)] += 1
            # a file under 32 lines leaves slices empty: each takes the line it would fall on
            mean = [round(t / c) if c else len(lines[b * len(lines) // 32]) if lines else 0 for b, (t, c) in enumerate(zip(total, held))]
            name = file.name
            row = {'group': group(path), 'file': len(files), 'first': 1, 'last': max(1, len(lines)), 'bytes': len(raw), 'label': name,
                   'tag': name if len(name) <= 26 else name[:23] + '...', 'chars': min(26, len(name)), 'path': path, **preview(lines, 1, len(lines))}
            files.append({'path': path, 'lines': lines, 'symbols': symbols, 'profile': profile, 'mean': mean, 'crate': crate_name(root, path, known), 'row': row})
        if not files:
            raise ValueError('no source files found')
        tree = file_tree(files)
        write_table(output.with_name('crates.tsv'), CRATES, crates(files, tree))
        rows = table_rows(tree)
        write_table(output, COLUMNS, rows)
        # Two 32-bin line-length profiles a file: row = file * 32 + bin.
        write_table(output.with_name('profile.tsv'), [('width', 'int'), ('mean', 'int')],
                    [{'width': w, 'mean': m} for f in files for w, m in zip(f['profile'], f['mean'])])
        symbols = sum(row['kind'] in (SCOPE, LEAF) for row in rows)
        print(f'{len(files)} files, {symbols} symbols, {len(rows)} nodes, {hits} cache hits -> {output}')
    finally:
        if lsp is not None:
            lsp.close()


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, queue.Empty, subprocess.SubprocessError) as error:
        sys.exit(f'source_atlas_index: {error or "rust-analyzer timed out"}')
