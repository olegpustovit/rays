(library
 (name sdl3_lock)
 (wrapped false)
 (modules sdl3_lock))

(library
 (name sdl3_discovery)
 (wrapped false)
 (modules sdl3_discovery)
 (libraries dune-configurator sdl3_lock unix))

(executable
 (name check_sdl3_conf)
 (modules check_sdl3_conf)
 (libraries dune-configurator sdl3_lock unix))

(rule
 (alias check_sdl3_conf)
 (deps
  ../../packaging/sdl3.lock
  ../../packaging/conf-sdl3/conf-sdl3.opam
  ../../packaging/conf-sdl3-image/conf-sdl3-image.opam
  ../../packaging/conf-sdl3-ttf/conf-sdl3-ttf.opam
  ../../packaging/conf-sdl3-mixer/conf-sdl3-mixer.opam)
 (action
  (progn
   (run %{exe:check_sdl3_conf.exe} --lock %{dep:../../packaging/sdl3.lock} sdl3)
   (run %{exe:check_sdl3_conf.exe} --lock %{dep:../../packaging/sdl3.lock} sdl3-image)
   (run %{exe:check_sdl3_conf.exe} --lock %{dep:../../packaging/sdl3.lock} sdl3-ttf)
   (run %{exe:check_sdl3_conf.exe} --lock %{dep:../../packaging/sdl3.lock} sdl3-mixer))))

(alias
 (name runtest)
 (deps (alias check_sdl3_conf)))

(executable
 (name installed_consumer)
 (modules installed_consumer)
 (libraries rays.sdl3 rays.sdl3_image rays.sdl3_ttf rays.sdl3_mixer))

(executable
 (name check_installed_consumer)
 (modules check_installed_consumer)
 (libraries sdl3_lock unix))

(executable
 (enabled_if (= %{system} macosx))
 (name check_sdl3_memory)
 (modules check_sdl3_memory)
 (libraries sdl3_lock unix))

(test
 (name check_runtime_licenses)
 (modules check_runtime_licenses)
 (libraries unix yojson)
 (deps ../../LICENSE ../../specification/licenses.md ../../specification/backend.md
  runtime_license_manifest.json
  (source_tree ../../lib/sdl3) (source_tree ../../lib/sdl3_image)
  (source_tree ../../lib/sdl3_ttf) (source_tree ../../lib/sdl3_mixer))
 (action (run %{test} --root %{workspace_root})))

(alias
 (name sdl3-memory-tests)
 (enabled_if (= %{system} macosx))
 (deps
