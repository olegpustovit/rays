#!/usr/bin/env python3
"""Small indexer regression: real rust-analyzer cold/warm runs and content invalidation."""
import csv
import json
from pathlib import Path
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
INDEX = ROOT / 'tools/source_atlas_index'
module = runpy.run_path(str(INDEX))
fixture = ROOT / 'fixtures/source_atlas'
with tempfile.TemporaryDirectory(prefix='rays-atlas-') as temporary:
    work = Path(temporary)
    output = work / 'atlas.tsv'
    command = [str(INDEX), '--root', str(fixture / 'tree'), '--output', str(output), '--cache', str(work / 'cache')]
    cold = subprocess.check_output(command, text=True)
    assert '32 files, 224 symbols, 302 nodes, 0 cache hits' in cold, cold
    for name in ('atlas.tsv', 'profile.tsv', 'crates.tsv', 'lines.tsv', 'chars.tsv'):
        assert (work / name).read_bytes() == (fixture / name).read_bytes(), f'{name}: fixture golden changed'
    # An unanswered request (null) is retried, never stored as a file without symbols.
    assert all(json.loads(saved.read_text()) for saved in (work / 'cache').iterdir()), 'an empty answer was cached'
    warm = subprocess.check_output(command, text=True)
    assert '32 cache hits' in warm, warm
    assert output.read_bytes() == (fixture / 'atlas.tsv').read_bytes(), 'warm output changed'
    rows = [{k.split(':')[0]: v for k, v in r.items()} for r in csv.DictReader(output.open(), delimiter='\t', quoting=csv.QUOTE_NONE)]
    n = lambda row, name: (float if name in ('x', 'y', 'size') else int)(row[name])
    assert len(rows) == 302 and sum(n(r, 'count') for r in rows) == 301, 'every node but the root is one child'
    files = [r['path'] for r in rows if n(r, 'kind') in (1, 2)]
    assert len(files) == len(set(files)) == 32, 'every file once'
    for i, row in enumerate(rows):
        first, count = n(row, 'child'), n(row, 'count')
        assert count <= 4 and (i == 0 or n(row, 'parent') < i), 'breadth-first rows'
        children = rows[first:first + count]
        for k, child in enumerate(children):
            assert n(child, 'parent') == i, 'children are contiguous'
            x, y, size = n(child, 'x'), n(child, 'y'), n(child, 'size')
            assert n(row, 'x') <= x and n(row, 'y') <= y and x + size <= n(row, 'x') + n(row, 'size') + 1e-12 and y + size <= n(row, 'y') + n(row, 'size') + 1e-12, 'child inside parent'
            for other in children[:k]:
                ox, oy, osize = n(other, 'x'), n(other, 'y'), n(other, 'size')
                assert x + size <= ox + 1e-12 or ox + osize <= x + 1e-12 or y + size <= oy + 1e-12 or oy + osize <= y + 1e-12, 'siblings overlap'
            if n(child, 'kind') in (4, 5) and n(row, 'kind') >= 3:
                scope = row
                while n(scope, 'kind') == 3:
                    scope = rows[n(scope, 'parent')]
                if n(scope, 'kind') == 4:
                    assert n(scope, 'first') <= n(child, 'first') <= n(child, 'last') <= n(scope, 'last'), 'symbol outside its scope'
    assert len((work / 'profile.tsv').read_text().splitlines()) == 1 + 32 * 32
    # Below every leaf symbol its lines tile the symbol: a row a line, the parts of a tile contiguous and covering it.
    below = [{k.split(':')[0]: v for k, v in r.items()} for r in csv.DictReader((work / 'lines.tsv').open(), delimiter='\t', quoting=csv.QUOTE_NONE)]
    for row in rows:
        if n(row, 'kind') == 5:
            first, count = n(row, 'sub'), n(row, 'subs')
            tree = below[first:first + count]
            assert sum(int(t['kind']) == 1 for t in tree) == min(64, n(row, 'last') - n(row, 'first') + 1), 'a row a line'
            assert [float(tree[0][k]) for k in 'xywh'] == [0.0, 0.0, 1.0, 1.0], 'a tree covers its symbol'
            for t in tree:
                parts = below[int(t['child']):int(t['child']) + int(t['count'])]
                if parts:
                    assert first <= int(t['child']) < first + count, 'a tree keeps to its rows'
                    assert abs(sum(float(c['w']) * float(c['h']) for c in parts) - float(t['w']) * float(t['h'])) < 1e-12, 'parts cover their tile'
    assert len((work / 'chars.tsv').read_text().splitlines()) == 1 + 41 * 64
    # Every leaf has its own cell in its crate's reading order, and a crate's files stack without gaps.
    crates = [{k.split(':')[0]: v for k, v in r.items()} for r in csv.DictReader((work / 'crates.tsv').open(), delimiter='\t', quoting=csv.QUOTE_NONE)]
    assert sorted(int(c['rank']) for c in crates) == list(range(len(crates))) and sum(int(c['files']) for c in crates) == 32
    for k, crate in enumerate(crates):
        cells = [n(r, 'cell') for r in rows if n(r, 'kind') == 5 and n(r, 'crate') == k]
        assert len(cells) == len(set(cells)) and max(cells) == int(crate['cells']) - 1, 'ledger cells'
        # a file or a scope spans the cells of its leaves, and a symbol's level counts the scopes around it
        for i, r in enumerate(rows):
            if n(r, 'crate') == k and n(r, 'kind') in (1, 4) and n(r, 'cells'):
                held, pending = [], [i]
                while pending:
                    j = pending.pop()
                    held += [n(rows[j], 'cell')] if n(rows[j], 'kind') == 5 else []
                    pending += range(n(rows[j], 'child'), n(rows[j], 'child') + n(rows[j], 'count'))
                assert (min(held), max(held) - min(held) + 1) == (n(r, 'cell'), n(r, 'cells')), 'a group spans its leaves'
        tops = sorted((n(r, 'top'), n(r, 'last')) for r in rows if n(r, 'kind') in (1, 2) and n(r, 'crate') == k)
        assert all(a + lines == b for (a, lines), (b, _) in zip(tops, tops[1:])) and tops[-1][0] + tops[-1][1] == int(crate['lines']), 'strata tops'
    # A file's digest, not its timestamp or size, keys the symbol cache.
    tiny = work / 'tree'
    tiny.mkdir()
    source = tiny / 'change.rs'
    source.write_text('fn before() {}\n')
    tiny_command = [str(INDEX), '--root', str(tiny), '--output', str(output), '--cache', str(work / 'cache')]
    subprocess.check_call(tiny_command)
    source.write_text('fn after_() {}\n')
    subprocess.check_call(tiny_command)
    assert 'after_' in output.read_text() and 'before' not in output.read_text()
    assert module['escape']('λ\tline\n\\\r') == 'λ\\tline\\n\\\\\\r'
print('source_atlas_index: fixture, tree, cache and content invalidation passed')
