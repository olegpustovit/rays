; GPU attribute regions in real Chrome: the export places a mark set's regions on the GPU, one device is shared
; by gpu.js and present.js, and the canvas equals the native picture; window counters prove no CPU invoke ran.
(rule
 (enabled_if (= %{system} macosx))
 (alias qualification-web-marks)
 (deps web/test/gpu_marks_e2e.mjs web/test/png.mjs web/test/chrome.mjs
  (glob_files ../lib/web_export/runtime/*.js) ../lib/web_export/runtime/marks.wgsl ../bin/rays.exe marks_shot.exe
  ../sketches/flow_particles_gpu.rays)
 (action
  (system "if command -v node >/dev/null 2>&1; then node web/test/gpu_marks_e2e.mjs ../bin/rays.exe marks_shot.exe ..; else echo 'gpu_marks_e2e: skipped (node not found)'; fi")))

(alias
 (name qualification-web)
 (deps (alias qualification-web-marks)))

; Generated-image pixel parity, animation, sharing, static reuse and resize (P6.4b).
(rule
 (enabled_if (= %{system} macosx))
 (alias qualification-web)
 (deps web/test/gpu_images_e2e.mjs web/test/png.mjs web/test/chrome.mjs
  (glob_files ../lib/web_export/runtime/*.js) ../lib/web_export/runtime/marks.wgsl ../bin/rays.exe marks_shot.exe
  ../sketches/flow_contours.rays ../sketches/flow_image_kernel.rays
  ../sketches/flow_shader.rays ../sketches/flow_image.rays
  (source_tree ../lib/sdl3_image/fixtures))
 (action
  (system "if command -v node >/dev/null 2>&1; then node web/test/gpu_images_e2e.mjs ../bin/rays.exe marks_shot.exe ..; else echo 'gpu_images_e2e: skipped (node not found)'; fi")))

; Plan P6.R: each of the 15 workspaces with a draw graph either opens in headless Chrome (the frame loop runs, no error, a
; non-empty mark table) or is refused at export with its code and span. Printed per workspace.
(rule
 (enabled_if (= %{system} macosx))
 (alias qualification-web)
 (deps web/test/open_all.mjs web/test/chrome.mjs ../bin/rays.exe
  (glob_files ../lib/web_export/runtime/*.js) ../lib/web_export/runtime/marks.wgsl
  (source_tree ../sketches))
 (action
  (system "if command -v node >/dev/null 2>&1; then node web/test/open_all.mjs ../bin/rays.exe .. sketches/audio.rays sketches/basic.rays sketches/drawing.rays sketches/file_dialog.rays sketches/generative.rays sketches/noise.rays sketches/particles.rays sketches/pxui.rays sketches/recursive_rectangles.rays sketches/flow_contours.rays sketches/flow_image.rays sketches/flow_image_kernel.rays sketches/flow_particles_gpu.rays sketches/flow_shader.rays sketches/flow_vectors.rays; else echo 'open_all: skipped (node not found)'; fi")))

