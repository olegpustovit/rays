; Real-browser check of the WGSL kernels (plan P6.3). Needs Google Chrome; not part of runtest.
; Exit 3 means WebGPU is unavailable in that Chrome; a missing node or Chrome is a printed skip.
(rule
 (alias qualification-web)
 (deps web/test/gpu_check.mjs web/test/chrome.mjs web/runtime/gpu.js ../lib/flow_web/test_wgsl.exe
  (glob_files ../lib/flow_web/goldens/*.js))
 (action
  (system "if command -v node >/dev/null 2>&1; then mkdir -p kt && ../lib/flow_web/test_wgsl.exe --write-kernel-table kt && node web/test/gpu_check.mjs kt/kernels.json web/runtime/gpu.js ../lib/flow_web/goldens; else echo 'gpu_check: skipped (node not found)'; fi")))

; Fast precision on the web (native parity): the fast WGSL kernels (64-bit integer pairs, gathers, count records,
; compaction) against native outputs in real Chrome, and recursive_rectangles' resident fold and GPU display
; regions at a deep, moving pointer against native fast precision (the Metal resident fold). Not part of runtest.
(rule
 (alias qualification-web)
 (deps web/test/gpu_fast_check.mjs web/test/chrome.mjs web/runtime/gpu.js ../lib/flow_web/test_wgsl.exe)
 (action
  (system "if command -v node >/dev/null 2>&1; then mkdir -p fkt && ../lib/flow_web/test_wgsl.exe --write-fast-table fkt && node web/test/gpu_fast_check.mjs fkt web/runtime/gpu.js; else echo 'gpu_fast_check: skipped (node not found)'; fi")))

(rule
 (alias qualification-web)
 (deps web/test/present_e2e.mjs web/test/chrome.mjs web/test/png.mjs
  (glob_files web/runtime/*.js) web/runtime/marks.wgsl lisp/rays.exe marks_shot.exe
  ../sketches/recursive_rectangles.rays)
 (action
  (system "if command -v node >/dev/null 2>&1; then FRAMES=12 FAST=1 POINTER='320,405;320,410;320,415;320,420;320,425;320,430;320,435;320,440;320,445;320,450;320,455;320,460' node web/test/present_e2e.mjs lisp/rays.exe marks_shot.exe .. sketches/recursive_rectangles.rays; else echo 'fast present_e2e: skipped (node not found)'; fi")))

; The live page as a person uses it: index.html's rAF loop driven by real mouse events must animate, and once the
; pointer rests its picture matches native at the same pointer. Not part of runtest.
(rule
 (alias qualification-web)
 (deps web/test/live_check.mjs web/test/chrome.mjs web/test/png.mjs
  (glob_files web/runtime/*.js) web/runtime/marks.wgsl lisp/rays.exe marks_shot.exe
  ../sketches/recursive_rectangles.rays)
 (action
  (system "if command -v node >/dev/null 2>&1; then node web/test/live_check.mjs lisp/rays.exe marks_shot.exe .. sketches/recursive_rectangles.rays 400 520; else echo 'live_check: skipped (node not found)'; fi")))

; Real-Chrome check of the presenter (plan P6.4, P6.5): hand-built mark tables with pixel probes, then
; flow_vectors and sketches/basic.rays exported, stepped in the browser and compared with the native picture.
(rule
 (alias qualification-web)
 (deps web/test/present_check.mjs web/test/present_e2e.mjs web/test/chrome.mjs web/test/png.mjs
  (glob_files web/runtime/*.js) web/runtime/marks.wgsl lisp/rays.exe marks_shot.exe
  ../sketches/flow_vectors.rays ../sketches/basic.rays ../sketches/particles.rays)
 (action
  (system "if command -v node >/dev/null 2>&1; then node web/test/present_check.mjs web/runtime && node web/test/present_e2e.mjs lisp/rays.exe marks_shot.exe .. sketches/flow_vectors.rays sketches/basic.rays sketches/particles.rays; else echo 'present_check: skipped (node not found)'; fi")))

