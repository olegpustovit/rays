(executable
 (name embed)
 (modules embed))

(rule
 (targets web_runtime.ml)
 (deps (glob_files ../web/runtime/*.js) (glob_files ../web/runtime/*.wgsl))
 (action (with-stdout-to web_runtime.ml (run ./embed.exe %{deps}))))

(library
 (name web_export)
 (modules web_export web_runtime)
 (libraries flow flow_ir flow_web flow_sop editor_document sop_catalog frame_input scene_command sdl3_image))

(executable
 (name rays)
 (modules rays)
