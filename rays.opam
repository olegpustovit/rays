# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Native creative coding with Rays Lisp and a Metal editor"
description:
  "A Lisp workspace language and native Apple-Silicon creative-coding editor using Metal and SDL3, implemented in OCaml"
maintainer: ["Oleg Pustovit <oleg@nexo.sh>"]
authors: ["Oleg Pustovit <oleg@nexo.sh>"]
license: "MIT"
tags: ["ocaml" "graphics" "framework" "creative-coding" "gamedev"]
homepage: "https://github.com/olegpustovit/rays"
bug-reports: "https://github.com/olegpustovit/rays/issues"
depends: [
  "ocaml" {>= "5.3"}
  "dune" {>= "3.17" & >= "3.21"}
  "digestif"
  "dune-configurator"
  "ppxlib"
  "odoc" {with-doc}
  "domainslib"
  "yojson"
  "conf-sdl3"
  "conf-sdl3-image"
  "conf-sdl3-ttf"
  "conf-sdl3-mixer"
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/olegpustovit/rays.git"
