opam-version: "2.0"
synopsis: "Virtual package relying on a stable SDL3_mixer release"
description: "Checks that SDL3_mixer is at least the floor in packaging/sdl3.lock; tools/packaging/test_sdl3_lock keeps this probe in step with it."
maintainer: ["Oleg Pustovit <oleg@nexo.sh>"]
authors: ["Rays contributors"]
license: "MIT"
homepage: "https://github.com/olegpustovit/rays"
bug-reports: "https://github.com/olegpustovit/rays/issues"
dev-repo: "git+https://github.com/olegpustovit/rays.git"
flags: conf
depends: [
  "conf-pkg-config" {build}
  "conf-sdl3"
]
depexts: [
  ["mingw-w64-x86_64-sdl3-mixer"] {os-distribution = "msys2"}
  ["sdl3_mixer"] {os-distribution = "homebrew"}
]
build: [["pkg-config" "--atleast-version=3.2.4" "sdl3-mixer"]]
