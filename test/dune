; Draw-graph scene snapshots (P3.1): each workspace's scene is regenerated into
; the build directory and diffed against the checked-in file.
(executable
 (name test_draw_snapshot)
 (modules test_draw_snapshot)
 (libraries rays rays_editor editor_document flow flow_sop sop_catalog scene_command frame_input))

(rule
 (alias runtest)
 (deps (source_tree ../examples) (source_tree ../sketches) (source_tree draw_snapshots))
 (action
  (setenv SDL_VIDEODRIVER dummy
   (setenv SDL_AUDIODRIVER dummy
    (progn
     (with-stdout-to core_examples_audio.txt (run %{exe:test_draw_snapshot.exe} examples_audio))
     (diff draw_snapshots/examples_audio.txt core_examples_audio.txt)
     (with-stdout-to core_examples_basic.txt (run %{exe:test_draw_snapshot.exe} examples_basic))
     (diff draw_snapshots/examples_basic.txt core_examples_basic.txt)
     (with-stdout-to core_examples_drawing.txt (run %{exe:test_draw_snapshot.exe} examples_drawing))
     (diff draw_snapshots/examples_drawing.txt core_examples_drawing.txt)
     (with-stdout-to core_examples_file_dialog.txt (run %{exe:test_draw_snapshot.exe} examples_file_dialog))
     (diff draw_snapshots/examples_file_dialog.txt core_examples_file_dialog.txt)
     (with-stdout-to core_examples_generative.txt (run %{exe:test_draw_snapshot.exe} examples_generative))
     (diff draw_snapshots/examples_generative.txt core_examples_generative.txt)
     (with-stdout-to core_examples_noise.txt (run %{exe:test_draw_snapshot.exe} examples_noise))
     (diff draw_snapshots/examples_noise.txt core_examples_noise.txt)
     (with-stdout-to core_examples_particles.txt (run %{exe:test_draw_snapshot.exe} examples_particles))
     (diff draw_snapshots/examples_particles.txt core_examples_particles.txt)
     (with-stdout-to core_examples_pxui.txt (run %{exe:test_draw_snapshot.exe} examples_pxui))
     (diff draw_snapshots/examples_pxui.txt core_examples_pxui.txt)
     (with-stdout-to core_examples_recursive_rectangles.txt (run %{exe:test_draw_snapshot.exe} examples_recursive_rectangles))
     (diff draw_snapshots/examples_recursive_rectangles.txt core_examples_recursive_rectangles.txt)
     (with-stdout-to core_sketches_flow_contours.txt (run %{exe:test_draw_snapshot.exe} sketches_flow_contours))
     (diff draw_snapshots/sketches_flow_contours.txt core_sketches_flow_contours.txt)
     (with-stdout-to core_sketches_flow_image.txt (run %{exe:test_draw_snapshot.exe} sketches_flow_image))
     (diff draw_snapshots/sketches_flow_image.txt core_sketches_flow_image.txt)
     (with-stdout-to core_sketches_flow_image_kernel.txt (run %{exe:test_draw_snapshot.exe} sketches_flow_image_kernel))
     (diff draw_snapshots/sketches_flow_image_kernel.txt core_sketches_flow_image_kernel.txt)
     (with-stdout-to core_sketches_flow_particles_gpu.txt (run %{exe:test_draw_snapshot.exe} sketches_flow_particles_gpu))
     (diff draw_snapshots/sketches_flow_particles_gpu.txt core_sketches_flow_particles_gpu.txt)
     (with-stdout-to core_sketches_flow_shader.txt (run %{exe:test_draw_snapshot.exe} sketches_flow_shader))
     (diff draw_snapshots/sketches_flow_shader.txt core_sketches_flow_shader.txt)
     (with-stdout-to core_sketches_flow_vectors.txt (run %{exe:test_draw_snapshot.exe} sketches_flow_vectors))
     (diff draw_snapshots/sketches_flow_vectors.txt core_sketches_flow_vectors.txt))))))

