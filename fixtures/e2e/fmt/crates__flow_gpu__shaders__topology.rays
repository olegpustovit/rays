; Groups across the grid validate exact uint32 topology. Each lane visits disjoint rows, the grid's
; width (bound[5]) apart, in an iterate (a range fold stops at 4,096 rows a lane); each group's nine
; collective sums make a 36-byte record at group x 9, and the host ORs the records.
(defmacro check-bit [flags bit]
  `(gpu/group_scan (if (int/eq (int/and ~flags ~bit) 0) 0 1)))

(defn topology-check :context value [(id : int) (vertices : (array int)) (offsets : (array int)) (kinds : (array int)) (out : (array int)) (bound : (array int)) (size : int)]
  (let* [points (array/nth bound 0)
         nv (array/nth bound 1)
         no (array/nth bound 2)
         nk (array/nth bound 3)
         limit (array/nth bound 4)
         n (if (int/gt nv no) (if (int/gt nv nk) nv nk) (if (int/gt no nk) no nk))
         lanes (array/nth bound 5)
         chunks (int/div (int/add n (int/sub lanes 1)) lanes)
         walk (iterate chunks
                       {:i id :flags 0}
                       (fn [w]
                         (let* [i w.i
                                vertex (if (int/lt i nv)
                                           (if (int/ge (array/nth vertices i) points)
                                               16
                                               0)
                                           0)
                                kind (if (int/lt i nk)
                                         (if (int/gt (array/nth kinds i) 2) 64 0)
                                         0)
                                primitive (if (int/lt (int/add i 1) no)
                                              (let* [a (array/nth offsets i)
                                                     b (array/nth offsets (int/add i 1))]
                                                (if (int/gt a b)
                                                    32
                                                    (if (int/lt i nk)
                                                        (let* [k (array/nth kinds i)
                                                               count (int/sub b a)
                                                               minimum (if (int/eq k 1) 2 3)]
                                                          (int/or (if (int/lt count minimum) 128 0)
                                                                  (if (if (int/eq k 0) (int/gt count limit) false)
                                                                      256
                                                                      0)))
                                                        0)))
                                              0)]
                           {:i (int/add i lanes)
                            :flags (int/or w.flags
                                           (int/or vertex (int/or kind primitive)))})))
         checked (int/or walk.flags
                         (if (int/eq id 0)
                             (int/or (if (int/eq no 0)
                                         1
                                         (if (int/eq (array/nth offsets 0) 0) 0 2))
                                     (int/or (if (int/eq no 0)
                                                 0
                                                 (if (int/eq (array/nth offsets (int/sub no 1))
                                                             nv)
                                                     0
                                                     4))
                                             (if (int/eq no (int/add nk 1)) 0 8)))
                             0))
         a (check-bit checked 1)
         b (check-bit checked 2)
         c (check-bit checked 4)
         d (check-bit checked 8)
         e (check-bit checked 16)
         f (check-bit checked 32)
         g (check-bit checked 64)
         h (check-bit checked 128)
         j (check-bit checked 256)
         at (int/mul (int/div id size) 9)]
    (if (int/eq (int/mod id size) 0)
        (-> out
            (gpu/store_int at a.total)
            (int/add (gpu/store_int out (int/add at 1) b.total))
            (-> out
                (gpu/store_int (int/add at 2) c.total)
                (int/add (gpu/store_int out (int/add at 3) d.total))
                (int/add))
            (-> out
                (gpu/store_int (int/add at 4) e.total)
                (int/add (gpu/store_int out (int/add at 5) f.total))
                (-> out
                    (gpu/store_int (int/add at 6) g.total)
                    (-> out
                        (gpu/store_int (int/add at 7) h.total)
                        (int/add (gpu/store_int out (int/add at 8) j.total))
                        (int/add))
                    (int/add))
                (int/add)))
        0)))
