; The inspector edits graph inputs; the drawing uses the same retained dot field.
(workspace pxui

  (graph controls :context host [(animate : bool true) (radius : float 48.0) (center : vec3 [470 180 0]) (band : vec3 [0.2 0.8 0]) (palette : text "ocean") (caption : text "Functional UI") (quit : bool false)]
    {:animate animate
     :radius radius
     :center center
     :band band
     :palette palette
     :caption caption
     :quit quit})

  (graph picture :context draw
    (let* [controls (ref controls)
           angle (state [previous 0.0]
                        (if controls.animate (+ previous (frame/dt)) previous))
           pulse (int (* 40 (+ 0.5 (* 0.5 (sin angle)))))
           color (case controls.palette
                   "sunset" [(/ 240 255) (/ (+ 100 pulse) 255) (/ 90 255)]
                   "mono" [(/ (+ 140 pulse) 255) (/ (+ 140 pulse) 255) (/ (+ 140 pulse) 255)]
                   :else [(/ (+ 80 pulse) 255) (/ 150 255) (/ 225 255)])
           dots (map (fn [i] [(* (mod i 54) 12) (* (floor (/ i 54)) 12) 0])
                     (array/range 1620))]
      (draw/merge (draw/background "#e48ba1")
                  (draw/points dots :color "#1e1e1e")
                  (draw/circle [(int controls.center.x) (int controls.center.y) 0]
                               (int controls.radius)
                               :fill color))))

  (graph actions :context host
    (host/quit (get (ref controls) :quit)))

  (graph editor :context editor
    (let* [pane (ui/graph "controls")]
      (ui/workspace (ui/split "horizontal"
                              (ui/split "vertical" pane (ui/inspector :of pane))
                              (ui/canvas (ref picture) :focus true))
                    :effects (ref actions))))

  (graph window :context settings
    (settings/config :title "PXUI example" :width 640 :height 360)))
