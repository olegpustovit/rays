(library
 (name runtime)
 (public_name rays.runtime)
 (modules runtime)
 (libraries sdl3 ogpu))

(library
 (name runtime_input)
 (public_name rays.runtime_input)
 (wrapped false)
 (modules runtime_input runtime_input_sdl3)
 (libraries sdl3 input))

(executable
 (enabled_if (= %{system} macosx))
 (name test_main)
 (modules test_main test_runtime_visibility test_runtime_input)
 (libraries runtime runtime_input ogpu ogpu_metal sdl3))

(rule
 (enabled_if (= %{system} macosx))
 (alias test_runtime_visibility)
 (locks smoke_window)
 (action (run %{exe:test_main.exe} test_runtime_visibility)))

(rule
 (enabled_if (= %{system} macosx))
 (alias test_runtime_input)
 (action (run %{exe:test_main.exe} test_runtime_input)))

(alias
 (name runtest-native)
 (deps (alias test_runtime_visibility)))

(alias
 (name runtest)
 (deps
  (alias test_runtime_input)))
