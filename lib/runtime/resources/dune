(library
 (name runtime_resources)
 (public_name rays.runtime_resources)
 (modules runtime_resources)
 (libraries sdl3 sdl3_image sdl3_ttf sdl3_mixer ogpu unix))

(test
 (name test_gpu_image)
 (modules test_gpu_image)
 (libraries runtime_resources ogpu_mock))

(executable
 (name test_main)
 (modules
  test_main
  test_runtime_resources
  test_resources_font
  test_resources_audio
  test_png_rows)
 (libraries runtime_resources ogpu_mock unix))

(rule
 (alias test_resources_font)
 (action
  (run %{exe:test_main.exe} test_resources_font)))

(rule
 (alias test_runtime_resources)
 (action
  (run %{exe:test_main.exe} test_runtime_resources)))

(rule
 (alias test_resources_audio)
 (action
  (setenv
   SDL_AUDIODRIVER
   dummy
   (run %{exe:test_main.exe} test_resources_audio))))

(rule
 (alias test_png_rows)
 (action
  (run %{exe:test_main.exe} test_png_rows)))

(alias
 (name runtest)
 (deps
  (alias test_resources_font)
  (alias test_runtime_resources)
  (alias test_resources_audio)
  (alias test_png_rows)))
