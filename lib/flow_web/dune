(library
 (name flow_web)
 (public_name rays.flow_web)
 (modules flow_web wgsl js target kernel_table text_literal compact_wgsl)
 (private_modules text_literal compact_wgsl)
 (libraries flow flow_ir param rays_math scene_command parallel))

; the resident fold's compaction, generated from ../flow_gpu/shaders/compact.rays
; (lib/flow_gpu/test_raster.exe --write lib)
(rule
 (target compact_wgsl.ml)
 (deps compact.wgsl)
 (action (with-stdout-to %{target}
  (progn (echo "let source = {wgsl|") (cat compact.wgsl) (echo "|wgsl}\n")))))

