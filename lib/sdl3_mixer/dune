(executable
 (name discover)
 (modules discover)
 (libraries sdl3_discovery))

(rule
 (targets c_flags.sexp c_library_flags.sexp sdl3_probed.h)
 (deps (universe))
 (action (run ./discover.exe)))

(rule
 (targets generated_abi.h)
 (deps
  ../../packaging/sdl3.lock
  ../sdl3/abi.sexp
  ../sdl3/sdl3_stubs.c
  ../sdl3/sdl3_dialog.c
  ../sdl3_image/sdl3_image_stubs.c
  ../sdl3_ttf/sdl3_ttf_stubs.c
  ../sdl3_mixer/sdl3_mixer_stubs.c)
 (action
  (run %{exe:../sdl3/generate.exe} emit --root ../..
   --component sdl3_mixer --lock ../../packaging/sdl3.lock
   --abi ../sdl3/abi.sexp --output generated_abi.h)))

(library
 (name sdl3_mixer)
 (public_name rays.sdl3_mixer)
 (modules Sdl3_mixer)
 (foreign_stubs
  (language c)
  (names sdl3_mixer_stubs)
  (flags (:include c_flags.sexp) -Wall -Wextra -Werror)
  (extra_deps generated_abi.h sdl3_probed.h))
 (c_library_flags (:include c_library_flags.sexp))
 (libraries sdl3 threads))

(executable
 (name test_main)
 (modules test_main test_sdl3_mixer test_sdl3_mixer_device_failure)
 (libraries sdl3 sdl3_mixer sdl3_lock))

(rule
 (alias test_sdl3_mixer)
 (deps ../../packaging/sdl3.lock)
 (action
  (setenv SDL_AUDIODRIVER dummy
   (run %{exe:test_main.exe} test_sdl3_mixer))))

(rule
 (alias test_sdl3_mixer_device_failure)
 (action
  (setenv SDL_AUDIODRIVER rays_missing_audio_driver
   (run %{exe:test_main.exe} test_sdl3_mixer_device_failure))))


(rule
 (alias qualification)
 (deps ../../packaging/sdl3.lock)
 (action
  (setenv SDL_AUDIODRIVER dummy
   (run %{exe:test_main.exe} test_sdl3_mixer))))

(alias
 (name runtest)
 (deps
  (alias test_sdl3_mixer)
  (alias test_sdl3_mixer_device_failure)))
