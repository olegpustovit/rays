; One executable per suite: each links only its own module, so a suite builds and runs
; while another is being edited.
(executables
 (names run_sop run_edit_graph run_nodes run_parallel_exact run_diagnostics)
 (modules run_sop run_edit_graph run_nodes run_parallel_exact run_diagnostics
  test_sop test_edit_graph test_nodes test_parallel_exact test_diagnostics)
 (libraries sop rays rdk rdk_rays rdk_test_support lisp_sop))

(rule
 (aliases qualification-scale test_sop)
 (action (run %{exe:run_sop.exe})))

(rule
 (aliases runtest test_edit_graph)
 (action (run %{exe:run_edit_graph.exe})))

(rule
 (aliases runtest test_nodes)
 (action (run %{exe:run_nodes.exe})))

(rule
 (aliases qualification qualification-scale test_parallel_exact)
 (action (run %{exe:run_parallel_exact.exe})))

(rule
 (aliases qualification-scale test_diagnostics)
 (action (run %{exe:run_diagnostics.exe})))
