(library
 (name sop)
 (public_name rays.sop)
 (libraries param frame_input rays_math rdk lru unix)
 (preprocess (pps rays.ppx))
 (modules context diagnostic image kernel payload parameter node session async_cook image_nodes
  support groups sop_topology attributes shapes nodes zone custom graph edit_graph)
 (private_modules support groups sop_topology attributes shapes))

(test
 (name test_facts)
 (modules test_facts)
 (libraries sop rdk rays_math sop_catalog flow flow_sop lisp_sop rdk_test_support))

(test
 (name test_lisp_ports)
 (modules test_lisp_ports)
 (deps ../flow_sop/nodes/noise_displace.rays ../flow_sop/nodes/set_float.rays ../flow_sop/nodes/set_int.rays ../flow_sop/nodes/set_vector.rays ../flow_sop/nodes/set_orient.rays ../flow_sop/nodes/set_transform.rays)
 (libraries sop rdk rays_math sop_catalog flow flow_sop lisp_sop rdk_test_support unix))

(rule
 (alias test_lisp_ports)
 (action (run %{exe:test_lisp_ports.exe})))

