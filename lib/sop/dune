(library
 (name sop)
 (public_name rays.sop)
 (libraries param input rays_diagnostic rays_math rdk mem lru unix parallel)
 (preprocess
  (pps rays.ppx -- -inside-sop))
 (modules
  context
  image
  kernel
  payload
  node
  session
  async_cook
  image_nodes
  support
  groups
  sop_topology
  attributes
  shapes
  nodes
  zone
  custom
  edit_graph)
 (private_modules support groups sop_topology attributes shapes))

