; One executable per suite: each links only its own module, so a suite builds and runs
; while another is being edited.

(executables
 (names run_sop run_edit_graph run_parallel_exact run_diagnostics)
 (modules
  run_sop
  run_edit_graph
  run_parallel_exact
  run_diagnostics
  test_sop
  test_edit_graph
  test_parallel_exact
  test_diagnostics)
 (libraries
  sop
  rays
  rdk
  rdk_rays
  rdk_test_support
  lisp_sop
  rays_math
  ogpu_mock
  parallel))

(rule
 (alias test_sop)
 (action
  (run %{exe:run_sop.exe})))

