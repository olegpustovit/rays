(executable
 (name discover)
 (modules discover)
 (libraries sdl3_discovery))

(rule
 (targets c_flags.sexp c_library_flags.sexp sdl3_probed.h)
 (deps (universe))
 (action
  (run ./discover.exe)))

(rule
 (targets generated_abi.h)
 (deps
  ../../packaging/sdl3.lock
  ../sdl3/abi.sexp
  ../sdl3/sdl3_stubs.c
  ../sdl3/sdl3_dialog.c
  ../sdl3_image/sdl3_image_stubs.c
  ../sdl3_ttf/sdl3_ttf_stubs.c
  ../sdl3_mixer/sdl3_mixer_stubs.c)
 (action
  (run
   %{exe:../sdl3/generate.exe}
   emit
   --root
   ../..
   --component
   sdl3_ttf
   --lock
   ../../packaging/sdl3.lock
   --abi
   ../sdl3/abi.sexp
   --output
   generated_abi.h)))

(library
 (name sdl3_ttf)
 (public_name rays.sdl3_ttf)
 (modules Sdl3_ttf)
 (foreign_stubs
  (language c)
  (names sdl3_ttf_stubs)
  (flags
   (:include c_flags.sexp)
   -Wall
   -Wextra
   -Werror)
  (extra_deps generated_abi.h sdl3_probed.h))
 (c_library_flags
  (:include c_library_flags.sexp))
 (libraries sdl3 threads))

(executable
 (name test_main)
 (modules test_main test_sdl3_ttf test_sdl3_ttf_discovery_failure)
 (libraries sdl3 sdl3_ttf sdl3_lock))

(rule
 (alias test_sdl3_ttf)
 (deps ../../packaging/sdl3.lock)
 (action
  (setenv
   SDL_VIDEODRIVER
   dummy
   (run %{exe:test_main.exe} test_sdl3_ttf))))

(rule
 (alias test_sdl3_ttf_discovery_failure)
 (action
  (setenv
   RAYS_UI_FONT
   /definitely/missing/rays-font.ttf
   (run %{exe:test_main.exe} test_sdl3_ttf_discovery_failure))))

(rule
 (alias qualification)
 (deps ../../packaging/sdl3.lock)
 (action
  (setenv
   SDL_VIDEODRIVER
   dummy
   (run %{exe:test_main.exe} test_sdl3_ttf))))

(alias
 (name runtest)
 (deps
  (alias test_sdl3_ttf)
  (alias test_sdl3_ttf_discovery_failure)))
