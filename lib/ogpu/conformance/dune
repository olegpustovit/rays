(library
 (name ogpu_conformance)
 (modules conformance)
 (libraries ogpu unix))

(executable
 (name test_mock)
 (modules test_mock)
 (libraries ogpu_conformance ogpu_mock))

(executable
 (name test_metal)
 (enabled_if
  (= %{system} macosx))
 (modules test_metal)
 (libraries ogpu_conformance ogpu_metal metal))

(rule
 (alias ogpu_conformance_mock)
 (action
  (run %{exe:test_mock.exe})))

(rule
 (alias ogpu_conformance_metal)
 (enabled_if
  (= %{system} macosx))
 (action
  (run %{exe:test_metal.exe})))

(alias
 (name runtest)
 (deps
  (alias ogpu_conformance_mock)))

(alias
 (name runtest)
 (enabled_if
  (= %{system} macosx))
 (deps
  (alias ogpu_conformance_metal)))

(executable
 (name test_vulkan)
 (enabled_if
  (= %{system} mingw64))
 (modules test_vulkan)
 (libraries ogpu_conformance ogpu_vulkan vulkan unix))

(rule
 (alias ogpu_conformance_vulkan)
 (enabled_if
  (= %{system} mingw64))
 (deps
  (glob_files vulkan/*.spv))
 (action
  (run %{exe:test_vulkan.exe})))

(alias
 (name runtest-native)
 (enabled_if
  (= %{system} mingw64))
 (deps
  (alias ogpu_conformance_vulkan)))
