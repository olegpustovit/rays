; The suite's shaders for Vulkan: one GLSL file per stage, entry renamed to the name the suite uses,
; the library's kernels linked into one module. Test-only.

(rule
 (enabled_if
  (= %{system} mingw64))
 (targets
  sample_lod.spv
  library.spv
  flat_vertex.spv
  flat_fragment.spv
  argument_fragment.spv
  textured_fragment.spv)
 (deps
  (glob_files *.comp)
  (glob_files *.vert)
  (glob_files *.frag))
 (action
  (progn
   (run glslangValidator --target-env vulkan1.3 -e sample_lod --source-entrypoint main -o sample_lod.spv sample_lod.comp)
   (run glslangValidator --target-env vulkan1.3 -e scale2 --source-entrypoint main -o scale2.spv scale2.comp)
   (run glslangValidator --target-env vulkan1.3 -e scale3 --source-entrypoint main -o scale3.spv scale3.comp)
   (run glslangValidator --target-env vulkan1.3 -e fill --source-entrypoint main -o fill.spv fill.comp)
   (run spirv-link scale2.spv scale3.spv fill.spv -o library.spv)
   (run glslangValidator --target-env vulkan1.3 -o flat_vertex.spv flat_vertex.vert)
   (run glslangValidator --target-env vulkan1.3 -o flat_fragment.spv flat_fragment.frag)
   (run glslangValidator --target-env vulkan1.3 -o argument_fragment.spv argument_fragment.frag)
   (run glslangValidator --target-env vulkan1.3 -o textured_fragment.spv textured_fragment.frag))))

(rule
 (enabled_if
  (= %{system} mingw64))
 (targets rays.spv rt_extra.spv)
 (deps
  (glob_files *.comp))
 (action
  (progn
   (run glslangValidator --target-env vulkan1.3 -e trace --source-entrypoint main -o trace.spv trace.comp)
   (run glslangValidator --target-env vulkan1.3 -e trace_instances --source-entrypoint main -o trace_instances.spv trace_instances.comp)
   (run glslangValidator --target-env vulkan1.3 -e trace_boxes --source-entrypoint main -o trace_boxes.spv trace_boxes.comp)
   (run glslangValidator --target-env vulkan1.3 -e trace_masked --source-entrypoint main -o trace_masked.spv trace_masked.comp)
   (run glslangValidator --target-env vulkan1.3 -e trace_capsules --source-entrypoint main -o trace_capsules.spv trace_capsules.comp)
   (run glslangValidator --target-env vulkan1.3 -e trace_motion --source-entrypoint main -o trace_motion.spv trace_motion.comp)
   (run glslangValidator --target-env vulkan1.3 -e trace_motion_instances --source-entrypoint main -o trace_motion_instances.spv trace_motion_instances.comp)
   (run spirv-link trace.spv trace_instances.spv -o rays.spv)
   (run spirv-link trace_boxes.spv trace_masked.spv trace_capsules.spv trace_motion.spv trace_motion_instances.spv -o rt_extra.spv))))
