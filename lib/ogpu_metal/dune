(library
 (enabled_if
  (= %{system} macosx))
 (name ogpu_metal_native)
 (public_name rays.ogpu_metal_native)
 (modules
  Device
  Buffer
  Texture
  Sampler
  Library
  Pipeline
  Queue
  Presentation
  Present_source
  Surface
  Acceleration
  Command_control
  Compute_encoder
  Blit_encoder
  Render_encoder
  Backend)
 (private_modules
  Presentation
  Present_source
  Command_control
  Compute_encoder
  Blit_encoder
  Render_encoder)
 (libraries ogpu_core metal lru))

; the presentation blit, printed from shaders/present.rays (a build-time tool: the library never links Flow)

(rule
 (enabled_if
  (= %{system} macosx))
 (targets present.metal present.vert.spv present.frag.spv)
 (deps shaders/present.rays)
 (action
  (run %{exe:../flow_shader/print_shader.exe} ogpu_metal)))

(rule
 (enabled_if
  (= %{system} macosx))
 (target present_source.ml)
 (deps present.metal)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {msl|")
    (cat present.metal)
    (echo "|msl}\n")))))

(library
 (enabled_if
  (= %{system} macosx))
 (name ogpu_metal)
 (public_name rays.ogpu_metal)
 (implements ogpu)
 (modules Impl)
 (libraries ogpu_metal_native metal))

