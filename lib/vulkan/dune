(data_only_dirs vendor)

; volk loads vulkan-1 at run time, so a machine without a driver gets a typed startup error rather
; than a failed program load. Vulkan Memory Allocator suballocates. Both vendored, licenses in
; specification/licenses.md.

(library
 (enabled_if
  (= %{system} mingw64))
 (name vulkan)
 (public_name rays.vulkan)
 (modules vulkan)
 (foreign_stubs
  (language c)
  (names vulkan_bridge volk_unit)
  (flags
   :standard
   -Wno-unused-parameter
   -I%{project_root}/lib/native_layer_token)
  (extra_deps
   (glob_files vendor/*)))
 (foreign_stubs
  (language cxx)
  (names vma)
  (flags -O2 -std=c++17 -w)
  (extra_deps
   (glob_files vendor/*)))
 (c_library_flags -lstdc++)
 (libraries threads native_layer_token))
