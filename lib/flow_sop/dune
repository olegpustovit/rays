 (modules test_attribute_kernel)
 (libraries test_support flow flow_ir flow_graph flow_sop rdk rdk_test_support lisp_sop rays_math parallel))

(test
 (name test_rand_at)
 (enabled_if (= %{env:RAYS_SLOW=0} 1))
 (modules test_rand_at)
 (deps nodes/prelude.rays)
 (libraries test_support flow flow_ir flow_sop flow_web rays_math parallel))

; Tests that need no editor: they link the catalog and the document contexts,
; not rays_editor. They read their fixtures relative to test/, where they ran
; before, so each action runs there. Each alias runs its own test only;
; runtest depends on all of them.
(executable
 (name test_main)
 (modules test_main test_projection test_workspace_edit test_workspace_cook test_workspace_zone)
 (libraries flow flow_sop flow_graph editor_document sop rdk unix str lisp_sop ogpu_mock parallel))

(rule
 (alias test_projection)
 (deps (glob_files ../../specification/workspace/cases/*.lisp))
 (action (chdir ../../test (run %{exe:test_main.exe} test_projection))))

(rule
 (alias test_workspace_edit)
 (deps (glob_files ../../specification/workspace/cases/*.lisp))
 (action (chdir ../../test (run %{exe:test_main.exe} test_workspace_edit))))

(rule
 (alias test_workspace_cook)
 (deps (glob_files ../../specification/workspace/cases/*.lisp) (env_var RAYS_SLOW))
 (action (chdir ../../test (run %{exe:test_main.exe} test_workspace_cook))))

(rule
 (alias test_workspace_zone)
 (action (chdir ../../test (run %{exe:test_main.exe} test_workspace_zone))))

(alias
 (name runtest)
 (deps (alias test_projection) (alias test_workspace_edit)
  (alias test_workspace_cook) (alias test_workspace_zone)))

(test
 (name test_gpu_bulk)
 (enabled_if (= %{env:RAYS_SLOW=0} 1))
 (modules test_gpu_bulk)
 (libraries test_support flow flow_ir flow_sop sop rdk rdk_test_support lisp_sop rays_math parallel))

(executable
 (name flow_manifest)
 (modules flow_manifest)
 (libraries flow_sop flow editor_document ogpu_mock parallel))

(rule
 (targets flow_manifest.gen.sexp)
 (action
  (with-stdout-to %{targets}
   (run %{exe:flow_manifest.exe}))))

(rule
 (alias runtest)
 (action (diff flow_manifest.sexp flow_manifest.gen.sexp)))
