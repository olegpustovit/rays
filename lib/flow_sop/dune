(library
 (name flow_sop)
 (public_name rays.flow_sop)
 (modules port curve network value_lane catalog manifest operators attribute_kernel attribute_metadata topology_kernel topology_kernel_impl graph_kernel group_kernel context_kernel function_kernel image_kernel lisp_node encoded_parameters node_sources lower trace_scene)
 (private_modules function_kernel lisp_node encoded_parameters node_sources attribute_metadata topology_kernel_impl graph_kernel group_kernel context_kernel)
 (libraries flow flow_ir lru param sop rays_diagnostic rays_math unix parallel))

(rule
 (targets node_sources.ml)
 (deps (glob_files nodes/*.rays))
 (action (with-stdout-to node_sources.ml
  (run %{exe:../flow/embed.exe} %{deps}))))

(test
 (name test_units)
 (modules test_units test_node_sources test_math_helpers test_math_kernel test_lisp_node test_node_facts test_encoded_parameters test_lisp_projection test_merge_source test_image_kernel test_keyword_ports test_metadata_kernel test_topology_kernel test_geometry_arrays test_group_kernel test_noise_displace_contract test_remap test_concat test_planes test_iterate test_adjacency test_graph test_lisp_fusion test_trace test_mesh_planes)
 (deps nodes/prelude.rays (env_var RAYS_SLOW))
 (libraries test_support flow flow_ir flow_ir_test_support flow_web flow_graph flow_sop sop rdk rdk_test_support lisp_sop rays_math input unix parallel)
 (preprocess (pps rays.ppx)))

(test
 (name test_attribute_kernel)
