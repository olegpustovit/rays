; Whole Grid outside candidate. No native Grid call occurs in this recipe.
(defn grid_axis :context value [(axis : vec3)]
    (let* [scale (max (abs axis.x) (max (abs axis.y) (abs axis.z)))]
      (if (= scale 0.0)
        {:value [0.0 0.0 0.0] :valid false :reason "must be non-zero"}
        (let* [sx (/ axis.x scale) sy (/ axis.y scale) sz (/ axis.z scale)
               ; Native ARM rounds xx, then fuses yy and zz in this order.
               magnitude (sqrt (fma sz sz (fma sy sy (* sx sx))))]
          (if (<= magnitude 1e-15)
            {:value [0.0 0.0 0.0] :valid false :reason "cannot be normalized"}
            {:value [(/ sx magnitude) (/ sy magnitude) (/ sz magnitude)]
             :valid true :reason ""})))))

  (defn grid_perpendicular :context value [(h : vec3) (v : vec3)]
    (let* [projection (fma v.z h.z (fma v.y h.y (* v.x h.x)))
           negative_projection (* -1.0 projection)]
      [(fma negative_projection h.x v.x) (fma negative_projection h.y v.y)
       (fma negative_projection h.z v.z)]))

  (defn grid_custom_valid :context value [(h : vec3) (v : vec3)]
    (let* [horizontal_axis (grid_axis h) vertical_axis (grid_axis v)]
      (if (and horizontal_axis.valid vertical_axis.valid)
        (let* [perpendicular (grid_axis
                  (grid_perpendicular horizontal_axis.value vertical_axis.value))]
          perpendicular.valid)
        false)))

  (defn grid_frame :context value [(h : vec3) (v : vec3) (angle : float)]
    (let* [horizontal_axis (grid_axis h) vertical_axis (grid_axis v)]
      (cond
        (not horizontal_axis.valid)
          {:horizontal [0.0 0.0 0.0] :vertical [0.0 0.0 0.0]
           :normal [0.0 0.0 0.0] :failure (str "horizontal axis " horizontal_axis.reason)}
        (not vertical_axis.valid)
          {:horizontal [0.0 0.0 0.0] :vertical [0.0 0.0 0.0]
           :normal [0.0 0.0 0.0] :failure (str "vertical axis " vertical_axis.reason)}
        :else
          (let* [perpendicular_axis (grid_axis
                    (grid_perpendicular horizontal_axis.value vertical_axis.value))]
            (if (not perpendicular_axis.valid)
              {:horizontal [0.0 0.0 0.0] :vertical [0.0 0.0 0.0]
               :normal [0.0 0.0 0.0] :failure (str "vertical axis " perpendicular_axis.reason)}
              (let* [base_h horizontal_axis.value base_v perpendicular_axis.value
                     cosine (cos angle) sine (sin angle) negative_sine (* -1.0 sine)
                     rotated_h (if (= angle 0.0) base_h
                       [(fma sine base_v.x (* cosine base_h.x))
                        (fma sine base_v.y (* cosine base_h.y))
                        (fma sine base_v.z (* cosine base_h.z))])
                     rotated_v (if (= angle 0.0) base_v
                       [(fma cosine base_v.x (* negative_sine base_h.x))
                        (fma cosine base_v.y (* negative_sine base_h.y))
                        (fma cosine base_v.z (* negative_sine base_h.z))])
                     ; Keep the native normal's validation as an actual guard.
                     normal_axis (grid_axis (cross rotated_v rotated_h))]
                {:horizontal rotated_h :vertical rotated_v
               :normal normal_axis.value :failure (if normal_axis.valid "" (str "normal axis " normal_axis.reason))}))))))

  (defn grid_validate :context value
    [(counts : text) (connectivity : text) (orientation : text)
     (columns : int) (rows : int) (size : float) (width : float) (height : float)
     (uv_name : text) (h : vec3) (v : vec3)]
    (let* [point_counts (equal? counts "Point counts")
           min_u (if (and point_counts (not (or (equal? connectivity "Points")
                          (equal? connectivity "Columns")))) 2 1)
           min_v (if (and point_counts (not (or (equal? connectivity "Points")
                          (equal? connectivity "Rows")))) 2 1)
           extra (if point_counts 0 1) limit (array/max_length :type int)]
      (cond
        (not (and (> size 0.0) (and (> width 0.0) (> height 0.0))))
          false
        (or (int/lt columns min_u) (int/lt rows min_v))
          false
        (or (int/gt columns (int/sub limit extra)) (int/gt rows (int/sub limit extra)))
          false
        :else
          (let* [u (int/add columns extra) v_count (int/add rows extra)]
            (if (int/gt u (int/div limit v_count))
              false
              (let* [points (int/mul u v_count)
                     cells (int/mul (int/sub u 1) (int/sub v_count 1))
                     ; Sys.max_string_length >= L-1 on the supported 64-bit runtime.
                     primitive_limit (int/sub limit 1)
                     topology_ok
                       (cond (equal? connectivity "Points") true
                         (equal? connectivity "Rows") (int/le v_count primitive_limit)
                         (equal? connectivity "Columns") (int/le u primitive_limit)
                         (equal? connectivity "Rows and columns")
                           (and (int/le points (int/div limit 2))
                                (int/le u (int/sub primitive_limit v_count)))
                         (equal? connectivity "Quads")
                           (and (int/le cells (int/div limit 4)) (int/le cells primitive_limit))
                         :else (and (int/le cells (int/div limit 6))
                                    (int/le cells (int/div primitive_limit 2))))
                     uv (text/trim uv_name)]
                (cond (not topology_ok)
                        false
                  (or (equal? uv "P") (equal? uv "N"))
                        false
                  (and (equal? orientation "Custom axes") (not (grid_custom_valid h v)))
                        false
                  :else true)))))))

  (defn grid_polygon_vertex :context value
    [(index : int) (u : int) (u_cells : int) (quads : bool) (reverse : bool) (alternate : bool)]
    (let* [slots (if quads 4 6) cell (int/div index slots) slot (int/mod index slots)
           row (int/div cell u_cells) column (int/mod cell u_cells)
           a (int/add (int/mul row u) column) b (int/add a 1)
           d (int/add a u) c (int/add d 1)
           diagonal (or reverse (and alternate (int/eq (int/and (int/add row column) 1) 1)))]
      (if quads
        (cond (int/eq slot 0) a (int/eq slot 1) d (int/eq slot 2) c :else b)
        (if diagonal
          (cond (int/eq slot 0) a (int/eq slot 1) d (int/eq slot 2) b
                (int/eq slot 3) b (int/eq slot 4) d :else c)
          (cond (int/eq slot 0) a (int/eq slot 1) d (int/eq slot 2) c
                (int/eq slot 3) a (int/eq slot 4) c :else b)))))

  (defnode sop/grid :label "Grid" :version 2 :category ["Create" "Primitive"]
    :validate (grid_validate counts connectivity orientation columns rows size width height
                  uv_attribute [horizontal_x horizontal_y horizontal_z] [vertical_x vertical_y vertical_z])
    :code "E_PARAM" :message "sop/grid: invalid parameters"
    [(counts : text "Divisions" :label "Counts" :choices ["Divisions" "Point counts"])
     (connectivity : text "Triangles" :label "Connectivity"
       :choices ["Points" "Rows" "Columns" "Rows and columns" "Quads" "Triangles" "Alternating triangles" "Reverse triangles"])
     (orientation : text "XZ" :label "Orientation" :choices ["XY" "XZ" "YZ" "Custom axes"])
     (horizontal_x : float 1.0 :label "Horizontal X" :min -1 :max 1 :vec3 ["horizontal" 0])
     (horizontal_y : float 0.0 :label "Horizontal Y" :min -1 :max 1 :vec3 ["horizontal" 1])
     (horizontal_z : float 0.0 :label "Horizontal Z" :min -1 :max 1 :vec3 ["horizontal" 2])
     (vertical_x : float 0.0 :label "Vertical X" :min -1 :max 1 :vec3 ["vertical" 0])
     (vertical_y : float 0.0 :label "Vertical Y" :min -1 :max 1 :vec3 ["vertical" 1])
     (vertical_z : float 1.0 :label "Vertical Z" :min -1 :max 1 :vec3 ["vertical" 2])
     (width_mode : text "Explicit" :label "Width mode" :choices ["Explicit" "Auto"])
     (height_mode : text "Explicit" :label "Height mode" :choices ["Explicit" "Auto"])
     (columns : int 10 :label "Columns" :folder "Resolution" :min 1 :max 64 :hard_min 1 :primary true)
     (rows : int 10 :label "Rows" :folder "Resolution" :min 1 :max 64 :hard_min 1 :primary true)
     (size : float 1.0 :label "Size" :min 0.01 :max 10 :hard_min 0)
     (width : float 1.0 :label "Width" :folder "Size" :min 0.01 :max 10 :hard_min 0 :primary true)
     (height : float 1.0 :label "Height" :folder "Size" :min 0.01 :max 10 :hard_min 0 :primary true)
     (center_x : float 0.0 :label "Center X" :folder ["Transform" "Center"] :min -10 :max 10 :vec3 ["center" 0])
     (center_y : float 0.0 :label "Center Y" :folder ["Transform" "Center"] :min -10 :max 10 :vec3 ["center" 1])
     (center_z : float 0.0 :label "Center Z" :folder ["Transform" "Center"] :min -10 :max 10 :vec3 ["center" 2])
     (rotation : float 0.0 :label "Rotation" :folder "Transform" :min -3.14159 :max 3.14159)
     (uv_attribute : text "" :label "UV attribute" :folder "Attributes")]
    (let* [frame (grid_frame
               (cond (equal? orientation "XY") [1.0 0.0 0.0]
                     (equal? orientation "XZ") [1.0 0.0 0.0]
                     (equal? orientation "YZ") [0.0 0.0 1.0] :else [horizontal_x horizontal_y horizontal_z])
               (cond (equal? orientation "XY") [-0.0 -1.0 -0.0]
                     (equal? orientation "XZ") [0.0 0.0 1.0]
                     (equal? orientation "YZ") [0.0 1.0 0.0] :else [vertical_x vertical_y vertical_z]) rotation)]
      (if (not (equal? frame.failure ""))
        (error "invalid_parameter" "grid could not produce valid geometry"
          :cause (str "grid [invalid_parameter]: Rdk.Plane_generators.grid: " frame.failure))
        (let* [h frame.horizontal vert frame.vertical normal frame.normal
               extra (if (equal? counts "Divisions") 1 0)
               u_count (int/add columns extra) v_count (int/add rows extra)
               u_cells (int/sub u_count 1) v_cells (int/sub v_count 1)
               point_count (int/mul u_count v_count) cell_count (int/mul u_cells v_cells)
               effective_width (if (equal? width_mode "Auto") size width)
               effective_height (if (equal? height_mode "Auto") size height)
               u_indices (array/range u_count :type int) v_indices (array/range v_count :type int)
               u_values (exact (map (fn [(index : int)] (if (int/eq u_count 1) 0.5
                           (/ (float index) (float u_cells)))) u_indices))
               v_values (exact (map (fn [(index : int)] (if (int/eq v_count 1) 0.5
                           (/ (float index) (float v_cells)))) v_indices))
               du_values (exact (map (fn [(u : float)] (* (- u 0.5) effective_width)) u_values))
               dv_values (exact (map (fn [(v : float)] (* (- v 0.5) effective_height)) v_values))
               row_x (exact (map (fn [(dv : float)] (let* [value (float/fma_checked vert.x dv center_x)] value.value)) dv_values))
               row_y (exact (map (fn [(dv : float)] (let* [value (float/fma_checked vert.y dv center_y)] value.value)) dv_values))
               row_z (exact (map (fn [(dv : float)] (let* [value (float/fma_checked vert.z dv center_z)] value.value)) dv_values))
               row_flags (exact (map (fn [(dv : float)]
                 (let* [x (float/fma_checked vert.x dv center_x) y (float/fma_checked vert.y dv center_y)
                        z (float/fma_checked vert.z dv center_z)]
                   (if (and x.valid (and y.valid z.valid)) 0 1))) dv_values))
               fu_count (float u_count) fu_cells (float u_cells) fv_cells (float v_cells)
               u_single (int/eq u_count 1) v_single (int/eq v_count 1)
               zeros (array/float point_count 0.0)
               ; P is a map over the points' float index, row-major, with the arithmetic of the row
               ; and column arrays above, so the CPU bytes are those of the native grid. It is written
               ; at cook over zero planes: a device write it folds into makes P from the element index
               ; (float index, mod and checked fma are device forms), so nothing of P is uploaded.
               grid_point (fn [(i : float)]
                 (let* [col (mod i fu_count) row (/ (- i col) fu_count)
                        du (* (- (if u_single 0.5 (/ col fu_cells)) 0.5) effective_width)
                        dv (* (- (if v_single 0.5 (/ row fv_cells)) 0.5) effective_height)
                        bx (float/fma_checked vert.x dv center_x) by (float/fma_checked vert.y dv center_y)
                        bz (float/fma_checked vert.z dv center_z)
                        x (float/fma_checked h.x du bx.value) y (float/fma_checked h.y du by.value)
                        z (float/fma_checked h.z du bz.value)]
                   [x.value y.value z.value]))
               invalid_rows (exact (for [row v_indices du du_values]
                 (if (int/eq (array/nth row_flags row) 1) 1
                   (let* [x (float/fma_checked h.x du (array/nth row_x row))
                          y (float/fma_checked h.y du (array/nth row_y row))
                          z (float/fma_checked h.z du (array/nth row_z row))]
                     (if (and x.valid (and y.valid z.valid)) 0 1)))))
               checked_rows (error_rows invalid_rows
                 (fn [(index : int)] {:code "invalid_parameter"
                   :message "grid could not produce valid geometry"
                   :cause (list (str "grid [invalid_parameter]: Rdk.Plane_generators.grid: generated point "
                     index " is not finite"))}) :policy "first")
               point_mode (equal? connectivity "Points") row_mode (equal? connectivity "Rows")
               column_mode (equal? connectivity "Columns") both_mode (equal? connectivity "Rows and columns")
               quads (equal? connectivity "Quads") lines (or row_mode (or column_mode both_mode))
               vertex_count (cond point_mode 0 both_mode (int/mul point_count 2) lines point_count
                             quads (int/mul cell_count 4) :else (int/mul cell_count 6))
               primitive_count (cond point_mode 0 row_mode v_count column_mode u_count
                                both_mode (int/add v_count u_count) quads cell_count :else (int/mul cell_count 2))
               vertex_indices (array/range vertex_count :type int)
               vertices (if point_mode (array/int 0)
                 (exact (map (fn [(index : int)]
                   (cond row_mode index
                     column_mode (int/add (int/mul (int/mod index v_count) u_count) (int/div index v_count))
                     both_mode (if (int/lt index point_count) index
                       (let* [column_index (int/sub index point_count)]
                         (int/add (int/mul (int/mod column_index v_count) u_count) (int/div column_index v_count))))
                     :else (grid_polygon_vertex index u_count u_cells quads
                       (equal? connectivity "Reverse triangles") (equal? connectivity "Alternating triangles")))) vertex_indices)))
               offsets (exact (map (fn [(index : int)]
                 (cond row_mode (int/mul index u_count) column_mode (int/mul index v_count)
                   both_mode (if (int/le index v_count) (int/mul index u_count)
                     (int/add point_count (int/mul (int/sub index v_count) v_count)))
                   :else (int/mul index (if quads 4 3)))) (array/range (int/add primitive_count 1) :type int)))
               kinds (array/int primitive_count (if lines 1 0))
               geo (sop/mesh_planes :points {:x zeros :y zeros :z zeros}
                       :vertex_points vertices :primitive_offsets offsets :kinds kinds)
               actual_count (sop/count geo :points)
               normals (sop/with_attr geo :N
                 {:x (array/float actual_count normal.x) :y (array/float actual_count normal.y)
                  :z (array/float actual_count normal.z)})
               with_normals (sop/with_attr normals :P
                 (exact (map grid_point (array/range actual_count))))
               uv_name (text/trim uv_attribute)]
          (if (text/blank? uv_name) with_normals
            (sop/with_attr with_normals uv_name
              {:x (exact (for [v v_values u u_values] u))
               :y (exact (for [v v_values u u_values] v))} :type vec2))))))
