; Whole-node draft. TRS or explicit matrix on the selected points, normals through the inverse transpose.
(defn transform_finite :context value [(x : float)] (= (- x x) 0.0))
(defn transform_vec_finite :context value [(v : vec3)]
  (and (transform_finite v.x) (and (transform_finite v.y) (transform_finite v.z))))
(defn transform_rotation :context value [(order : text) (angles : vec3)]
  (let* [rx (mat4_rotation_x angles.x) ry (mat4_rotation_y angles.y) rz (mat4_rotation_z angles.z)]
    (case order
      "XYZ" (mat4_mul rz (mat4_mul ry rx))
      "XZY" (mat4_mul ry (mat4_mul rz rx))
      "YXZ" (mat4_mul rz (mat4_mul rx ry))
      "YZX" (mat4_mul rx (mat4_mul rz ry))
      "ZXY" (mat4_mul ry (mat4_mul rx rz))
      :else (mat4_mul rx (mat4_mul ry rz)))))
(defn transform_row_finite :context value [(row : vec4)]
  (and (transform_finite row.x) (and (transform_finite row.y)
    (and (transform_finite row.z) (transform_finite row.w)))))
(defn transform_matrix_finite :context value [(m : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})]
  (and (transform_row_finite m.r0) (and (transform_row_finite m.r1)
    (and (transform_row_finite m.r2) (transform_row_finite m.r3)))))
; Rdk.Transform_ops.compose_transform; ok is false where native refuses the parameters.
(defn transform_compose :context value
  [(order : text) (rotation_order : text) (translate : vec3) (rotate : vec3) (scale : vec3)
   (shear : vec3) (uniform_scale : float) (pivot : vec3) (pivot_rotation : vec3) (invert : bool)]
  (let* [finite (and (transform_vec_finite translate) (and (transform_vec_finite rotate)
                  (and (transform_vec_finite scale) (and (transform_vec_finite shear)
                    (and (transform_vec_finite pivot) (and (transform_vec_finite pivot_rotation)
                      (transform_finite uniform_scale)))))))
         scaled (* scale uniform_scale)
         scale_shear (mat4_mul {:r0 [1.0 shear.x shear.y 0.0] :r1 [0.0 1.0 shear.z 0.0]
                                :r2 [0.0 0.0 1.0 0.0] :r3 [0.0 0.0 0.0 1.0]} (mat4_scaling scaled))
         rotation (transform_rotation rotation_order rotate)
         translation (mat4_translation translate)
         core (case order
                "SRT" (mat4_mul translation (mat4_mul rotation scale_shear))
                "STR" (mat4_mul rotation (mat4_mul translation scale_shear))
                "RST" (mat4_mul translation (mat4_mul scale_shear rotation))
                "RTS" (mat4_mul scale_shear (mat4_mul translation rotation))
                "TSR" (mat4_mul rotation (mat4_mul scale_shear translation))
                :else (mat4_mul scale_shear (mat4_mul rotation translation)))
         pivot_matrix (transform_rotation rotation_order pivot_rotation)
         matrix (mat4_mul (mat4_translation pivot)
                  (mat4_mul pivot_matrix
                    (mat4_mul core
                      (mat4_mul (mat4_transpose pivot_matrix) (mat4_translation (* pivot -1.0))))))
         inverse (mat4_inverse matrix)]
    (if (not finite) {:ok false :matrix (mat4_identity)}
      (if (not invert) {:ok (transform_matrix_finite matrix) :matrix matrix}
        (if (= (count inverse) 0) {:ok false :matrix (mat4_identity)}
          {:ok (transform_matrix_finite (nth inverse 0)) :matrix (nth inverse 0)})))))
(defn transform_resolve :context value
  [(mode : text) (matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (order : text) (rotation_order : text)
   (translate : vec3) (rotate : vec3) (scale : vec3) (shear : vec3) (uniform_scale : float)
   (pivot : vec3) (pivot_rotation : vec3) (invert : bool)]
  (if (equal? mode "Matrix") {:ok (transform_matrix_finite matrix) :matrix matrix}
    (transform_compose order rotation_order translate rotate scale shear uniform_scale pivot pivot_rotation invert)))
(defn transform_valid :context value
  [(mode : text) (matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (order : text) (rotation_order : text)
   (translate : vec3) (rotate : vec3) (scale : vec3) (shear : vec3) (uniform_scale : float)
   (pivot : vec3) (pivot_rotation : vec3) (invert : bool)]
  (let* [resolved (transform_resolve mode matrix order rotation_order translate rotate scale shear
                    uniform_scale pivot pivot_rotation invert)]
    resolved.ok))
(defn transform_normal :context value
  [(normal_matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (preserve : bool) (n : vec3)]
  (let* [o [(fma normal_matrix.r0.z n.z (fma normal_matrix.r0.y n.y (* normal_matrix.r0.x n.x)))
            (fma normal_matrix.r1.z n.z (fma normal_matrix.r1.y n.y (* normal_matrix.r1.x n.x)))
            (fma normal_matrix.r2.z n.z (fma normal_matrix.r2.y n.y (* normal_matrix.r2.x n.x)))]
         length (sqrt (fused_dot o o))
         target (if preserve (sqrt (fused_dot n n)) 1.0)]
    (if (> length 1e-20) (* o (/ target length)) [0.0 0.0 0.0])))
; all: every point is selected, so the map reads no mask (nor the input's count)
(defn transform_selected_normals :context sop
  [(geo : geometry) (owner : text) (normal_matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4})
   (all : bool) (selected : (array int)) (preserve : bool)]
  ; :when, not if: the cooked test guards the write, so the card stays one program. The static
  ; branch is outside the maps: a map captures what its term names, taken or not. A test at hand
  ; (a body cooked behind its card) decides here: the write's arguments, read eagerly then, read N.
  (let* [present (sop/has_attr geo "N" :owner owner :type vec3)]
    (if (and (not (live? present)) (not present)) geo
    (if all
      (sop/with_attr geo "N"
        (exact (map (fn [(n : vec3)] (transform_normal normal_matrix preserve n))
          (sop/attr geo "N" :owner owner :type vec3)))
        :owner owner :type vec3 :when present)
      (sop/with_attr geo "N"
        (exact (map (fn [(n : vec3) (chosen : int)]
          (if (int/eq chosen 0) n (transform_normal normal_matrix preserve n)))
          (sop/attr geo "N" :owner owner :type vec3) selected))
        :owner owner :type vec3 :when present)))))
;; transform_selected_normals where kept leaves every normal as it is (a live identity or singular matrix)
(defn transform_kept_normals :context sop
  [(geo : geometry) (owner : text) (normal_matrix : {:r0 vec4 :r1 vec4 :r2 vec4 :r3 vec4}) (kept : bool)
   (all : bool) (selected : (array int)) (preserve : bool)]
  (let* [present (sop/has_attr geo "N" :owner owner :type vec3)]
    (if (and (not (live? present)) (not present)) geo
    (if all
      (sop/with_attr geo "N"
        (exact (map (fn [(n : vec3)] (if kept n (transform_normal normal_matrix preserve n)))
          (sop/attr geo "N" :owner owner :type vec3)))
        :owner owner :type vec3 :when present)
      (sop/with_attr geo "N"
        (exact (map (fn [(n : vec3) (chosen : int)]
          (if (or kept (int/eq chosen 0)) n (transform_normal normal_matrix preserve n)))
          (sop/attr geo "N" :owner owner :type vec3) selected))
        :owner owner :type vec3 :when present)))))
(defnode sop/transform :label "Transform" :category "Modify"
  :facts {:elementwise points :reads ["P" "N"] :writes ["P" "N"] :topology preserved :exact false}
  :validate (transform_valid mode {:r0 [m00 m01 m02 m03] :r1 [m10 m11 m12 m13] :r2 [m20 m21 m22 m23] :r3 [m30 m31 m32 m33]}
                 order rotation_order [translate_x translate_y translate_z] [rotate_x rotate_y rotate_z]
                 [scale_x scale_y scale_z] [shear_xy shear_xz shear_yz] uniform_scale
                 [pivot_x pivot_y pivot_z] [pivot_rotation_x pivot_rotation_y pivot_rotation_z] invert)
  :code "E_PARAM" :message "sop/transform: invalid transform"
  [(in0 : geometry)
   (mode : text "TRS" :label "Transform mode" :choices ["TRS" "Matrix"])
   (group_owner : text "Point" :label "Group type" :folder ["Selection"] :choices ["Point" "Vertex" "Primitive" "Edge"])
   (group : text "" :label "Group" :folder ["Selection"])
   (order : text "SRT" :label "Transform order" :choices ["SRT" "STR" "RST" "RTS" "TSR" "TRS"])
   (rotation_order : text "XYZ" :label "Rotation order" :choices ["XYZ" "XZY" "YXZ" "YZX" "ZXY" "ZYX"])
   (shear_xy : float 0.0 :label "Shear XY" :folder ["Transform" "Shear"] :min -4 :max 4)
   (shear_xz : float 0.0 :label "Shear XZ" :folder ["Transform" "Shear"] :min -4 :max 4)
   (shear_yz : float 0.0 :label "Shear YZ" :folder ["Transform" "Shear"] :min -4 :max 4)
   (pivot_x : float 0.0 :label "Pivot X" :folder ["Transform" "Pivot"] :min -10 :max 10 :vec3 ["pivot" 0])
   (pivot_y : float 0.0 :label "Pivot Y" :folder ["Transform" "Pivot"] :min -10 :max 10 :vec3 ["pivot" 1])
   (pivot_z : float 0.0 :label "Pivot Z" :folder ["Transform" "Pivot"] :min -10 :max 10 :vec3 ["pivot" 2])
   (pivot_rotation_x : float 0.0 :label "Pivot rotate X" :folder ["Transform" "Pivot rotation"] :min -3.141592653589793 :max 3.141592653589793 :vec3 ["pivot_rotation" 0])
   (pivot_rotation_y : float 0.0 :label "Pivot rotate Y" :folder ["Transform" "Pivot rotation"] :min -3.141592653589793 :max 3.141592653589793 :vec3 ["pivot_rotation" 1])
   (pivot_rotation_z : float 0.0 :label "Pivot rotate Z" :folder ["Transform" "Pivot rotation"] :min -3.141592653589793 :max 3.141592653589793 :vec3 ["pivot_rotation" 2])
   (invert : bool false :label "Invert transform" :folder ["Transform"])
   (m00 : float 1.0 :label "M00" :folder ["Matrix"] :min -10 :max 10)
   (m01 : float 0.0 :label "M01" :folder ["Matrix"] :min -10 :max 10)
   (m02 : float 0.0 :label "M02" :folder ["Matrix"] :min -10 :max 10)
   (m03 : float 0.0 :label "M03" :folder ["Matrix"] :min -10 :max 10)
   (m10 : float 0.0 :label "M10" :folder ["Matrix"] :min -10 :max 10)
   (m11 : float 1.0 :label "M11" :folder ["Matrix"] :min -10 :max 10)
   (m12 : float 0.0 :label "M12" :folder ["Matrix"] :min -10 :max 10)
   (m13 : float 0.0 :label "M13" :folder ["Matrix"] :min -10 :max 10)
   (m20 : float 0.0 :label "M20" :folder ["Matrix"] :min -10 :max 10)
   (m21 : float 0.0 :label "M21" :folder ["Matrix"] :min -10 :max 10)
   (m22 : float 1.0 :label "M22" :folder ["Matrix"] :min -10 :max 10)
   (m23 : float 0.0 :label "M23" :folder ["Matrix"] :min -10 :max 10)
   (m30 : float 0.0 :label "M30" :folder ["Matrix"] :min -10 :max 10)
   (m31 : float 0.0 :label "M31" :folder ["Matrix"] :min -10 :max 10)
   (m32 : float 0.0 :label "M32" :folder ["Matrix"] :min -10 :max 10)
   (m33 : float 1.0 :label "M33" :folder ["Matrix"] :min -10 :max 10)
   (translate_x : float 0.0 :label "Translate X" :folder ["Translate"] :min -10 :max 10 :vec3 ["translate" 0])
   (translate_y : float 0.0 :label "Translate Y" :folder ["Translate"] :min -10 :max 10 :vec3 ["translate" 1])
   (translate_z : float 0.0 :label "Translate Z" :folder ["Translate"] :min -10 :max 10 :vec3 ["translate" 2])
   (rotate_x : float 0.0 :label "Rotate X" :folder ["Rotate"] :min -3.14159 :max 3.14159 :vec3 ["rotate" 0])
   (rotate_y : float 0.0 :label "Rotate Y" :folder ["Rotate"] :min -3.14159 :max 3.14159 :vec3 ["rotate" 1])
   (rotate_z : float 0.0 :label "Rotate Z" :folder ["Rotate"] :min -3.14159 :max 3.14159 :vec3 ["rotate" 2])
   (scale_x : float 1.0 :label "Scale X" :folder ["Scale"] :min 0.01 :max 10 :vec3 ["scale" 0])
   (scale_y : float 1.0 :label "Scale Y" :folder ["Scale"] :min 0.01 :max 10 :vec3 ["scale" 1])
   (scale_z : float 1.0 :label "Scale Z" :folder ["Scale"] :min 0.01 :max 10 :vec3 ["scale" 2])
   (uniform_scale : float 1.0 :label "Uniform scale" :folder ["Scale"] :min 0.01 :max 10 :hard_min 0)
   (preserve_normal_length : bool false :label "Preserve normal length" :folder ["Normals"])
   (recompute_normals : bool false :label "Recompute normals" :folder ["Normals"])]
  (let* [owner (text/lower group_owner)
         group_name (text/trim group)
         resolved (transform_resolve mode {:r0 [m00 m01 m02 m03] :r1 [m10 m11 m12 m13] :r2 [m20 m21 m22 m23] :r3 [m30 m31 m32 m33]}
                    order rotation_order [translate_x translate_y translate_z] [rotate_x rotate_y rotate_z]
                    [scale_x scale_y scale_z] [shear_xy shear_xz shear_yz] uniform_scale
                    [pivot_x pivot_y pivot_z] [pivot_rotation_x pivot_rotation_y pivot_rotation_z] invert)
         matrix resolved.matrix]
    (if (deform_group_missing in0 owner group_name)
      (error "missing_group" (str "transform could not find " owner " group " (text/repr group_name)))
      (let* [selection (deform_mask in0 owner group_name)
             selected_count (if (int/eq (sop/count in0 :points) 0) 0 (array/sum selection))
             identity (and (and (and (= matrix.r0.x 1.0) (and (= matrix.r0.y 0.0) (and (= matrix.r0.z 0.0) (= matrix.r0.w 0.0))))
                                (and (= matrix.r1.x 0.0) (and (= matrix.r1.y 1.0) (and (= matrix.r1.z 0.0) (= matrix.r1.w 0.0)))))
                           (and (and (= matrix.r2.x 0.0) (and (= matrix.r2.y 0.0) (and (= matrix.r2.z 1.0) (= matrix.r2.w 0.0))))
                                (and (= matrix.r3.x 0.0) (and (= matrix.r3.y 0.0) (and (= matrix.r3.z 0.0) (= matrix.r3.w 1.0))))))]
        ; with nothing selected the write keeps every value, so only the branches that would not
        ; test the cooked count (it would make the card's structure follow cooked data)
        (cond
          ; a live matrix (driven per frame, or by cooked data): the identity and singular tests are
          ; the write's data (each point keeps its value where they hold), and a singular matrix
          ; deletes N as the card cooks, so the structure is fixed and the write the kernels' own
          (and (live? matrix) (not recompute_normals))
            (let* [all (text/blank? group_name)
                   inverse (mat4_inverse matrix)
                   singular (= (count inverse) 0)
                   kept (or identity singular)
                   normal_matrix (mat4_transpose (if singular (mat4_identity) (nth inverse 0)))
                   positions (sop/attr in0 :P)
                   moved (if all
                           (sop/with_attr in0 :P
                             (exact (map (fn [(p : vec3)] (if identity p (transform_point_fused matrix p)))
                                         positions)))
                           (sop/with_attr in0 :P
                             (exact (map (fn [(p : vec3) (chosen : int)]
                                           (if (or identity (int/eq chosen 0)) p (transform_point_fused matrix p)))
                                         positions selection))))
                   topo (sop/topology moved)
                   turned (transform_kept_normals
                            (transform_kept_normals moved "point" normal_matrix kept all selection preserve_normal_length)
                            "vertex" normal_matrix kept all (int_gather selection topo.vertex_points) preserve_normal_length)
                   ; every point: a count of the input alone, which keeps no write chain apart
                   chosen (if all (sop/count in0 :points) selected_count)
                   cleared (and singular (not (int/eq chosen 0)))]
              (sop/delete_attr (sop/delete_attr turned "N" :owner "point" :when cleared)
                "N" :owner "vertex" :when cleared))
          identity in0
          :else
          ; positions is bound, not read inside the map, so the write folds over an earlier one
          (let* [all (text/blank? group_name)
                 positions (sop/attr in0 :P)
                 moved (if all
                         (sop/with_attr in0 :P
                           (exact (map (fn [(p : vec3)] (transform_point_fused matrix p)) positions)))
                         (sop/with_attr in0 :P
                           (exact (map (fn [(p : vec3) (chosen : int)]
                                         (if (int/eq chosen 0) p (transform_point_fused matrix p)))
                                       positions selection))))
                 inverse (mat4_inverse matrix)]
            (cond
              recompute_normals
                (if (int/eq selected_count 0) in0
                  (let* [pointed (if (sop/has_attr moved "N" :owner "point")
                                   (sop/normals moved :owner "Point" :weighting "Face area") moved)]
                    (if (sop/has_attr pointed "N" :owner "vertex")
                      (sop/normals pointed :owner "Vertex" :weighting "Face area") pointed)))
              (= (count inverse) 0)
                (if (int/eq selected_count 0) in0
                  (sop/delete_attr (sop/delete_attr moved "N" :owner "point") "N" :owner "vertex"))
              :else
                (let* [normal_matrix (mat4_transpose (nth inverse 0))
                       topo (sop/topology moved)]
                  (transform_selected_normals
                    (transform_selected_normals moved "point" normal_matrix all selection preserve_normal_length)
                    "vertex" normal_matrix all (int_gather selection topo.vertex_points) preserve_normal_length)))))))))
