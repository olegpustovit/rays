(library
 (name golden_fixtures)
 (wrapped false)
 (modules fixture_codec)
 (libraries flow sop rdk))

(test
 (name test_fixture_codec)
 (modules test_fixture_codec)
 (libraries golden_fixtures sop rdk rdk_test_support))

(executable
 (name replay)
 (modules replay)
 (libraries flow flow_sop sop sop_catalog rdk rdk_test_support golden_fixtures lru unix))

(rule
 (alias runtest)
 (action (run %{exe:replay.exe} --self-test)))

; After an intentional node change, promote with
;   dune exec --root . lib/flow_sop/goldens/replay.exe -- --update lib/flow_sop/goldens/data NODE...
; (or --update-all DIR), then review the ports.sexp.gz diff.
; Lisp-node goldens (data/ is gzip, see replay.ml): runtest replays every row, the first case
; of each node/fixture pair, on 4 workers.
(rule
 (alias runtest)
 (deps data/ports.sexp.gz data/coverage.sexp.gz (glob_files data/inputs/*.gz))
 (action (setenv REPLAY_JOBS 4 (run %{exe:replay.exe} data))))
