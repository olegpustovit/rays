(library
 (name golden_fixtures)
 (wrapped false)
 (modules fixture_codec)
 (libraries flow sop rdk))

(test
 (name test_fixture_codec)
 (modules test_fixture_codec)
 (libraries golden_fixtures sop rdk rdk_test_support))

(executable
 (name replay)
 (modules replay)
 (libraries flow flow_sop sop sop_catalog rdk rdk_test_support golden_fixtures lru unix))

(rule
 (alias runtest)
 (action (run %{exe:replay.exe} --self-test)))

; Lisp-node goldens (data/ is gzip, see replay.ml). runtest replays the first case of every
; node/fixture pair; the full corpus is qualification-scale.
(rule
 (alias runtest)
 (deps data/ports.sexp.gz data/coverage.sexp.gz (glob_files data/inputs/*.gz))
 (action (setenv REPLAY_JOBS 4 (run %{exe:replay.exe} --sample 1 data))))

(rule
 (alias qualification-scale)
 (deps data/ports.sexp.gz data/coverage.sexp.gz (glob_files data/inputs/*.gz))
 (action (setenv REPLAY_JOBS 4 (run %{exe:replay.exe} --corpus data))))
