(library
 (name pxui)
 (public_name rays.pxui)
 (modules pxui theme ui ui_core ui_kit ui_text)
 (libraries rays rays_math param))

(executable
 (enabled_if
  (= %{system} macosx))
 (name test_main)
 (modules
  test_main
  test_ui_parity
  test_ui
  test_input
  test_keyboard
  test_table)
 (libraries rays rays_math pxui scene_command sdl3 ogpu_metal))

(rule
 (enabled_if
  (= %{system} macosx))
 (alias test_ui_parity)
 (deps
  fixtures/kit_panel_2x.png
  fixtures/kit_overlays_2x.png
  fixtures/kit_zones_2x.png
  fixtures/kit_table_2x.png)
 (action
  (setenv
   SDL_VIDEODRIVER
   dummy
   (setenv
    RAYS_UI_FONT
    %{dep:../../assets/fonts/DepartureMono-Regular.otf}
    (run %{exe:test_main.exe} test_ui_parity)))))

