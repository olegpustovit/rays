(executable
 (name embed_shader)
 (modules embed_shader))

(rule
 (target metal_scene2_textured_argument_source.ml)
 (deps shaders/metal/scene2_textured_argument.metal)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:embed_shader.exe}
    %{dep:shaders/metal/scene2_textured_argument.metal}))))

