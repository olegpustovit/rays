(library
 (name renderer)
 (public_name rays.renderer)
 (wrapped false)
 (modules
  renderer
  renderer_pipeline
  renderer_shaders
  renderer_retained_plans
  renderer_leases
  renderer_lowering
  scene_execution
  scene_attachment_pool
  metal_geometry_source
  metal_quad_source
  metal_ui_source
  metal_marks_source
  metal_scene3_source
  metal_scene3_textured_source
  metal_scene3_world_source
  metal_scene3_sun_depth_source
  metal_scene3_points_source)
 (private_modules
  renderer_shaders
  renderer_retained_plans
  renderer_leases
  renderer_lowering
  scene_attachment_pool
  metal_geometry_source
  metal_quad_source
  metal_ui_source
  metal_marks_source
  metal_scene3_source
  metal_scene3_textured_source
  metal_scene3_world_source
  metal_scene3_sun_depth_source
  metal_scene3_points_source)
 (libraries ogpu scene_command runtime lru rays_math runtime_resources))

(executable
 (name embed_shader)
 (modules embed_shader))

; the pipelines' stages, printed from shaders/NAME.rays (image_rgba8 is flow_gpu's image sink)

(rule
 (targets
  marks.metal
  marks.vert.spv
  marks.frag.spv
  ui.metal
  ui.vert.spv
  ui.frag.spv
  scene3.metal
  scene3.vert.spv
  scene3.frag.spv
  scene3_points.metal
  scene3_points.vert.spv
  scene3_points.frag.spv
  scene3_textured.metal
  scene3_textured.vert.spv
  scene3_textured.frag.spv
  scene3_sun_depth.metal
  scene3_sun_depth.vert.spv
  scene3_sun_depth.frag.spv
  scene3_world.metal
  scene3_world.vert.spv
  scene3_world.frag.spv
  geometry.metal
  geometry.vert.spv
  geometry.frag.spv
  quad.metal
  quad.vert.spv
  quad.frag.spv
  image_rgba8.metal
  image_rgba8.vert.spv
  image_rgba8.frag.spv)
 (deps
  (glob_files shaders/*.rays))
 (action
  (run %{exe:../flow_shader/print_shader.exe} renderer)))

(rule
 (target metal_geometry_source.ml)
 (deps geometry.metal)
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed_shader.exe} %{dep:geometry.metal}))))

