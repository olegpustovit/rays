(executable
 (enabled_if (= %{system} macosx))
 (name test_main)
 (modules test_main test_prepared_scene3 test_automatic_scratch test_retained_eviction test_offscreen_metal test_scene_execution_metal)
 (libraries renderer scene_execution_fixtures ogpu ogpu_metal unix))

; Minimal per-family MSL pipelines for tests and benchmarks that drive the
; renderer on a real device.
(library
 (name scene_execution_fixtures)
 (modules scene_execution_fixtures)
 (libraries renderer ogpu))

(test
 (name test_gpu_vertices)
 (modules test_gpu_vertices)
 (libraries renderer scene_execution_fixtures ogpu_mock))

