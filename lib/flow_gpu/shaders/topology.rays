; One workgroup validates exact uint32 topology. Each lane visits disjoint rows;
; nine collective sums produce a fixed 36-byte status, independent of mesh size.
(defmacro check-bit [flags bit]
  `(gpu/group-scan (if (int/eq (int/and ~flags ~bit) 0) 0 1)))
(defn topology-check :context value
  [(id : int) (vertices : (array int)) (offsets : (array int)) (kinds : (array int))
   (out : (array int)) (bound : (array int)) (size : int)]
  (let* [points (array/nth bound 0)
         nv (array/nth bound 1)
         no (array/nth bound 2)
         nk (array/nth bound 3)
         limit (array/nth bound 4)
         n (if (int/gt nv no) (if (int/gt nv nk) nv nk) (if (int/gt no nk) no nk))
         chunks (int/div (int/add n (int/sub size 1)) size)
         flags (fold [flags 0] [chunk (range chunks)]
           (let* [i (int/add id (int/mul chunk size))
                  vertex (if (int/lt i nv) (if (int/ge (array/nth vertices i) points) 16 0) 0)
                  kind (if (int/lt i nk) (if (int/gt (array/nth kinds i) 2) 64 0) 0)
                  primitive (if (int/lt (int/add i 1) no)
                    (let* [a (array/nth offsets i)
                           b (array/nth offsets (int/add i 1))]
                      (if (int/gt a b) 32
                        (if (int/lt i nk)
                          (let* [k (array/nth kinds i)
                                 count (int/sub b a)
                                 minimum (if (int/eq k 1) 2 3)]
                            (int/or (if (int/lt count minimum) 128 0)
                                    (if (if (int/eq k 0) (int/gt count limit) false) 256 0)))
                          0))) 0)]
             (int/or flags (int/or vertex (int/or kind primitive)))))
         checked (int/or flags
           (if (int/eq id 0)
             (int/or (if (int/eq no 0) 1 (if (int/eq (array/nth offsets 0) 0) 0 2))
               (int/or (if (int/eq no 0) 0 (if (int/eq (array/nth offsets (int/sub no 1)) nv) 0 4))
                       (if (int/eq no (int/add nk 1)) 0 8))) 0))
         a (check-bit checked 1) b (check-bit checked 2) c (check-bit checked 4)
         d (check-bit checked 8) e (check-bit checked 16) f (check-bit checked 32)
         g (check-bit checked 64) h (check-bit checked 128) j (check-bit checked 256)]
    (if (int/eq id 0)
      (int/add
        (int/add (int/add (gpu/store-int out 0 a.total) (gpu/store-int out 1 b.total))
                 (int/add (gpu/store-int out 2 c.total) (gpu/store-int out 3 d.total)))
        (int/add (int/add (gpu/store-int out 4 e.total) (gpu/store-int out 5 f.total))
                 (int/add (gpu/store-int out 6 g.total)
                          (int/add (gpu/store-int out 7 h.total) (gpu/store-int out 8 j.total)))))
      0)))
