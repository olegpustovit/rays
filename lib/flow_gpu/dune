(library
 (name flow_gpu)
 (public_name rays.flow_gpu)
 (modules
  compact_source
  dispatch_source
  bounds_source
  normals_source
  kernels
  pipelines
  run
  host
  image_sink
  image_rgba8_source)
 (private_modules
  compact_source
  dispatch_source
  bounds_source
  normals_source
  kernels
  image_rgba8_source)
 (foreign_stubs
  (language c)
  (names flow_gpu_stubs))
 (flags
  (:standard -open Flow_shader))
 (libraries flow flow_ir flow_shader ogpu renderer rays_math lru parallel))

; the compute stages, printed from shaders/NAME.rays

(rule
 (targets
  compact.metal
  compact.comp.spv
  bounds.metal
  bounds.comp.spv
  normals.metal
  normals.comp.spv
  dispatch.metal
  dispatch.comp.spv)
 (deps
  (glob_files shaders/*.rays))
 (action
  (run %{exe:../flow_shader/print_shader.exe} flow_gpu)))

; the resident fold's compaction

(rule
 (target compact_source.ml)
 (deps compact.metal)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {msl|")
    (cat compact.metal)
    (echo "|msl}\n")))))

; a resident dispatch's threadgroup counts

(rule
 (target dispatch_source.ml)
 (deps dispatch.metal)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {msl|")
    (cat dispatch.metal)
    (echo "|msl}\n")))))

; a resident P's bounds

(rule
 (target bounds_source.ml)
 (deps bounds.metal)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {msl|")
    (cat bounds.metal)
    (echo "|msl}\n")))))

; a triangle mesh's display normals

(rule
 (target normals_source.ml)
 (deps normals.metal)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {msl|")
    (cat normals.metal)
    (echo "|msl}\n")))))

; the image sink's stages, printed from ../renderer/shaders/image.rays

(rule
 (target image_rgba8_source.ml)
 (action
  (with-stdout-to
   %{target}
   (run
    %{exe:../renderer/embed_shader.exe}
    %{dep:../renderer/image_rgba8.metal}))))

