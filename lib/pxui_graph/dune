 (modules :standard \ test_main test_pxui_graph)
 (private_modules scope_wires scope_state scope_commands scope_paint scope_frame)
 (libraries rays rays_math flow flow_graph pxui editor_core))

; The pane's own tests: no rays_editor. Fixtures are read relative to test/,
; where they ran before. test/ compiles this file too, for test_probe.
(executable
 (name test_main)
 (modules test_main test_pxui_graph)
 (libraries rays rays_math pxui pxui_graph editor_core editor_document flow flow_sop flow_graph
    scene_command ogpu_mock unix))

(rule
 (alias test_pxui_graph)
 (deps (glob_files ../../specification/workspace/cases/*.lisp))
 (action (chdir ../../test (run %{exe:test_main.exe} test_pxui_graph))))

(alias
 (name runtest)
 (deps
  (alias test_pxui_graph)))
