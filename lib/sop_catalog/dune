(library
 (name sop_catalog)
 (public_name rays.sop_catalog)
 (modules sop_catalog)
 (libraries rays_math rdk sop)
 (preprocess (pps rays.ppx)))

(executable
 (name flow_manifest)
 (modules flow_manifest)
 (libraries flow_sop sop_catalog flow editor_document ogpu_mock parallel))

(rule
 (targets flow_manifest.gen.sexp)
 (action
  (with-stdout-to %{targets}
   (run %{exe:flow_manifest.exe}))))

(rule
 (alias runtest)
 (action (diff flow_manifest.sexp flow_manifest.gen.sexp)))
