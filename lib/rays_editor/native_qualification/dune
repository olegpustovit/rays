(rule
 (enabled_if (= %{system} macosx))
 (alias bench_isogrid_cost)
 (deps ../../../sketches/isogrid.rays)
 (action
  (progn
   (run %{exe:bench_isogrid_resident.exe} %{dep:../../../sketches/isogrid.rays}
    --resolution 64 --publication-only --cpu --domains 8 --repeat 3)
   (run %{exe:bench_isogrid_resident.exe} %{dep:../../../sketches/isogrid.rays}
    --resolution 64 --publication-only --domains 8 --repeat 3))))

(alias (name qualification-scale) (deps (alias bench_isogrid_cost)))

(rule
 (enabled_if (= %{system} macosx))
