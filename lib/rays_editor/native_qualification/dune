(executables
 (enabled_if
  (= %{system} macosx))
 (names
  test_workspace_gpu_native
  test_workspace_gpu_marks
  bench_marks_gpu
  test_grid_gpu_native
  test_chain_gpu_native
  bench_chain_recook
  bench_chain_frames
  test_chain_frames_native)
 (modules
  test_workspace_gpu_native
  test_workspace_gpu_marks
  bench_marks_gpu
  test_grid_gpu_native
  test_chain_gpu_native
  bench_chain_recook
  bench_chain_frames
  test_chain_frames_native)
 (libraries
  rays
  rays_math
  flow
  flow_ir
  flow_sop
