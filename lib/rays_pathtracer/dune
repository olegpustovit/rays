(executable
 (name embed_metal)
 (modules embed_metal))

(rule
 (target pathtrace_source.ml)
 (deps pathtrace.metal)
 (action (with-stdout-to %{target}
  (run %{exe:embed_metal.exe} %{dep:pathtrace.metal}))))

(library
 (name rays_pathtracer)
 (public_name rays.pathtracer)
 (modules rays_pathtracer pathtrace_source mesh_data mesh_build frame_data)
 (private_modules mesh_data mesh_build frame_data)
 (libraries rays ogpu renderer runtime_resources rays_math unix))

(executable
 (enabled_if (= %{system} macosx))
 (name test_main)
 (modules test_main test_pathtracer test_gpu_film test_parity test_world test_scene)
 (libraries rays rays_pathtracer renderer runtime_resources ogpu ogpu_metal rdk rdk_rays rays_math unix))

(rule
 (enabled_if (= %{system} macosx))
 (alias test_pathtracer)
 (deps pathtrace.metal)
 (action (run %{exe:test_main.exe} test_pathtracer)))

; Two frames byte for byte on the Apple M1 GPU and driver. It reads no switch:
; another chip prints that it does not compare. Refreshing a digest:
; Test_pathtracer.exact_m1_digests.
(rule
 (enabled_if (= %{system} macosx))
 (alias test_pathtracer_exact_m1)
 (locks smoke_window)
 (deps pathtrace.metal)
 (action (run %{exe:test_main.exe} test_pathtracer_exact_m1)))

