 (action (run %{exe:test_main.exe} test_parity)))

(rule
 (enabled_if (= %{system} macosx))
 (alias test_scene)
 (action (run %{exe:test_main.exe} test_scene)))

(alias
 (name qualification)
 (deps
  (alias test_pathtracer)
