 (alias test_world)
 (action (run %{exe:test_main.exe} test_world)))

(rule
 (enabled_if (= %{system} macosx))
 (alias test_gpu_film)
 (locks smoke_window)
 (action (run %{exe:test_main.exe} test_gpu_film)))

(rule
 (enabled_if (= %{system} macosx))
 (alias qualification)
 (locks smoke_window)
