(library
 (name rays)
 (public_name rays)
 (modules light material
  path texture input_state frame time clipboard image
  canvas canvas_runtime font audio mesh camera easy_camera
  scene3 scene3_native_lowering
  scene native_scene_lowering sketch world)
 (private_modules input_state time canvas_runtime scene3_native_lowering native_scene_lowering)
 (libraries input rays_math lru runtime_resources runtime_input runtime scene_command unix
  renderer parallel))

(executable
 (enabled_if (= %{system} macosx))
 (name test_scene_primitives)
 (modules test_scene_primitives)
 (libraries rays rays_math scene_command ogpu_metal parallel))

(rule
 (enabled_if (= %{system} macosx))
 (alias test_scene_primitives)
 (action (run %{exe:test_scene_primitives.exe})))

(rule
 (enabled_if (= %{system} macosx))
 (alias test_scene_primitives_native)
 (locks smoke_window)
 (action (run %{exe:test_scene_primitives.exe} native)))

